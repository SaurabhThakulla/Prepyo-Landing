---
// Self-hosted variable fonts: same origin as the page, so there is no
// render-blocking request to Google before first paint. Each file carries
// unicode-range subsets, so the browser only downloads the scripts it needs.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import '@/styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import JsonLd from '@/components/JsonLd.astro';
import type { JsonLdNode } from '@/lib/schema';
import { asset } from '@/consts';

interface Props {
  title: string;
  description: string;
  /** Structured data for this page, emitted as a single `@graph`. */
  schema?: JsonLdNode[];
  /** Overrides the default social card. Site-relative, e.g. `/images/x.jpg`. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Drops the centred reading-width container so the page can span the viewport. */
  fullWidth?: boolean;
  /** Keeps a built-but-unlaunched page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description,
  schema,
  fullWidth = false,
  noindex = false,
  ogImage = '/images/og-cover.jpg',
  ogImageAlt = 'Prepyo — full-length PTE and IELTS mock exams for students in Nepal',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(asset(ogImage), canonical).href;
---

<!doctype html>
<html lang="en-NP">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/webp" href={asset('/prepyo-mark.webp')} />
    <link rel="sitemap" type="application/xml" href={asset('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-adsense-account" content="ca-pub-9781911673673523" />
    {/* Google AdSense. is:inline keeps Astro from bundling Google's script. */}
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9781911673673523"
      crossorigin="anonymous"
    ></script>

    {schema && <JsonLd nodes={schema} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prepyo" />
    <meta property="og:locale" content="en_NP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* Sized 1200x630 and declared: a card whose dimensions the crawler has to
        download the file to discover is a card that often renders as a bare
        link instead. */}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Three families: Inter for text, Plus Jakarta Sans for headings, JetBrains
        Mono for small labels, all self-hosted (imported above). The two that
        paint above the fold are preloaded so text does not swap late. */}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin="anonymous" />

    {/* Applied before first paint so a dark-mode visitor never sees a white flash. */}
    <script is:inline>
      if (localStorage.getItem('prepyo-theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>

  <body
    class="bg-background text-foreground min-h-screen antialiased selection:bg-primary selection:text-white transition-colors duration-200"
  >
    <div class="min-h-screen bg-background text-foreground flex flex-col transition-colors duration-200">
      <Nav />
      {/* 80vw is a comfortable reading width on a laptop but wastes a third
          of a phone screen, so it only kicks in from lg up — and it is capped
          again on ultra-wide displays where 80vw stops being readable. */}
      {
        fullWidth ? (
          <main class="flex-1 w-full">
            <slot />
          </main>
        ) : (
          <main class="flex-1 w-full lg:max-w-[80vw] 2xl:max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
            <slot />
          </main>
        )
      }
      <Footer />
    </div>
    {/* Vercel Web Analytics: cookieless page views, served from /_vercel/insights. */}
    <Analytics />
  </body>
</html>
