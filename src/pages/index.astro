---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import ExamsSection from '@/components/ExamsSection.astro';
import ProblemSection from '@/components/ProblemSection.astro';
import FeaturesSection from '@/components/FeaturesSection.astro';
import SubscriptionSection from '@/components/SubscriptionSection.astro';
import PriceComparison from '@/components/PriceComparison.astro';
import HowItWorksSection from '@/components/HowItWorksSection.astro';
import FAQSection from '@/components/FAQSection.astro';
import SocialProof from '@/components/SocialProof.astro';
import Testimonials from '@/components/Testimonials.astro';
import { FAQS } from '@/data/faq';
import { faqPage, howTo, organization, softwareApplication, webPage, website } from '@/lib/schema';
import { asset, BASE_PATH, KOREAN_LIVE } from '@/consts';

/**
 * The public landing page for Prepyo.
 *
 * Top navigation links smoothly scroll directly to each respective section
 * on this page (#products, #features, #pricing, #how-it-works, #faq). The
 * exam tracks also have pages of their own, which is where the exam-specific
 * search traffic is meant to land.
 */
const origin = Astro.site ?? new URL(Astro.url.origin);
const site = new URL(BASE_PATH, origin);
const url = new URL(Astro.url.pathname, origin);

const title = KOREAN_LIVE
  ? 'Prepyo — PTE, IELTS & EPS-TOPIK Preparation in Nepal'
  : 'PTE & IELTS Preparation in Nepal — Mock Tests | Prepyo';
const description = KOREAN_LIVE
  ? 'Prepare for PTE, IELTS and EPS-TOPIK from Nepal: full mock exams, instant speaking and writing feedback, Korean practice with audio, and rupee pricing.'
  : 'Prepare for PTE 79+ and IELTS Band 8.0+ from Nepal with full mock exams, instant writing and speaking feedback, and plans priced in rupees via eSewa and Khalti.';

// Bump when the page's content is reviewed — it is the freshness date search
// and answer engines read.
const UPDATED = '2026-10-04';

// Built from the same arrays the sections render, so the markup cannot drift
// away from what a visitor actually sees.
const schema = [
  organization(site),
  website(site),
  webPage(site, url, { name: title, description, dateModified: UPDATED, hasBreadcrumbs: false }),
  softwareApplication(site),
  faqPage(url, FAQS),
  howTo(url),
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
>
  <div class="w-full space-y-4">
    <Hero />
    <ExamsSection />
    <SocialProof methodologyHref={asset('/how-scoring-works/')} />
    <ProblemSection />
    <FeaturesSection />
    <Testimonials />
    <SubscriptionSection />
    <PriceComparison />
    <HowItWorksSection />
    <FAQSection />
  </div>
</Layout>
