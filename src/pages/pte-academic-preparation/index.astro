---
import Layout from '@/layouts/Layout.astro';
import ExamArticle from '@/components/ExamArticle.astro';
import { PTE_PAGE } from '@/data/exam-pages';
import { examPageGraph } from '@/lib/schema';
import { BASE_PATH } from '@/consts';

/**
 * The PTE Academic pillar page.
 *
 * Split out of the landing page's exam section so "PTE preparation Nepal" has a
 * URL of its own to rank with, instead of sharing one with IELTS.
 */
const origin = Astro.site ?? new URL(Astro.url.origin);
const site = new URL(BASE_PATH, origin);
const url = new URL(Astro.url.pathname, origin);
---

<Layout
  title={PTE_PAGE.title}
  description={PTE_PAGE.metaDescription}
  schema={examPageGraph(site, url, PTE_PAGE)}
  ogImage={PTE_PAGE.ogImage}
  ogImageAlt={PTE_PAGE.h1}
>
  <ExamArticle page={PTE_PAGE} />
</Layout>
