---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import FAQSection from '@/components/FAQSection.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbs, faqPage, organization, webPage, website } from '@/lib/schema';
import { appUrl, asset, BASE_PATH } from '@/consts';
import { IELTS_EXAMPLES, IELTS_SOURCE, ieltsOverall } from '@/data/score-tools';

/**
 * IELTS overall band calculator. The rounding rule and the worked examples
 * are ielts.org's own (see score-tools.ts); the page renders the examples
 * through the same function the calculator uses, so a wrong rule would show.
 */
const origin = Astro.site ?? new URL(Astro.url.origin);
const site = new URL(BASE_PATH, origin);
const url = new URL(Astro.url.pathname, origin);

const title = 'IELTS Band Score Calculator — Overall Band from 4 Sections | Prepyo';
const description =
  'Work out your IELTS overall band from your listening, reading, writing and speaking scores, using the official rounding rule published by IELTS.';

const SECTIONS = [
  { id: 'listening', label: 'Listening' },
  { id: 'reading', label: 'Reading' },
  { id: 'writing', label: 'Writing' },
  { id: 'speaking', label: 'Speaking' },
];
const BANDS = Array.from({ length: 19 }, (_, i) => i / 2);
const DEFAULT = 6.5;

const faqs = [
  {
    question: 'How is the IELTS overall band score calculated?',
    answer:
      'IELTS takes the average of your four section bands and rounds it to the nearest half band. If the average ends in .25, it is rounded up to the next half band; if it ends in .75, it is rounded up to the next whole band.',
  },
  {
    question: 'Does an average of 6.25 round to 6.0 or 6.5?',
    answer: 'It rounds up to 6.5. IELTS’s own worked example has scores of 6.5, 6.5, 5.0 and 7.0, an average of 6.25 and an overall band of 6.5.',
  },
  {
    question: 'Is this calculator official?',
    answer:
      'No. Prepyo built it using the rule IELTS publishes. Your official overall band is the one on your Test Report Form.',
  },
];

const schema = [
  organization(site),
  website(site),
  webPage(site, url, { name: title, description, dateModified: '2026-10-08' }),
  faqPage(url, faqs),
  breadcrumbs(url, [
    { name: 'Home', item: site.href },
    { name: 'IELTS band calculator', item: url.href },
  ]),
];

const fmt = (n: number) => n.toFixed(1);
---

<Layout title={title} description={description} schema={schema}>
  <article class="w-full max-w-3xl mx-auto">
    <Breadcrumbs trail={[{ name: 'Home', href: asset('/') }, { name: 'IELTS band calculator' }]} />

    <header class="pt-6 sm:pt-10">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">Free tool</span>
      <h1 class="font-display text-3xl sm:text-5xl font-bold tracking-tight text-foreground text-balance leading-[1.1] mt-3">
        IELTS band score calculator
      </h1>
      <p class="text-base text-muted-foreground leading-relaxed mt-5">
        Choose your four section bands to see your overall band, worked out with the rounding rule IELTS publishes.
      </p>
    </header>

    <section class="mt-8 rounded-2xl border border-border bg-card p-5 sm:p-7" aria-labelledby="calc-heading">
      <h2 id="calc-heading" class="sr-only">Calculator</h2>
      <form class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4" data-ielts-calc>
        {
          SECTIONS.map(section => (
            <label class="flex flex-col gap-1.5 text-xs font-semibold text-foreground">
              {section.label}
              <select
                name={section.id}
                class="h-11 rounded-xl border border-input bg-background px-3 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary/40"
              >
                {BANDS.map(band => (
                  <option value={band} selected={band === DEFAULT}>
                    {fmt(band)}
                  </option>
                ))}
              </select>
            </label>
          ))
        }
      </form>

      <div class="mt-6 pt-6 border-t border-border/60 flex flex-wrap items-end justify-between gap-4" aria-live="polite">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Overall band</p>
          <p class="font-display text-5xl font-bold text-primary mt-1" data-overall>{fmt(DEFAULT)}</p>
        </div>
        <p class="text-sm text-muted-foreground" data-working>
          Average {DEFAULT.toString()} → rounded to {fmt(DEFAULT)}
        </p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold tracking-tight text-foreground">How the overall band is worked out</h2>
      <div class="text-sm text-muted-foreground leading-relaxed mt-3 space-y-3">
        <p>
          IELTS adds your listening, reading, writing and speaking bands, divides by four, and rounds the result to the
          nearest half band. Two cases are rounded up:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li>an average ending in <strong class="text-foreground">.25</strong> goes up to the next half band (6.25 → 6.5);</li>
          <li>an average ending in <strong class="text-foreground">.75</strong> goes up to the next whole band (6.75 → 7.0).</li>
        </ul>
        <p>These are the worked examples IELTS publishes, run through this calculator:</p>
      </div>

      <div class="overflow-x-auto mt-4 rounded-2xl border border-border">
        <table class="w-full text-sm">
          <thead class="bg-muted/50 text-left text-xs uppercase tracking-wider text-muted-foreground">
            <tr>
              <th class="px-4 py-3 font-semibold">L</th>
              <th class="px-4 py-3 font-semibold">R</th>
              <th class="px-4 py-3 font-semibold">W</th>
              <th class="px-4 py-3 font-semibold">S</th>
              <th class="px-4 py-3 font-semibold">Average</th>
              <th class="px-4 py-3 font-semibold">Overall</th>
            </tr>
          </thead>
          <tbody>
            {
              IELTS_EXAMPLES.map(example => (
                <tr class="border-t border-border">
                  {example.scores.map(score => (
                    <td class="px-4 py-3">{fmt(score)}</td>
                  ))}
                  <td class="px-4 py-3">{example.average}</td>
                  <td class="px-4 py-3 font-bold text-foreground">{fmt(ieltsOverall(example.scores))}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-xs text-muted-foreground mt-3">
        Source:
        <a href={IELTS_SOURCE.url} target="_blank" rel="noopener" class="text-primary hover:underline">{IELTS_SOURCE.name}</a>,
        checked {new Date(IELTS_SOURCE.checked).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}.
        This calculator is not official. Your Test Report Form is.
      </p>
    </section>

    <section class="mt-10 rounded-2xl border border-border bg-card p-5 sm:p-6 flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
        <Icon name="lucide:arrow-left-right" class="w-5 h-5" />
      </div>
      <div>
        <h2 class="font-display font-bold text-base text-foreground">Taking PTE instead?</h2>
        <p class="text-sm text-muted-foreground mt-1">
          See what your PTE score means in IELTS bands with the
          <a href={asset('/tools/pte-to-ielts-converter/')} class="text-primary font-medium hover:underline">PTE to IELTS converter</a>.
        </p>
      </div>
    </section>

    <FAQSection faqs={faqs} title="Frequently asked questions" />

    <section class="py-10 sm:py-14">
      <div class="rounded-2xl border border-border bg-card p-6 sm:p-8">
        <h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-foreground">Find out your real band</h2>
        <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
          Take a free IELTS diagnostic on Prepyo and see which criteria are holding each section back.
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <Button href={appUrl('/diagnostic')} size="lg" class="rounded-full font-bold text-sm px-7 h-12">Take the free diagnostic</Button>
          <Button href={asset('/ielts-academic-preparation/')} variant="outline" size="lg" class="rounded-full font-bold text-sm px-7 h-12">
            IELTS preparation
          </Button>
        </div>
      </div>
    </section>
  </article>
</Layout>

<script>
  import { ieltsOverall } from '@/data/score-tools';

  const form = document.querySelector<HTMLFormElement>('[data-ielts-calc]');
  const overall = document.querySelector('[data-overall]');
  const working = document.querySelector('[data-working]');

  function update() {
    if (!form || !overall || !working) return;
    const scores = Array.from(form.querySelectorAll('select')).map(select => Number(select.value));
    const average = scores.reduce((sum, s) => sum + s, 0) / scores.length;
    const band = ieltsOverall(scores);
    overall.textContent = band.toFixed(1);
    working.textContent = `Average ${average} → rounded to ${band.toFixed(1)}`;
  }

  form?.addEventListener('change', update);
  update();
</script>
