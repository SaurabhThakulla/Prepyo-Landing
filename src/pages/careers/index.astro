---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbs, jobPosting, organization, website } from '@/lib/schema';
import { APPLICATION_STEPS, CAREERS_EMAIL, OPEN_ROLES, WORK_HIGHLIGHTS } from '@/data/careers';
import { asset, BASE_PATH } from '@/consts';

/**
 * Careers at Prepyo: the open roles, each expandable to its full description,
 * an open application for everyone else, and why the work is worth doing.
 * Everything listed comes from src/data/careers.ts.
 */
const origin = Astro.site ?? new URL(Astro.url.origin);
const site = new URL(BASE_PATH, origin);
const url = new URL(Astro.url.pathname, origin);

const title = 'Careers at Prepyo — Remote Jobs and Internships in Nepal';
const description =
  'Join Prepyo, remotely from anywhere in Nepal. Open roles for a junior developer, a lead generation executive, and developer, SEO and marketing interns.';

const schema = [
  organization(site),
  website(site),
  breadcrumbs(url, [
    { name: 'Home', item: site.href },
    { name: 'Careers', item: url.href },
  ]),
  ...OPEN_ROLES.map(role => jobPosting(site, url, role)),
];

const generalMailto = `mailto:${CAREERS_EMAIL}?subject=${encodeURIComponent('Open Application — Prepyo')}`;

const TEAM_TONE: Record<string, string> = {
  Engineering: 'bg-sky-500',
  Marketing: 'bg-pink-500',
  'Sales & Partnerships': 'bg-amber-500',
};
---

<Layout title={title} description={description} schema={schema}>
  <div class="mx-auto w-full max-w-5xl space-y-10 pb-16">
    <Breadcrumbs trail={[{ name: 'Home', href: asset('/') }, { name: 'Careers' }]} />

    {/* Open roles */}
    <section aria-labelledby="open-roles" class="space-y-4">
      <div class="flex items-end justify-between gap-4">
        <h1 id="open-roles" class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-foreground">Open roles</h1>
        <a href={generalMailto} class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
          {CAREERS_EMAIL}
          <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
        </a>
      </div>

      {
        OPEN_ROLES.map((role) => {
          const applyMailto = `mailto:${CAREERS_EMAIL}?subject=${encodeURIComponent(`Application for ${role.title}`)}`;
          const panelId = `role-${role.id}`;
          return (
            <article id={role.id} class="group scroll-mt-24 rounded-2xl border border-border bg-card transition-colors hover:border-primary/30" data-role-card>
              <div class="flex flex-col gap-5 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
                <div class="min-w-0">
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                    <span class:list={['h-1.5 w-1.5 rounded-full', TEAM_TONE[role.team] ?? 'bg-primary']} aria-hidden="true"></span>
                    {role.team}
                  </span>
                  <h3 class="mt-1.5 font-display text-xl sm:text-2xl font-bold tracking-tight text-foreground">{role.title}</h3>
                  <ul class="mt-3 flex flex-wrap gap-2 text-xs text-foreground/80">
                    <li class="inline-flex items-center gap-1.5 rounded-md bg-muted px-2.5 py-1">
                      <Icon name="lucide:briefcase" class="w-3.5 h-3.5 text-muted-foreground" />{role.typeLabel}
                    </li>
                    {role.salary && (
                      <li class="inline-flex items-center gap-1.5 rounded-md bg-emerald-500/10 px-2.5 py-1 font-semibold text-emerald-700 dark:text-emerald-400">
                        <Icon name="lucide:wallet" class="w-3.5 h-3.5" />{role.salary}
                      </li>
                    )}
                    <li class="inline-flex items-center gap-1.5 rounded-md bg-muted px-2.5 py-1">
                      <Icon name="lucide:map-pin" class="w-3.5 h-3.5 text-muted-foreground" />
                      <span data-remote-location={role.location.startsWith('Remote (') ? '' : undefined}>{role.location}</span>
                    </li>
                  </ul>
                </div>

                <div class="flex shrink-0 items-center gap-2">
                  <button
                    type="button"
                    class="inline-flex h-10 items-center gap-1.5 rounded-full border border-border bg-background px-4 text-sm font-semibold text-foreground hover:bg-muted transition-colors"
                    aria-expanded="false"
                    aria-controls={panelId}
                    data-accordion-toggle
                  >
                    Details
                    <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform duration-200" />
                  </button>
                  <a
                    href={applyMailto}
                    class="inline-flex h-10 items-center gap-1.5 rounded-full bg-primary px-5 text-sm font-bold text-primary-foreground shadow-md shadow-primary/25 hover:brightness-110 transition"
                  >
                    Apply
                    <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                  </a>
                </div>
              </div>

              <div id={panelId} class="hidden border-t border-border px-5 py-5 sm:px-6" data-accordion-content>
                <p class="text-sm text-foreground/80">{role.description}</p>
                <div class="mt-5 grid gap-5 sm:grid-cols-2">
                  {[
                    { heading: "You'll", items: role.responsibilities },
                    { heading: 'You have', items: role.requirements },
                  ].map(({ heading, items }) => (
                    <div>
                      <h4 class="text-xs font-semibold text-muted-foreground">{heading}</h4>
                      <ul class="mt-2 space-y-1.5">
                        {items.map((item) => (
                          <li class="flex items-center gap-2.5 text-sm text-foreground/80">
                            <span class="h-1 w-1 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }

      {/* Open application */}
      <article class="rounded-2xl border border-dashed border-border bg-card/60 p-5 sm:p-6" data-role-card>
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-foreground">Don't see your role?</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">Send us an open application.</p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <button
              type="button"
              class="inline-flex h-10 items-center gap-1.5 rounded-full border border-border bg-background px-4 text-sm font-semibold text-foreground hover:bg-muted transition-colors"
              aria-expanded="false"
              aria-controls="role-open-application"
              data-accordion-toggle
            >
              What to send
              <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform duration-200" />
            </button>
            <a
              href={generalMailto}
              class="inline-flex h-10 items-center gap-1.5 rounded-full border border-primary/30 bg-primary/10 px-5 text-sm font-bold text-primary hover:bg-primary/15 transition-colors"
            >
              Write to us
              <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
        <ol id="role-open-application" class="hidden mt-5 space-y-2.5 border-t border-border pt-5" data-accordion-content>
          {APPLICATION_STEPS.map((step, idx) => (
            <li class="flex items-start gap-3 text-sm text-muted-foreground">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">{idx + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </article>
    </section>

    {/* Why work here */}
    <section aria-labelledby="why-prepyo" class="space-y-4">
      <h2 id="why-prepyo" class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Why work at Prepyo</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {WORK_HIGHLIGHTS.map(({ icon, title: heading, body }) => (
          <div class="rounded-2xl border border-border bg-card p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <Icon name={icon} class="w-5 h-5" />
            </span>
            <h3 class="mt-5 font-display text-base font-bold text-foreground">{heading}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{body}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  // Opens and closes each role's details, keeping aria-expanded in step.
  function setupAccordions() {
    document.querySelectorAll<HTMLElement>('[data-role-card]').forEach((card) => {
      const toggle = card.querySelector<HTMLButtonElement>('[data-accordion-toggle]');
      const content = card.querySelector<HTMLElement>('[data-accordion-content]');
      if (!toggle || !content || toggle.dataset.bound) return;
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const open = content.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.querySelector('svg')?.classList.toggle('rotate-180', open);
      });
    });
  }

  setupAccordions();
  document.addEventListener('astro:page-load', setupAccordions);

  // Remote roles read "Remote (<the viewer's country>)". The page is static, so
  // the country comes from api/country.js; without it (astro dev, an error, an
  // unknown code) the built-in "Remote (Nepal)" stays.
  const remoteSpots = document.querySelectorAll<HTMLElement>('[data-remote-location]');
  if (remoteSpots.length) {
    fetch('/api/country')
      .then(response => (response.ok ? response.json() : null))
      .then((data: { country?: string | null } | null) => {
        const code = data?.country;
        if (!code) return;
        const name = new Intl.DisplayNames(['en'], { type: 'region' }).of(code);
        if (!name || name === code || /unknown/i.test(name)) return;
        remoteSpots.forEach(spot => (spot.textContent = `Remote (${name})`));
      })
      .catch(() => {});
  }
</script>
