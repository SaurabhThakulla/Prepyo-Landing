---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbs, jobPosting, organization, website } from '@/lib/schema';
import { APPLICATION_STEPS, CAREERS_EMAIL, OPEN_ROLES, WORK_HIGHLIGHTS } from '@/data/careers';
import { asset, BASE_PATH } from '@/consts';

/**
 * Careers at Prepyo — Redesigned according to modern executive role board layout.
 */
const origin = Astro.site ?? new URL(Astro.url.origin);
const site = new URL(BASE_PATH, origin);
const url = new URL(Astro.url.pathname, origin);

const title = 'Careers at Prepyo — Our Open Roles';
const description =
  'Join Prepyo to build AI-driven PTE and IELTS preparation for students across Nepal. Explore open roles in engineering, product design, and curriculum.';

const schema = [
  organization(site),
  website(site),
  breadcrumbs(url, [
    { name: 'Home', item: site.href },
    { name: 'Careers', item: url.href },
  ]),
  ...OPEN_ROLES.map(role => jobPosting(site, url, role)),
];

const generalMailto = `mailto:${CAREERS_EMAIL}?subject=${encodeURIComponent('Open Application — Prepyo')}`;
---

<Layout title={title} description={description} schema={schema}>
  <div class="w-full space-y-6 pb-16">
    <Breadcrumbs trail={[{ name: 'Home', href: asset('/') }, { name: 'Careers' }]} />

    {/* Main Container Card matching the design reference */}
    <div class="w-full rounded-2xl sm:rounded-3xl border border-border/80 bg-card/90 shadow-xl backdrop-blur-sm overflow-hidden p-6 sm:p-10 lg:p-12">
      
      {/* 2-Column Split: Left Sticky Heading & Contact, Right Role Cards */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
        
        {/* Left Column: Heading, Contact Link, and Meta info */}
        <div class="lg:col-span-4 lg:sticky lg:top-24 flex flex-col justify-between self-stretch space-y-8">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
              We are hiring
            </span>
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground leading-[1.08]">
              Our Open<br class="hidden sm:inline" /> Roles
            </h1>

            <div class="mt-8 space-y-1.5">
              <p class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground/80">
                Or contact us with
              </p>
              <a
                href={generalMailto}
                class="inline-block text-base sm:text-lg font-semibold text-orange-500 hover:text-orange-600 dark:text-orange-400 dark:hover:text-orange-300 underline underline-offset-4 decoration-orange-500/40 hover:decoration-orange-500 transition-colors"
              >
                {CAREERS_EMAIL}
              </a>
            </div>
          </div>

          {/* Quick Info & Tags at bottom left */}
          <div class="pt-6 border-t border-border/60 text-xs text-muted-foreground space-y-3">
            <p class="leading-relaxed">
              We build the practice tools that determine whether ambitious students in Nepal achieve their dream university and visa targets.
            </p>
            <div class="flex flex-wrap items-center gap-2 pt-1">
              <span class="px-2.5 py-1 rounded-md bg-muted/80 text-[11px] font-medium text-foreground/80">Kathmandu &amp; Hybrid</span>
              <span class="px-2.5 py-1 rounded-md bg-muted/80 text-[11px] font-medium text-foreground/80">Competitive Pay</span>
              <span class="px-2.5 py-1 rounded-md bg-muted/80 text-[11px] font-medium text-foreground/80">Immediate Impact</span>
            </div>
          </div>
        </div>

        {/* Right Column: Roles List */}
        <div class="lg:col-span-8 flex flex-col divide-y divide-border/70">
          {
            OPEN_ROLES.map((role) => {
              const applyMailto = `mailto:${CAREERS_EMAIL}?subject=${encodeURIComponent(`Application for ${role.title}`)}`;
              
              return (
                <div class="py-6 sm:py-8 first:pt-0 last:pb-0 group transition-colors" data-role-card>
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="space-y-1.5 flex-1 pr-2">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                        {role.team}
                      </span>
                      <h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-foreground group-hover:text-primary transition-colors">
                        {role.title}
                      </h2>
                      <p class="text-xs sm:text-sm text-muted-foreground">
                        {role.typeLabel}
                        {role.salary && ` · ${role.salary}`}
                        {` · ${role.location}`}
                      </p>
                    </div>

                    <div class="flex items-center gap-2.5 shrink-0 self-start sm:self-center">
                      {/* Accordion Toggle Chevron */}
                      <button
                        type="button"
                        class="w-10 h-10 rounded-full border border-border bg-background/80 hover:bg-muted text-foreground/80 hover:text-foreground flex items-center justify-center transition-all duration-200"
                        aria-label={`Toggle details for ${role.title}`}
                        data-accordion-toggle
                      >
                        <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform duration-200" />
                      </button>

                      {/* Orange Pill CTA Button */}
                      <a
                        href={applyMailto}
                        class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-full bg-orange-500 hover:bg-orange-600 active:scale-[0.98] text-white text-xs sm:text-sm font-bold shadow-md shadow-orange-500/25 transition-all"
                      >
                        <span>Submit Application</span>
                        <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                      </a>
                    </div>
                  </div>

                  {/* Expandable Role Details */}
                  <div class="hidden pt-6 mt-4 border-t border-border/50 space-y-5 text-foreground/90" data-accordion-content>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                      {role.description}
                    </p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                      <div class="space-y-2.5">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-foreground">
                          What you would do
                        </h3>
                        <ul class="space-y-2">
                          {role.responsibilities.map((resp) => (
                            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-muted-foreground">
                              <Icon name="lucide:check" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                              <span>{resp}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <div class="space-y-2.5">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-foreground">
                          What we are looking for
                        </h3>
                        <ul class="space-y-2">
                          {role.requirements.map((req) => (
                            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-muted-foreground">
                              <Icon name="lucide:check" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                              <span>{req}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="pt-3 flex items-center justify-between flex-wrap gap-3">
                      <span class="text-xs text-muted-foreground">
                        Ready to apply? Send your portfolio or repo directly to <strong class="text-foreground">{CAREERS_EMAIL}</strong>.
                      </span>
                      <a
                        href={applyMailto}
                        class="text-xs font-bold text-orange-500 hover:text-orange-600 dark:text-orange-400 flex items-center gap-1 hover:underline"
                      >
                        <span>Email your application</span>
                        <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                      </a>
                    </div>
                  </div>
                </div>
              );
            })
          }

          {/* General Open Application Entry */}
          <div class="py-6 sm:py-8 last:pb-0 group" data-role-card>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1.5 flex-1 pr-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                  Open Application
                </span>
                <h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-foreground group-hover:text-primary transition-colors">
                  Don’t see the exact match?
                </h2>
                <p class="text-xs sm:text-sm text-muted-foreground">
                  Full-time / Part-time · Open to student creators, engineers &amp; tutors · Kathmandu / Remote
                </p>
              </div>

              <div class="flex items-center gap-2.5 shrink-0 self-start sm:self-center">
                <button
                  type="button"
                  class="w-10 h-10 rounded-full border border-border bg-background/80 hover:bg-muted text-foreground/80 hover:text-foreground flex items-center justify-center transition-all duration-200"
                  aria-label="Toggle details for general application"
                  data-accordion-toggle
                >
                  <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform duration-200" />
                </button>

                <a
                  href={generalMailto}
                  class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-full bg-orange-500 hover:bg-orange-600 active:scale-[0.98] text-white text-xs sm:text-sm font-bold shadow-md shadow-orange-500/25 transition-all"
                >
                  <span>Submit Application</span>
                  <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                </a>
              </div>
            </div>

            <div class="hidden pt-6 mt-4 border-t border-border/50 space-y-4" data-accordion-content>
              <p class="text-sm leading-relaxed text-muted-foreground">
                We are always excited to hear from talented people who care about high-stakes education in Nepal. What you should tell us:
              </p>
              <ol class="space-y-2">
                {APPLICATION_STEPS.map((step, idx) => (
                  <li class="flex items-start gap-3 text-xs sm:text-sm text-muted-foreground">
                    <span class="w-5 h-5 rounded-full bg-primary/10 text-primary text-[11px] font-bold flex items-center justify-center shrink-0 mt-0.5">
                      {idx + 1}
                    </span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </div>

      {/* Bottom 2-Column Info Row matching screenshot reference */}
      <div class="mt-12 sm:mt-16 pt-8 sm:pt-10 border-t border-border/70 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <div class="space-y-2">
          <h3 class="font-display text-sm sm:text-base font-bold text-foreground">
            How It Works
          </h3>
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            By integrating automated scoring models with official exam rubrics, we provide instant 3-second evaluation for PTE and IELTS students across Nepal. We build fast, defendable tools without corporate bureaucracy.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="font-display text-sm sm:text-base font-bold text-foreground">
            Contact Us
          </h3>
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            Send your GitHub, live projects, writing sample, or curriculum ideas straight to <a href={generalMailto} class="text-orange-500 font-semibold hover:underline">{CAREERS_EMAIL}</a>. We respond to every thoughtful note.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Simple accordion expand/collapse script
  function setupAccordions() {
    const cards = document.querySelectorAll('[data-role-card]');
    cards.forEach((card) => {
      const toggle = card.querySelector('[data-accordion-toggle]');
      const content = card.querySelector('[data-accordion-content]');
      const icon = toggle?.querySelector('svg');

      if (toggle && content) {
        toggle.addEventListener('click', () => {
          const isHidden = content.classList.contains('hidden');
          if (isHidden) {
            content.classList.remove('hidden');
            icon?.classList.add('rotate-180');
          } else {
            content.classList.add('hidden');
            icon?.classList.remove('rotate-180');
          }
        });
      }
    });
  }

  setupAccordions();
  document.addEventListener('astro:page-load', setupAccordions);
</script>
