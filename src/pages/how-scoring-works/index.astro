---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbs, organization, website } from '@/lib/schema';
import { appUrl, asset, BASE_PATH } from '@/consts';

/**
 * The methodology page.
 *
 * Every other page on this site says the scoring is "aligned to the official
 * criteria". This is the page that has to show its working — which criteria,
 * what the model actually measures, and, just as importantly, what the number
 * is not. A prep platform that will not say where its scores come from is
 * asking for trust it has not earned, and search engines increasingly read a
 * methodology page as the difference.
 *
 * Deliberately absent: any accuracy percentage or correlation figure. Those
 * would need a published study against real results, which does not exist yet.
 */
const origin = Astro.site ?? new URL(Astro.url.origin);
const site = new URL(BASE_PATH, origin);
const url = new URL(Astro.url.pathname, origin);

const title = 'How Prepyo scores your writing and speaking | Prepyo';
const description =
  'The criteria Prepyo marks PTE and IELTS answers against, what the scoring model measures in speaking and writing, and what an estimated score cannot tell you.';

const schema = [
  organization(site),
  website(site),
  breadcrumbs(url, [
    { name: 'Home', item: site.href },
    { name: 'How scoring works', item: url.href },
  ]),
];

const CRITERIA = [
  {
    exam: 'IELTS Academic — Writing',
    href: '/ielts-academic-preparation/',
    items: [
      'Task Achievement / Task Response',
      'Coherence and Cohesion',
      'Lexical Resource',
      'Grammatical Range and Accuracy',
    ],
    note: 'The four are equally weighted and averaged, so the weakest one caps the band.',
  },
  {
    exam: 'IELTS Academic — Speaking',
    href: '/ielts-academic-preparation/',
    items: [
      'Fluency and Coherence',
      'Lexical Resource',
      'Grammatical Range and Accuracy',
      'Pronunciation',
    ],
    note: 'Assessed across all three parts of the speaking test, not part by part.',
  },
  {
    exam: 'PTE Academic',
    href: '/pte-academic-preparation/',
    items: [
      'Communicative skills: listening, reading, speaking, writing',
      'Content, form and task fulfilment',
      'Oral fluency and pronunciation',
      'Grammar, vocabulary, spelling and written discourse',
    ],
    note: 'Most tasks are integrated, so one answer contributes to more than one score.',
  },
];

const MEASURES = [
  {
    icon: 'lucide:mic',
    title: 'Speaking',
    body: 'Your recording is transcribed and compared with the expected response. Each word gets a pronunciation score, and your pace, hesitations and pause placement are measured — the three things a fluency mark is built from and the three you cannot judge in your own voice.',
  },
  {
    icon: 'lucide:pen-tool',
    title: 'Writing',
    body: 'Your text is assessed against each criterion separately rather than as one impression, so the report can tell you that structure is holding you back while vocabulary is not. Individual sentences come back with a stronger version and the reason it is stronger.',
  },
  {
    icon: 'lucide:list-checks',
    title: 'Reading and listening',
    body: 'These are marked objectively against the answer key, the same way the real test does it. There is no estimation involved — a right answer is a right answer.',
  },
];

const LIMITS = [
  'It is an estimate, not a result. Prepyo has no access to Pearson or IDP marking, and no practice platform can issue an official score.',
  'Human examiners vary. Two IELTS examiners can place the same essay half a band apart, so treat any single score — ours or a tutor’s — as a reading, not a verdict.',
  'Unusual answers are where estimates are weakest. A response that is strong but far outside the expected shape of the task is the case any automated marker handles least well.',
  'The number is the least useful part of the report. What moves your band is the criterion breakdown telling you where the marks went, which is why it sits above the score rather than below it.',
];
---

<Layout title={title} description={description} schema={schema}>
  <article class="w-full space-y-4">
    <Breadcrumbs trail={[{ name: 'Home', href: asset('/') }, { name: 'How scoring works' }]} />

    <header class="pt-6 sm:pt-10 max-w-3xl">
      <h1
        class="font-display text-3xl sm:text-5xl font-bold tracking-tight text-foreground text-balance leading-[1.1]"
      >
        How Prepyo scores your writing and speaking
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed mt-5 text-balance">
        Marking criteria are public documents. Here is which ones your answers are measured against,
        what the model looks at, and where an estimated score stops being useful.
      </p>
    </header>

    {/* Criteria */}
    <section class="py-10 sm:py-14 border-t border-border mt-6">
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        The criteria your answers are marked against
      </h2>
      <p class="text-sm text-muted-foreground mt-2 max-w-2xl">
        Pearson and the IELTS partners publish the descriptors their examiners work from. Prepyo
        scores against those same criteria rather than a scale of its own.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 sm:gap-4 mt-6">
        {
          CRITERIA.map(group => (
            <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 flex flex-col">
              <h3 class="font-display font-bold text-sm text-foreground">{group.exam}</h3>
              <ul class="space-y-2 mt-4 flex-1">
                {group.items.map(item => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-muted-foreground">
                    <div class="w-4 h-4 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0 mt-0.5">
                      <Icon name="lucide:check" class="w-2.5 h-2.5 stroke-[3]" />
                    </div>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <p class="text-xs text-muted-foreground/90 italic mt-4 pt-4 border-t border-border/60">
                {group.note}
              </p>
              <a
                href={asset(group.href)}
                class="text-xs font-semibold text-primary hover:underline mt-3 inline-flex items-center gap-1"
              >
                <span>Full breakdown</span>
                <Icon name="lucide:arrow-right" class="w-3 h-3" />
              </a>
            </div>
          ))
        }
      </div>
    </section>

    {/* What is measured */}
    <section class="py-10 sm:py-14 border-t border-border">
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        What the model actually measures
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 mt-6">
        {
          MEASURES.map(measure => (
            <div class="rounded-2xl border border-border bg-card p-5 sm:p-6">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                <Icon name={measure.icon} class="w-5 h-5" />
              </div>
              <h3 class="font-display font-bold text-sm text-foreground mt-4">{measure.title}</h3>
              <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">{measure.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* Limits */}
    <section class="py-10 sm:py-14 border-t border-border">
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        What an estimated score cannot tell you
      </h2>
      <p class="text-sm text-muted-foreground mt-2 max-w-2xl">
        This section matters more than the one above it. A prep score that is treated as a promise
        does more damage than one that is treated as a reading.
      </p>

      <ul class="space-y-3 mt-6 max-w-3xl">
        {
          LIMITS.map(limit => (
            <li class="flex items-start gap-3 rounded-2xl border border-border bg-card p-4 sm:p-5">
              <div class="w-5 h-5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <Icon name="lucide:alert-triangle" class="w-3 h-3" />
              </div>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">{limit}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* CTA */}
    <section class="py-10 sm:py-14 border-t border-border">
      <div class="rounded-2xl border border-border bg-card p-6 sm:p-8 max-w-3xl">
        <h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-foreground">
          See it on your own writing
        </h2>
        <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
          The free diagnostic takes about twenty minutes and returns a breakdown across all four
          skills, marked the way this page describes.
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <Button href={appUrl('/diagnostic')} size="lg" class="rounded-full font-bold text-sm px-7 h-12">
            Take the free diagnostic
          </Button>
          <Button
            href={asset('/pte-academic-preparation/')}
            variant="outline"
            size="lg"
            class="rounded-full font-bold text-sm px-7 h-12"
          >
            PTE preparation
          </Button>
          <Button
            href={asset('/ielts-academic-preparation/')}
            variant="outline"
            size="lg"
            class="rounded-full font-bold text-sm px-7 h-12"
          >
            IELTS preparation
          </Button>
        </div>
      </div>
    </section>
  </article>
</Layout>
