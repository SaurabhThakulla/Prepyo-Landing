---
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button.astro';
import { appUrl } from '@/consts';

// Floating animated skill pills arranged in a circular orbit (Ring 2: R~440px, Ring 3: R~620px)
const ORBITS = [
  { icon: 'lucide:mic', label: 'Speaking AI', color: 'text-[#5865F2]', bg: 'bg-[#5865F2]/10', x: -370, y: -240, anim: 'animate-float' },
  { icon: 'lucide:sparkles', label: 'Instant 3s Scoring', color: 'text-amber-500', bg: 'bg-amber-500/10', x: 370, y: -240, anim: 'animate-float-delay' },
  { icon: 'lucide:pen-tool', label: 'Writing Rewrites', color: 'text-teal-500', bg: 'bg-teal-500/10', x: -370, y: 240, anim: 'animate-float' },
  { icon: 'lucide:headphones', label: 'Listening Mock', color: 'text-indigo-500', bg: 'bg-indigo-500/10', x: 370, y: 240, anim: 'animate-float-delay' },
  { icon: 'lucide:book-open', label: 'Reading Practice', color: 'text-sky-500', bg: 'bg-sky-500/10', x: -610, y: 0, anim: 'animate-float' },
  { icon: 'lucide:award', label: 'PTE 79+ Goal', color: 'text-[#5865F2]', bg: 'bg-[#5865F2]/10', x: 610, y: 0, anim: 'animate-float-delay' },
  { icon: 'lucide:shield-check', label: 'Pearson Aligned', color: 'text-emerald-500', bg: 'bg-emerald-500/10', x: -310, y: -535, anim: 'animate-float' },
  { icon: 'lucide:graduation-cap', label: 'IELTS Band 8.0', color: 'text-purple-500', bg: 'bg-purple-500/10', x: 310, y: -535, anim: 'animate-float-delay' },
];
---

<section
  class="relative w-full overflow-hidden min-h-[580px] sm:min-h-[720px] lg:min-h-[780px] flex items-center justify-center py-16 sm:py-28 border-b border-border/40"
  data-hero
>
  {/* Ambient lights */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-primary/10 dark:bg-primary/15 blur-[140px] rounded-full animate-pulse"></div>
  </div>

  {/* Concentric floating message capsules (hidden on mobile, shown on tablet/desktop) */}
  <div class="hidden sm:flex absolute inset-0 pointer-events-none items-center justify-center z-10 overflow-hidden" aria-hidden="true">
    <div class="relative w-[1500px] h-[1500px] flex items-center justify-center sm:scale-[0.68] md:scale-[0.80] lg:scale-[0.92] xl:scale-100 transition-transform origin-center">
      {
        ORBITS.map(({ icon, color, bg, label, x, y, anim }) => (
          <div
            class="absolute pointer-events-auto select-none"
            style={`left: calc(50% + ${x}px); top: calc(50% + ${y}px); transform: translate(-50%, -50%);`}
          >
            <div
              class:list={[
                'group flex items-center gap-2.5 px-4 py-2 rounded-full bg-card/95 dark:bg-card/90 border border-border/80 dark:border-white/15 shadow-xl shadow-black/5 dark:shadow-black/30 backdrop-blur-xl transition-all duration-300 hover:scale-110 hover:border-[#5865F2] hover:shadow-2xl hover:shadow-[#5865F2]/20 cursor-pointer whitespace-nowrap',
                anim,
              ]}
            >
              <div class={`w-6 h-6 rounded-full ${bg} flex items-center justify-center shrink-0`}>
                <Icon name={icon} class={`w-3.5 h-3.5 ${color}`} />
              </div>
              <span class="text-xs sm:text-sm font-bold text-foreground/90">{label}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  {/* Centered Hero Content */}
  <div class="relative z-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-foreground text-balance max-w-4xl leading-[1.1] sm:leading-[1.08]">
      Ace PTE 79+ &amp; IELTS 8.0 on your{' '}
      <span class="bg-gradient-to-r from-primary via-[#5865F2] to-sky-400 bg-clip-text text-transparent">
        first attempt.
      </span>
    </h1>

    <p class="text-base sm:text-lg lg:text-xl text-muted-foreground leading-relaxed max-w-2xl mx-auto mt-6 text-balance font-normal">
      Full-length mock exam simulations evaluated by official AI models in 3 seconds. Get instant pronunciation analysis, AI writing rewrites, and know your true band before test day.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mt-8 sm:mt-10 w-full sm:w-auto">
      <Button
        href={appUrl('/')}
        size="lg"
        class="group w-full sm:w-auto rounded-full font-bold text-sm px-8 h-12 bg-foreground text-background hover:bg-foreground/90 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-100 shadow-lg shadow-foreground/10 transition-all gap-2 hover:-translate-y-0.5"
      >
        <span>Get started free</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" />
      </Button>

      <Button
        href="#pricing"
        variant="outline"
        size="lg"
        class="w-full sm:w-auto rounded-full font-bold text-sm px-7 h-12 border-border/80 bg-card/80 hover:bg-card text-foreground transition-all shadow-sm hover:-translate-y-0.5"
      >
        <span>Explore plans</span>
      </Button>
    </div>
  </div>
</section>

<style>
  .animate-float:hover, .animate-float-delay:hover { animation-play-state: paused; }
</style>

<script>
  import { bindSectionLinks } from '@/scripts/scroll-to';
  const heroEl = document.querySelector('[data-hero]');
  if (heroEl) bindSectionLinks(heroEl);
</script>
