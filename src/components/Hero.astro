---
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button.astro';
import { appUrl, asset } from '@/consts';

// Statements about what the product does, plus the two usage numbers we can
// actually stand behind today. Anything beyond these stays off the page until
// it can be read from the database.
const HIGHLIGHTS = [
  { icon: 'lucide:sparkles', iconClass: 'text-purple-400', label: 'Instant AI feedback' },
  { icon: 'lucide:shield-check', iconClass: 'text-emerald-500', label: 'Real exam scoring' },
  { icon: 'lucide:users', iconClass: 'text-primary', label: 'PTE & IELTS' },
];
---

<section class="relative flex flex-col justify-between pt-2 sm:pt-4 pb-8 sm:pb-12" data-hero>
  {/* Ambient radial gradients, in their own clipping layer so the oversized
      blobs cannot widen the page on a phone. */}
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10" aria-hidden="true">
    <div
      class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-primary/10 blur-[120px] rounded-full"
    >
    </div>
    <div class="absolute top-1/3 right-10 w-[400px] h-[300px] bg-amber-500/10 blur-[100px] rounded-full"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-8 items-center w-full py-4 sm:py-10">
    {/* Copy and calls to action (7 cols) */}
    <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-center lg:text-left">
      {/* Eyebrow badge */}
      <div
        class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3.5 sm:px-4 py-1.5 text-[11px] sm:text-xs font-bold tracking-wide text-primary shadow-sm"
      >
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        <span>🇳🇵 AI-powered PTE &amp; IELTS prep, built in Nepal</span>
      </div>

      {/* Main headline */}
      <h1
        class="font-display text-[2rem] leading-[1.12] sm:text-5xl sm:leading-[1.08] lg:text-[3.4rem] xl:text-[3.8rem] font-extrabold tracking-[-0.03em] text-foreground text-balance"
      >
        Know your <span
          class="text-primary bg-gradient-to-r from-primary via-emerald-400 to-teal-400 bg-clip-text text-transparent"
          >real score</span
        > before the real test.
      </h1>

      {/* Subheading */}
      <p class="text-sm sm:text-base lg:text-lg text-muted-foreground leading-relaxed max-w-xl mx-auto lg:mx-0">
        Full-length PTE and IELTS mock tests, marked by AI in seconds.
      </p>

      {/* Value highlight chips */}
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 pt-1">
        {
          HIGHLIGHTS.map(({ icon, iconClass, label }) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card/80 backdrop-blur-sm px-3.5 py-1.5 text-xs font-semibold text-foreground shadow-sm">
              <Icon name={icon} class={`w-3.5 h-3.5 ${iconClass}`} />
              <span>{label}</span>
            </span>
          ))
        }
      </div>

      {/* CTA buttons */}
      <div class="pt-1 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
        <Button
          href={appUrl('/signup')}
          size="lg"
          class="w-full sm:w-auto rounded-2xl font-extrabold text-sm px-6 sm:px-8 h-12 shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5 transition-all gap-2.5"
        >
          <span>Start Free Mock Test</span>
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </Button>

        <Button
          href="#pricing"
          variant="outline"
          size="lg"
          class="w-full sm:w-auto rounded-2xl font-bold text-sm px-6 sm:px-7 h-12 border-border hover:bg-card hover:-translate-y-0.5 transition-all"
        >
          Explore Plans (NPR)
        </Button>
      </div>

      {/* Social proof. Only numbers we can stand behind live here. */}
      <div
        class="pt-1 flex flex-col sm:flex-row sm:flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-x-5 sm:gap-y-2"
      >
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-0.5 text-amber-500" aria-hidden="true">
            <Icon name="lucide:star" class="w-3.5 h-3.5 fill-current" />
            <Icon name="lucide:star" class="w-3.5 h-3.5 fill-current" />
            <Icon name="lucide:star" class="w-3.5 h-3.5 fill-current" />
            <Icon name="lucide:star" class="w-3.5 h-3.5 fill-current" />
            <Icon name="lucide:star-half" class="w-3.5 h-3.5 fill-current" />
          </div>
          <p class="text-xs sm:text-sm text-muted-foreground">
            <span class="font-bold text-foreground">4.6</span> average rating out of 5
          </p>
        </div>

        <span class="hidden sm:block h-4 w-px bg-border" aria-hidden="true"></span>

        <div class="flex items-center gap-2">
          <Icon name="lucide:users" class="w-3.5 h-3.5 text-primary shrink-0" />
          <p class="text-xs sm:text-sm text-muted-foreground">
            <span class="font-bold text-foreground">100+</span> learners preparing with Prepyo
          </p>
        </div>
      </div>
    </div>

    {/* Hero visual mockup (5 cols) */}
    <div class="lg:col-span-5 relative flex justify-center py-4">
      {/* Floating AI feedback badge */}
      <div
        class="animate-float absolute -top-4 right-0 sm:right-6 z-20 flex items-center gap-2.5 rounded-2xl border border-border bg-card/95 backdrop-blur-md px-3 sm:px-4 py-2 sm:py-2.5 text-[11px] sm:text-xs font-bold text-foreground shadow-xl"
      >
        <div class="w-7 h-7 rounded-lg bg-primary/15 flex items-center justify-center text-primary shrink-0">
          <Icon name="lucide:sparkles" class="w-4 h-4" />
        </div>
        <div>
          <div class="text-foreground">AI Scored in 3s</div>
          <div class="text-[10px] text-muted-foreground font-normal">PTE 79+ / IELTS 8.0 Band</div>
        </div>
      </div>

      {/* Floating matched result badge */}
      <div
        class="animate-float-delay absolute -bottom-4 left-0 sm:left-4 z-20 flex items-center gap-2.5 rounded-2xl border border-emerald-500/30 bg-card/95 backdrop-blur-md px-3 sm:px-4 py-2 sm:py-2.5 text-[11px] sm:text-xs font-bold text-emerald-600 dark:text-emerald-400 shadow-xl"
      >
        <div class="w-7 h-7 rounded-lg bg-emerald-500/15 flex items-center justify-center text-emerald-500 shrink-0">
          <Icon name="lucide:check" class="w-4 h-4 stroke-[3]" />
        </div>
        <div>
          <div class="text-foreground">Pearson &amp; IELTS Aligned</div>
          <div class="text-[10px] text-muted-foreground font-normal">Official band descriptors</div>
        </div>
      </div>

      {/* Product image frame */}
      <div
        class="relative w-full rounded-3xl overflow-hidden border border-border/80 bg-card shadow-2xl transition-all duration-300 hover:shadow-primary/10 group"
      >
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/5 via-transparent to-purple-500/5 pointer-events-none">
        </div>
        <img
          src={asset('/images/hero-showcase.jpg')}
          alt="Prepyo AI Exam Prep Interface & Dashboard"
          width="1376"
          height="768"
          class="w-full h-auto object-cover rounded-3xl transform transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { bindSectionLinks } from '@/scripts/scroll-to';

  bindSectionLinks(document.querySelector('[data-hero]')!);
</script>
