---
import { Icon } from 'astro-icon/components';

interface SolutionItem {
  iconBg: string;
  iconColor: string;
  title: string;
  desc: string;
}

const SOLUTION_ITEMS: SolutionItem[] = [
  {
    iconBg: 'bg-orange-500/10 dark:bg-orange-500/15',
    iconColor: 'text-orange-500',
    title: 'Accelerated Diagnostic Sessions',
    desc: 'Map your baseline across all 4 skills in 20 minutes without sitting a 3-hour exam.',
  },
  {
    iconBg: 'bg-indigo-500/10 dark:bg-indigo-500/15',
    iconColor: 'text-[#5865F2]',
    title: 'Multi-Skill Radar Breakdown',
    desc: 'Instant visual metrics for Speaking fluency, Writing coherence, Reading, and Listening.',
  },
  {
    iconBg: 'bg-emerald-500/10 dark:bg-emerald-500/15',
    iconColor: 'text-emerald-500',
    title: 'Official-Grade AI Scoring',
    desc: 'Scored against Pearson and Cambridge rubrics so you know your exact band before test day.',
  },
];
---

<section id="problems-and-solutions" class="py-14 sm:py-20 border-t border-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Main Section Header */}
    <div class="text-center mb-10 sm:mb-14">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight text-balance">
        Know exactly where you're losing marks
      </h2>
    </div>

    {/* 2-Column Layout */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      {/* Left Column: Heading & Highlights */}
      <div class="lg:col-span-5 space-y-5">
        <p class="text-muted-foreground text-sm sm:text-base leading-relaxed">
          Most students fail PTE or IELTS because they practice what they already know. Prepyo pinpoints the exact tasks dragging your score down so you improve faster.
        </p>

        <div class="space-y-3 pt-1">
          {
            SOLUTION_ITEMS.map(({ iconBg, iconColor, title, desc }) => (
              <div class="flex items-start gap-4 p-3.5 rounded-2xl border border-border/70 bg-card/60 hover:bg-card hover:border-border transition-all duration-200">
                <div
                  class={`w-10 h-10 rounded-xl ${iconBg} flex items-center justify-center shrink-0 shadow-sm mt-0.5`}
                >
                  <Icon name="lucide:zap" class={`w-4 h-4 ${iconColor}`} />
                </div>
                <div>
                  <h4 class="font-bold text-sm sm:text-base text-foreground">
                    {title}
                  </h4>
                  <p class="text-xs sm:text-sm text-muted-foreground mt-0.5 leading-relaxed">
                    {desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {/* Right Column: Borderless, Balanced Web Radar Graph */}
      <div class="lg:col-span-7 flex flex-col items-center py-2 sm:py-5">
        {/* Radar Graph Layout with Balanced Spacing (Top/Bottom and Left/Right) */}
        <div class="w-full flex flex-col items-center my-3 sm:my-5">
          {/* Top: Speaking Badge (Directly above the graph with clean breathing room) */}
          <div class="flex items-center gap-1.5 rounded-full bg-card dark:bg-slate-900 border border-border/80 px-3.5 py-1.5 text-xs font-bold text-foreground shadow-sm mb-3 z-10 whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <Icon name="lucide:mic" class="w-3.5 h-3.5 text-[#5865F2] shrink-0" />
            <span>Speaking</span>
            <span class="font-extrabold text-[#5865F2] dark:text-indigo-400 font-mono ml-0.5">86</span>
          </div>

          {/* Middle Row: Left Badge + SVG Graph + Right Badge */}
          <div class="flex items-center justify-center gap-2 sm:gap-3.5 w-full">
            {/* Left: Listening Badge (Ample spacing, never touches graph) */}
            <div class="flex items-center gap-1.5 rounded-full bg-card dark:bg-slate-900 border border-border/80 px-2.5 sm:px-3.5 py-1 text-[11px] sm:text-xs font-bold text-foreground shadow-sm shrink-0 whitespace-nowrap">
              <span class="w-2 h-2 rounded-full bg-purple-500"></span>
              <Icon name="lucide:headphones" class="w-3.5 h-3.5 text-purple-500 shrink-0" />
              <span>Listening</span>
              <span class="font-extrabold text-purple-500 font-mono ml-0.5">82</span>
            </div>

            {/* SVG Radar Graph Canvas */}
            <div class="relative shrink-0 w-[210px] h-[210px] sm:w-[260px] sm:h-[260px] md:w-[290px] md:h-[290px]">
              <svg viewBox="0 0 320 320" class="w-full h-full overflow-visible">
                <defs>
                  {/* Active Skill Area Gradient */}
                  <linearGradient id="skill-radar-fill" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
                    <stop offset="50%" stop-color="#5865f2" stop-opacity="0.30" />
                    <stop offset="100%" stop-color="#a855f7" stop-opacity="0.35" />
                  </linearGradient>

                  {/* Target Benchmark Gradient */}
                  <linearGradient id="target-radar-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#f97316" stop-opacity="0.75" />
                    <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.75" />
                  </linearGradient>
                </defs>

                {/* 1. Spider Web Radial Axes */}
                <g class="opacity-25 stroke-foreground" stroke-width="1.2">
                  <line x1="160" y1="26" x2="160" y2="294" />
                  <line x1="26" y1="160" x2="294" y2="160" />
                  <line x1="65" y1="65" x2="255" y2="255" stroke-dasharray="3 3" opacity="0.6" />
                  <line x1="255" y1="65" x2="65" y2="255" stroke-dasharray="3 3" opacity="0.6" />
                </g>

                {/* 2. Concentric Spider-Web Diamond Polygons (20%, 40%, 60%, 80%, 100%) */}
                <polygon points="160,134 186,160 160,186 134,160" fill="none" class="stroke-foreground opacity-15" stroke-width="1" stroke-dasharray="3 3" />
                <polygon points="160,108 212,160 160,212 108,160" fill="none" class="stroke-foreground opacity-20" stroke-width="1" />
                <polygon points="160,82 238,160 160,238 82,160" fill="none" class="stroke-foreground opacity-25" stroke-width="1" stroke-dasharray="3 3" />
                <polygon points="160,56 264,160 160,264 56,160" fill="none" class="stroke-foreground opacity-30" stroke-width="1.2" />
                <polygon points="160,30 290,160 160,290 30,160" fill="none" class="stroke-foreground opacity-45" stroke-width="1.5" />

                {/* Calibration Marks */}
                <text x="165" y="111" font-size="8.5" font-weight="700" class="fill-muted-foreground select-none">40</text>
                <text x="165" y="59" font-size="8.5" font-weight="700" class="fill-muted-foreground select-none">75</text>

                {/* 3. Ghost Target Reference Line (Target 79 Benchmark) */}
                <polygon
                  points="160,46 274,160 160,274 46,160"
                  fill="none"
                  stroke="url(#target-radar-stroke)"
                  stroke-width="1.8"
                  stroke-dasharray="4 3"
                />

                {/* 4. Active Current Skill Profile Polygon (Speaking 86, Writing 74, Reading 78, Listening 82) */}
                <polygon
                  points="160,36 267,160 160,273 42,160"
                  fill="url(#skill-radar-fill)"
                  stroke="#5865f2"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                  class="drop-shadow-xl"
                />

                {/* 5. Glowing Vertex Nodes */}
                {/* Top: Speaking (86) */}
                <circle cx="160" cy="36" r="6" fill="#10b981" opacity="0.3" class="animate-ping" />
                <circle cx="160" cy="36" r="4" fill="#10b981" stroke="#ffffff" stroke-width="2" />

                {/* Right: Writing (74) */}
                <circle cx="267" cy="160" r="6" fill="#f59e0b" opacity="0.3" class="animate-ping" />
                <circle cx="267" cy="160" r="4" fill="#f59e0b" stroke="#ffffff" stroke-width="2" />

                {/* Bottom: Reading (78) */}
                <circle cx="160" cy="273" r="6" fill="#0ea5e9" opacity="0.3" class="animate-ping" />
                <circle cx="160" cy="273" r="4" fill="#0ea5e9" stroke="#ffffff" stroke-width="2" />

                {/* Left: Listening (82) */}
                <circle cx="42" cy="160" r="6" fill="#8b5cf6" opacity="0.3" class="animate-ping" />
                <circle cx="42" cy="160" r="4" fill="#8b5cf6" stroke="#ffffff" stroke-width="2" />

                {/* Center Hub */}
                <circle cx="160" cy="160" r="3.5" fill="#5865f2" />
              </svg>
            </div>

            {/* Right: Writing Badge (Ample spacing, never touches graph) */}
            <div class="flex items-center gap-1.5 rounded-full bg-card dark:bg-slate-900 border border-border/80 px-2.5 sm:px-3.5 py-1 text-[11px] sm:text-xs font-bold text-foreground shadow-sm shrink-0 whitespace-nowrap">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <Icon name="lucide:file-edit" class="w-3.5 h-3.5 text-amber-500 shrink-0" />
              <span>Writing</span>
              <span class="font-extrabold text-amber-500 font-mono ml-0.5">74</span>
            </div>
          </div>

          {/* Bottom: Reading Badge (Directly below the graph with clean breathing room) */}
          <div class="flex items-center gap-1.5 rounded-full bg-card dark:bg-slate-900 border border-border/80 px-3.5 py-1.5 text-xs font-bold text-foreground shadow-sm mt-3 z-10 whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-sky-500"></span>
            <Icon name="lucide:book-open" class="w-3.5 h-3.5 text-sky-500 shrink-0" />
            <span>Reading</span>
            <span class="font-extrabold text-sky-500 font-mono ml-0.5">78</span>
          </div>
        </div>

        {/* Metrics Summary & Legend */}
        <div class="w-full max-w-md mt-6 sm:mt-8 flex flex-col items-center gap-3.5">
          <div class="w-full grid grid-cols-2 gap-3">
            <div class="rounded-2xl bg-card border border-border/70 p-3 text-center shadow-sm">
              <span class="text-[11px] font-semibold text-muted-foreground block">Predicted Score</span>
              <span class="text-lg font-bold text-foreground mt-0.5 block">80 <span class="text-xs font-semibold text-emerald-500">/ 90</span></span>
            </div>
            <div class="rounded-2xl bg-card border border-border/70 p-3 text-center shadow-sm">
              <span class="text-[11px] font-semibold text-muted-foreground block">Target Benchmark</span>
              <span class="text-lg font-bold text-foreground mt-0.5 block">79+ <span class="text-xs font-semibold text-amber-500">Goal</span></span>
            </div>
          </div>

          <div class="flex items-center justify-center gap-6 text-xs">
            <div class="flex items-center gap-1.5 font-medium text-foreground">
              <span class="w-2.5 h-2.5 rounded-full bg-[#5865f2]"></span>
              <span>Your Skills (Avg 80)</span>
            </div>
            <div class="flex items-center gap-1.5 font-medium text-muted-foreground">
              <span class="w-3.5 h-0.5 border-t-2 border-dashed border-orange-500"></span>
              <span>Target 79+</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
