---
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button.astro';
import { appUrl } from '@/consts';
---

<section class="py-16 border-t border-border" data-final-cta>
  <div class="rounded-3xl bg-primary p-10 sm:p-14 text-white text-center space-y-6 relative overflow-hidden">
    {/* Decorative glow */}
    <div
      class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-white/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-white/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 space-y-3">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/15 px-4 py-1.5 text-xs font-bold uppercase tracking-wider"
      >
        <Icon name="lucide:zap" class="w-3.5 h-3.5" /> Free to start
      </span>

      <h2 class="font-display text-3xl sm:text-4xl font-black">Ready to find out where you stand?</h2>

      <p class="text-sm text-white/80 max-w-md mx-auto leading-relaxed">
        Take the free diagnostic and get your first score estimate today. No card required.
      </p>
    </div>

    <div class="relative z-10 flex flex-col sm:flex-row gap-3 items-center justify-center">
      <Button
        href={appUrl('/diagnostic')}
        size="lg"
        class="rounded-2xl bg-white text-primary hover:bg-white/90 font-extrabold text-sm px-8 h-12 shadow-md hover:-translate-y-0.5 transition-all gap-2.5"
      >
        <span>Start free diagnostic</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </Button>

      <Button
        href="#pricing"
        variant="ghost"
        size="lg"
        class="rounded-2xl text-white hover:bg-white/10 hover:text-white font-bold text-sm px-6 h-12"
      >
        See pricing
      </Button>
    </div>

    <p class="relative z-10 text-[11px] text-white/60">
      Free tier includes 3 AI evaluations a day, 1 full mock exam and mistake bank tracking.
    </p>
  </div>
</section>

<script>
  import { bindSectionLinks } from '@/scripts/scroll-to';

  bindSectionLinks(document.querySelector('[data-final-cta]')!);
</script>
