---
import { Icon } from 'astro-icon/components';

const FAQS = [
  {
    question: 'How accurate is the AI score?',
    answer:
      'Prepyo marks your work against the official PTE and IELTS band descriptors — the same checklist an examiner uses. Treat it as a close estimate to study against, not a guaranteed exam score.',
  },
  {
    question: 'How do I pay from Nepal?',
    answer: 'In rupees, with eSewa, Khalti, Fonepay QR or mobile banking. No dollar card needed.',
  },
  {
    question: 'Can I practise both PTE and IELTS?',
    answer: 'Yes. Switch between them any time. Your progress and mistakes are saved separately for each.',
  },
  {
    question: 'What do I get for free?',
    answer: 'One full mock test, three AI checks a day, your mistake bank and daily practice. Upgrade when you need more.',
  },
  {
    question: 'Do you work with consultancies and institutes?',
    answer: 'Yes. Run your whole batch on Prepyo and track their results in one place. Email institutes@prepyo.np.',
  },
];

// The first answer is open on arrival so the section never reads as a wall of
// closed rows.
const DEFAULT_OPEN = 0;
---

<section id="faq" class="py-14 sm:py-24 border-t border-border" data-faq>
  {/* Matches SectionHeading's scale so the FAQ does not tower over every other
      section on the page. */}
  <div class="text-center space-y-3 mb-10 sm:mb-14 max-w-3xl mx-auto">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-foreground"
    >
      <Icon name="lucide:help-circle" class="w-3.5 h-3.5 text-primary" />
      Got Questions?
    </span>

    <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black text-foreground tracking-tight text-balance px-2">
      Frequently asked questions
    </h2>
  </div>

  <div class="max-w-4xl lg:max-w-5xl mx-auto space-y-3 sm:space-y-4">
    {
      FAQS.map((faq, idx) => {
        const isOpen = idx === DEFAULT_OPEN;

        return (
          <div
            data-faq-item
            class:list={[
              'rounded-2xl sm:rounded-3xl border transition-all duration-300 overflow-hidden',
              isOpen
                ? 'border-primary/50 bg-card shadow-xl shadow-primary/5 ring-1 ring-primary/20'
                : 'border-border bg-card/70 hover:bg-card hover:border-border/80 hover:shadow-md',
            ]}
          >
            <button
              type="button"
              aria-expanded={String(isOpen)}
              aria-controls={`faq-answer-${idx}`}
              class="w-full p-4 sm:p-6 text-left flex items-center justify-between gap-4 sm:gap-6 cursor-pointer"
              data-faq-trigger
            >
              <span class="font-display text-sm sm:text-base lg:text-lg font-bold text-foreground leading-snug">
                {faq.question}
              </span>
              <div
                data-faq-chevron
                class:list={[
                  'w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center shrink-0 border transition-all duration-300',
                  isOpen
                    ? 'bg-primary text-white border-primary rotate-180 shadow-md shadow-primary/30'
                    : 'bg-muted text-muted-foreground border-border hover:text-foreground',
                ]}
              >
                <Icon name="lucide:chevron-down" class="w-5 h-5" />
              </div>
            </button>

            <div
              id={`faq-answer-${idx}`}
              data-faq-answer
              class:list={[
                'px-4 sm:px-6 pb-5 sm:pb-6 pt-3 text-xs sm:text-sm text-muted-foreground leading-relaxed border-t border-border/40 animate-in fade-in slide-in-from-top-1 duration-200',
                !isOpen && 'hidden',
              ]}
            >
              {faq.answer}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-item]'));

  // Only the classes that differ between the two states, so the shared ones
  // stay declared once in the markup.
  const OPEN_CARD = ['border-primary/50', 'bg-card', 'shadow-xl', 'shadow-primary/5', 'ring-1', 'ring-primary/20'];
  const CLOSED_CARD = ['border-border', 'bg-card/70', 'hover:bg-card', 'hover:border-border/80', 'hover:shadow-md'];
  const OPEN_CHEVRON = ['bg-primary', 'text-white', 'border-primary', 'rotate-180', 'shadow-md', 'shadow-primary/30'];
  const CLOSED_CHEVRON = ['bg-muted', 'text-muted-foreground', 'border-border', 'hover:text-foreground'];

  function paint(item: HTMLElement, open: boolean) {
    const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]')!;
    const chevron = item.querySelector<HTMLElement>('[data-faq-chevron]')!;
    const answer = item.querySelector<HTMLElement>('[data-faq-answer]')!;

    item.classList.toggle('open', open);
    trigger.setAttribute('aria-expanded', String(open));
    answer.classList.toggle('hidden', !open);

    OPEN_CARD.forEach(cls => item.classList.toggle(cls, open));
    CLOSED_CARD.forEach(cls => item.classList.toggle(cls, !open));
    OPEN_CHEVRON.forEach(cls => chevron.classList.toggle(cls, open));
    CLOSED_CHEVRON.forEach(cls => chevron.classList.toggle(cls, !open));
  }

  items.forEach(item => {
    item.querySelector<HTMLButtonElement>('[data-faq-trigger]')!.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      // One answer at a time, matching the accordion the app shipped.
      items.forEach(other => paint(other, other === item && willOpen));
    });
  });

  // Reflect the server-rendered open row in the class the click handler reads.
  items.forEach(item => item.classList.toggle('open', !item.querySelector('[data-faq-answer]')!.classList.contains('hidden')));
</script>
