---
import { Icon } from 'astro-icon/components';
import SectionHeading from '@/components/SectionHeading.astro';
import { STEPS } from '@/data/steps';

// How much higher each step stands than the one before it, on desktop.
const RISE = 56;
---

<section id="how-it-works" class="py-14 sm:py-20 border-t border-border relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionHeading
      eyebrow="How it works"
      eyebrowIcon="lucide:route"
      title="Four steps to your target score"
      description="One connected path that adapts to your progress, from first baseline to exam day."
    />

    {/* A staircase: each step stands higher than the last, and a thick path dips
        between their step blocks. The path is drawn from measured positions by
        the script below, so it stays attached at every width. On small screens
        the steps stack and there is no path. */}
    <div class="relative lg:pb-28" data-steps>
      <svg
        class="hidden lg:block absolute inset-0 w-full h-full pointer-events-none z-0 overflow-visible"
        data-steps-svg
        aria-hidden="true"></svg>

      <ol class="relative z-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6 lg:items-end">
        {
          STEPS.map((step, i) => (
            <li class="flex flex-col items-center text-center lg:pb-[var(--rise)]" style={`--rise:${i * RISE}px`}>
              <div
                class="w-16 h-16 rounded-full flex items-center justify-center text-white shadow-lg ring-8 ring-background"
                style={`background:${step.hex}; box-shadow:0 10px 24px -8px ${step.hex}`}
              >
                <Icon name={step.icon} class="w-7 h-7" />
              </div>

              <h3 class="mt-4 font-display font-medium text-base uppercase tracking-wide text-foreground">{step.title}</h3>
              <p class="mt-1.5 max-w-[16rem] text-sm text-foreground/75 leading-relaxed">{step.desc}</p>

              {/* A darker band across the bottom gives the block depth without paling the white label. */}
              <div
                class="step-block mt-6 w-full max-w-[13rem] h-14 rounded-md flex items-center justify-center font-display font-black text-lg uppercase tracking-wider text-white shadow-lg"
                style={`--c:${step.hex}`}
                data-step-block
                data-step-color={step.hex}
              >
                Step {step.step}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .step-block {
    background:
      linear-gradient(165deg, transparent 0 58%, rgb(0 0 0 / 0.12) 58%),
      var(--c);
  }
</style>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const wrap = document.querySelector<HTMLElement>('[data-steps]');

  if (wrap) {
    const svg = wrap.querySelector<SVGSVGElement>('[data-steps-svg]')!;
    const blocks = [...wrap.querySelectorAll<HTMLElement>('[data-step-block]')];
    const desktop = window.matchMedia('(min-width: 1024px)');

    function draw() {
      svg.replaceChildren();
      // Below `lg` the steps stack, so there is no staircase to join.
      if (!desktop.matches || blocks.length < 2) return;

      const box = wrap!.getBoundingClientRect();
      // Centre of each block; the path tucks under the blocks, which sit above it.
      const points = blocks.map(block => {
        const r = block.getBoundingClientRect();
        return { x: r.left - box.left + r.width / 2, y: r.top - box.top + r.height / 2, colour: block.dataset.stepColor! };
      });

      // One gradient along the whole path, through each step's colour.
      const first = points[0];
      const last = points[points.length - 1];
      const gradient = document.createElementNS(SVG_NS, 'linearGradient');
      gradient.id = 'steps-path';
      gradient.setAttribute('gradientUnits', 'userSpaceOnUse');
      gradient.setAttribute('x1', String(first.x));
      gradient.setAttribute('x2', String(last.x));
      gradient.setAttribute('y1', '0');
      gradient.setAttribute('y2', '0');
      points.forEach((point, i) => {
        const stop = document.createElementNS(SVG_NS, 'stop');
        stop.setAttribute('offset', String(i / (points.length - 1)));
        stop.setAttribute('stop-color', point.colour);
        gradient.append(stop);
      });
      const defs = document.createElementNS(SVG_NS, 'defs');
      defs.append(gradient);
      svg.append(defs);

      // Each leg leaves a block straight down, swings under, and rises into the next.
      const dip = 150;
      let d = `M ${first.x} ${first.y}`;
      for (let i = 1; i < points.length; i++) {
        const a = points[i - 1];
        const b = points[i];
        d += ` C ${a.x} ${a.y + dip}, ${b.x} ${b.y + dip}, ${b.x} ${b.y}`;
      }
      const path = document.createElementNS(SVG_NS, 'path');
      path.setAttribute('d', d);
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', 'url(#steps-path)');
      path.setAttribute('stroke-width', '12');
      svg.append(path);
    }

    // Redraw whenever the layout the path was measured against moves.
    // Coalesced through rAF, which a background tab never fires -- so the first
    // pass is direct, otherwise the path is missing until the tab is shown.
    let queued = 0;
    function redraw() {
      cancelAnimationFrame(queued);
      queued = requestAnimationFrame(draw);
    }

    draw();
    new ResizeObserver(redraw).observe(wrap);
    desktop.addEventListener('change', redraw);
    // Webfonts land after first paint and reflow the steps above the blocks.
    document.fonts?.ready.then(redraw);
  }
</script>
