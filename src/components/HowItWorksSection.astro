---
import { Icon } from 'astro-icon/components';
import SectionHeading from '@/components/SectionHeading.astro';

const STEPS = [
  {
    icon: 'lucide:file-text',
    color: 'text-primary',
    bg: 'bg-primary/10',
    title: '1. Take a free test',
    desc: 'A short test across all four skills to find your starting score.',
  },
  {
    icon: 'lucide:book-open',
    color: 'text-amber-500',
    bg: 'bg-amber-500/10',
    title: '2. Practise your weak spots',
    desc: 'Daily practice picked for you, with feedback on every answer.',
  },
  {
    icon: 'lucide:play-circle',
    color: 'text-purple-400',
    bg: 'bg-purple-500/10',
    title: '3. Sit a full mock',
    desc: 'Real timing, real pressure, and a full report the moment you finish.',
  },
  {
    icon: 'lucide:trending-up',
    color: 'text-emerald-500',
    bg: 'bg-emerald-500/10',
    title: '4. Book the real exam',
    desc: 'Once your score holds steady, you are ready for test day.',
  },
];
---

<section id="how-it-works" class="py-14 sm:py-20 border-t border-border">
  <SectionHeading
    eyebrow="How it works"
    eyebrowIcon="lucide:target"
    eyebrowIconClass="text-amber-500"
    title="Four steps to your target score"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-6 relative">
    {/* Connector line, desktop only */}
    <div
      class="hidden lg:block absolute top-12 left-[calc(12.5%+1.5rem)] right-[calc(12.5%+1.5rem)] h-px bg-border z-0"
      aria-hidden="true"
    >
    </div>

    {
      STEPS.map(({ icon, color, bg, title, desc }, index) => (
        <div class="relative z-10 text-center space-y-4 flex flex-col items-center">
          <div class="relative">
            <div class={`w-14 h-14 rounded-2xl ${bg} flex items-center justify-center border border-border shadow-sm`}>
              <Icon name={icon} class={`w-6 h-6 ${color}`} />
            </div>
            <span class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-foreground text-background text-[10px] font-black flex items-center justify-center shadow">
              {index + 1}
            </span>
          </div>

          <div>
            <h3 class="font-display font-bold text-base text-foreground">{title}</h3>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed max-w-[220px] mx-auto">{desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
