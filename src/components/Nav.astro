---
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button.astro';
import { appUrl, BASE_PATH, type ExamType } from '@/consts';

/**
 * Public navigation for the Prepyo landing page.
 *
 * Every in-page link smooth-scrolls to its section; everything that needs an
 * account (login, sign up) leaves for the Next.js app.
 */
const NAV_LINKS = [
  { id: 'features', label: 'Features' },
  { id: 'how-it-works', label: 'How it Works' },
  { id: 'pricing', label: 'Pricing (NPR)' },
  { id: 'institutions', label: 'For Institutes' },
  { id: 'faq', label: 'FAQ' },
];

const EXAM_OPTIONS: { exam: ExamType; label: string; target: string; targetClass: string }[] = [
  { exam: 'PTE', label: 'PTE Academic', target: '79+', targetClass: 'bg-primary/10 text-primary' },
  { exam: 'IELTS', label: 'IELTS Academic', target: '8.0', targetClass: 'bg-amber-500/10 text-amber-600' },
];

// PTE is the default, so it is rendered pre-selected and the script only has to
// correct it for visitors who previously chose IELTS.
const DEFAULT_EXAM: ExamType = 'PTE';
---

<div class="sticky top-0 z-50 w-full pt-3 sm:pt-4 px-3 sm:px-6 lg:px-8">
  <header
    class="w-full lg:max-w-[80vw] 2xl:max-w-[1440px] mx-auto rounded-[22px] border border-border/80 bg-card/90 backdrop-blur-xl shadow-md transition-all"
    data-nav
  >
    <div class="flex items-center justify-between gap-2 px-3 sm:px-6 py-2.5">
      {/* Logo */}
      <a href={BASE_PATH} class="flex items-center gap-2 group" data-logo>
        <div
          class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary text-white font-black text-sm shadow-sm group-hover:scale-105 transition-transform"
        >
          P
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-display text-xl font-extrabold tracking-tight text-foreground">
            prep<span class="text-primary">yo</span>
          </span>
          <span
            class="text-[9px] font-extrabold uppercase tracking-wider bg-nepal-blue/10 text-nepal-blue dark:text-indigo-400 px-1.5 py-0.5 rounded border border-nepal-blue/20"
          >
            NP
          </span>
        </div>
      </a>

      {/* Center navigation links (desktop) */}
      <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-muted-foreground">
        {/* Exams dropdown */}
        <div class="relative" data-products-menu>
          <button
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            class="flex items-center gap-1.5 hover:text-foreground transition-colors py-1"
            data-products-trigger
          >
            <span>Exams</span>
            <Icon name="lucide:chevron-down" class="w-3.5 h-3.5 transition-transform" data-products-chevron />
          </button>

          <div
            class="absolute top-full left-0 mt-2 w-52 rounded-2xl bg-card border border-border p-2 shadow-xl space-y-1 z-50 hidden"
            data-products-panel
          >
            {
              EXAM_OPTIONS.map(({ exam, label, target, targetClass }) => (
                <a
                  href="#products"
                  data-exam-option={exam}
                  class:list={[
                    'w-full p-2.5 rounded-xl text-xs font-bold flex items-center justify-between transition-colors cursor-pointer hover:bg-accent hover:text-accent-foreground',
                    exam === DEFAULT_EXAM && 'bg-accent text-accent-foreground',
                  ]}
                >
                  <span>{label}</span>
                  <span class={`text-[10px] px-1.5 py-0.5 rounded font-mono ${targetClass}`}>{target}</span>
                </a>
              ))
            }
          </div>
        </div>

        {
          NAV_LINKS.map(({ id, label }) => (
            <a href={`#${id}`} class="hover:text-foreground transition-colors cursor-pointer text-xs xl:text-sm">
              {label}
            </a>
          ))
        }
      </nav>

      {/* Right action icons and auth buttons */}
      <div class="flex items-center gap-1 sm:gap-2.5 shrink-0">
        <Button
          variant="ghost"
          size="icon"
          class="rounded-full h-8 w-8 text-muted-foreground hover:text-foreground"
          aria-label="Switch to dark mode"
          data-theme-toggle
        >
          {/* Which icon shows is decided by the `dark` class on <html>, so the
              toggle is correct on first paint without waiting for a script. */}
          <Icon name="lucide:moon" class="w-4 h-4 dark:hidden" />
          <Icon name="lucide:sun" class="w-4 h-4 text-amber-400 hidden dark:block" />
        </Button>

        {/* Login and the arrow drop out on a phone: both are one tap away in
            the mobile menu, and keeping them here overflows a 360px screen. */}
        <Button
          href={appUrl('/login')}
          variant="ghost"
          size="sm"
          class="hidden sm:inline-flex rounded-full font-bold text-xs px-4 h-9"
        >
          Login
        </Button>

        <Button
          href={appUrl('/signup')}
          size="sm"
          class="rounded-full font-extrabold text-xs px-3.5 sm:px-5 h-9 shadow-sm hover:shadow-md transition-all gap-1.5"
        >
          <span>Sign up</span>
          <Icon name="lucide:arrow-right" class="hidden sm:block w-3 h-3" />
        </Button>

        {/* Mobile menu toggle */}
        <Button
          variant="ghost"
          size="icon"
          class="lg:hidden rounded-full h-8 w-8 text-muted-foreground hover:text-foreground"
          aria-expanded="false"
          aria-label="Open menu"
          data-mobile-toggle
        >
          <Icon name="lucide:menu" class="w-4 h-4" data-icon-menu />
          <Icon name="lucide:x" class="w-4 h-4 hidden" data-icon-close />
        </Button>
      </div>
    </div>

    {/* Mobile menu */}
    <nav
      class="lg:hidden border-t border-border px-4 py-3 space-y-1.5 animate-in fade-in slide-in-from-top-2 duration-200 hidden"
      data-mobile-menu
    >
      <span class="block px-2 pt-1 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
        Select Exam
      </span>
      {
        EXAM_OPTIONS.map(({ exam, label, target, targetClass }) => (
          <a
            href="#products"
            data-exam-option={exam}
            class:list={[
              'w-full p-2.5 rounded-xl text-xs font-bold flex items-center justify-between transition-colors hover:bg-accent hover:text-accent-foreground',
              exam === DEFAULT_EXAM && 'bg-accent text-accent-foreground',
            ]}
          >
            <span>{label}</span>
            <span class={`text-[10px] px-1.5 py-0.5 rounded font-mono ${targetClass}`}>{target}</span>
          </a>
        ))
      }

      <div class="pt-2 mt-1 border-t border-border space-y-1">
        <span class="block px-2 pt-1 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
          Navigation
        </span>
        {
          NAV_LINKS.map(({ id, label }) => (
            <a
              href={`#${id}`}
              class="block p-2.5 rounded-xl text-xs font-bold text-foreground hover:bg-accent hover:text-accent-foreground transition-colors cursor-pointer"
            >
              {label}
            </a>
          ))
        }
      </div>

      <div class="pt-2 border-t border-border flex items-center gap-2">
        <Button href={appUrl('/login')} variant="outline" size="sm" class="flex-1 rounded-xl text-xs font-bold">
          Login
        </Button>
        <Button href={appUrl('/signup')} size="sm" class="flex-1 rounded-xl text-xs font-bold">
          Sign up Free
        </Button>
      </div>
    </nav>
  </header>
</div>

<script>
  import { getActiveExam, setActiveExam, onExamChange, type ExamType } from '@/scripts/exam-state';
  import { bindSectionLinks, scrollToSection } from '@/scripts/scroll-to';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;

  // --- Exams dropdown -------------------------------------------------------
  const productsMenu = nav.querySelector<HTMLElement>('[data-products-menu]')!;
  const productsTrigger = productsMenu.querySelector<HTMLButtonElement>('[data-products-trigger]')!;
  const productsPanel = productsMenu.querySelector<HTMLElement>('[data-products-panel]')!;
  const productsChevron = productsMenu.querySelector<HTMLElement>('[data-products-chevron]')!;

  function setProductsOpen(open: boolean) {
    productsPanel.classList.toggle('hidden', !open);
    productsTrigger.setAttribute('aria-expanded', String(open));
    productsChevron.classList.toggle('rotate-180', open);
    productsChevron.classList.toggle('text-primary', open);
  }

  productsTrigger.addEventListener('click', () => {
    setProductsOpen(productsPanel.classList.contains('hidden'));
  });

  // Close on outside click or Escape, the same way the dropdown behaved in the app.
  document.addEventListener('mousedown', event => {
    if (!productsMenu.contains(event.target as Node)) setProductsOpen(false);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') setProductsOpen(false);
  });

  // --- Mobile menu ----------------------------------------------------------
  const mobileToggle = nav.querySelector<HTMLButtonElement>('[data-mobile-toggle]')!;
  const mobileMenu = nav.querySelector<HTMLElement>('[data-mobile-menu]')!;
  const iconMenu = mobileToggle.querySelector<HTMLElement>('[data-icon-menu]')!;
  const iconClose = mobileToggle.querySelector<HTMLElement>('[data-icon-close]')!;

  function setMobileOpen(open: boolean) {
    mobileMenu.classList.toggle('hidden', !open);
    iconMenu.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    mobileToggle.setAttribute('aria-expanded', String(open));
    mobileToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  mobileToggle.addEventListener('click', () => {
    setMobileOpen(mobileMenu.classList.contains('hidden'));
  });

  // --- Exam selection -------------------------------------------------------
  const examOptions = nav.querySelectorAll<HTMLAnchorElement>('[data-exam-option]');

  function paintActiveExam(active: ExamType) {
    examOptions.forEach(option => {
      const isActive = option.dataset.examOption === active;
      option.classList.toggle('bg-accent', isActive);
      option.classList.toggle('text-accent-foreground', isActive);
    });
  }

  examOptions.forEach(option => {
    option.addEventListener('click', event => {
      event.preventDefault();
      setActiveExam(option.dataset.examOption as ExamType);
      setProductsOpen(false);
      setMobileOpen(false);
      scrollToSection('products');
    });
  });

  onExamChange(paintActiveExam);
  paintActiveExam(getActiveExam());

  // --- In-page links --------------------------------------------------------
  // The exam options are anchors too, but they have their own handler above.
  bindSectionLinks(
    nav,
    () => {
      setProductsOpen(false);
      setMobileOpen(false);
    },
    'a[href^="#"]:not([data-exam-option])',
  );

  const logo = nav.querySelector<HTMLAnchorElement>('[data-logo]')!;
  logo.addEventListener('click', event => {
    event.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
    // The logo's own href already accounts for a sub-path deploy.
    window.history.pushState(null, '', logo.getAttribute('href'));
  });

  // --- Theme toggle ---------------------------------------------------------
  const themeToggle = nav.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;

  function syncThemeLabel() {
    const isDark = document.documentElement.classList.contains('dark');
    themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
  }

  themeToggle.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('prepyo-theme', isDark ? 'dark' : 'light');
    syncThemeLabel();
  });

  syncThemeLabel();
</script>
