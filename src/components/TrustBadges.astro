---
import { Icon } from 'astro-icon/components';

const BADGES = [
  {
    icon: 'lucide:shield-check',
    color: 'text-primary',
    bg: 'bg-primary/10',
    title: 'Pay the Nepali way',
    desc: 'eSewa, Khalti or Fonepay. No international card needed.',
  },
  {
    icon: 'lucide:clock',
    color: 'text-amber-500',
    bg: 'bg-amber-500/10',
    title: 'Open any hour',
    desc: 'No class timings. Study and ask questions whenever you are free.',
  },
  {
    icon: 'lucide:flame',
    color: 'text-rose-400',
    bg: 'bg-rose-500/10',
    title: 'Daily streaks',
    desc: 'Small daily goals keep you going. Streaks count practice, not logins.',
  },
];
---

<section class="py-10 sm:py-12 border-t border-border">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    {
      BADGES.map(({ icon, color, bg, title, desc }) => (
        <div class="flex items-start gap-4 p-5 rounded-2xl border border-border bg-card hover:border-primary/30 transition-all">
          <div class={`w-10 h-10 rounded-xl ${bg} flex items-center justify-center shrink-0`}>
            <Icon name={icon} class={`w-5 h-5 ${color}`} />
          </div>
          <div>
            <h3 class="font-display font-bold text-sm text-foreground">{title}</h3>
            <p class="text-xs text-muted-foreground mt-1 leading-relaxed">{desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
