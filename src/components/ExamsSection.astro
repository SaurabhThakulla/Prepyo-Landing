---
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { appUrl, type ExamType } from '@/consts';

interface ExamCard {
  exam: ExamType;
  name: string;
  targetLabel: string;
  scaleLabel: string;
  description: string;
  skills: string[];
  accent: string;
  accentBg: string;
}

const EXAMS: ExamCard[] = [
  {
    exam: 'PTE',
    name: 'PTE Academic',
    targetLabel: '79+',
    scaleLabel: 'Scored 10 – 90',
    description:
      'Computer-based, AI-scored, and accepted for Australian, New Zealand and UK visas. Results usually arrive within 48 hours.',
    skills: ['Read Aloud & Repeat Sentence', 'Summarize Written Text', 'Re-order Paragraphs', 'Write from Dictation'],
    accent: 'text-primary',
    accentBg: 'bg-primary/10',
  },
  {
    exam: 'IELTS',
    name: 'IELTS Academic',
    targetLabel: 'Band 8.0',
    scaleLabel: 'Scored 0 – 9 in half bands',
    description:
      'The most widely accepted English test for universities and immigration across the UK, Canada, Australia and Europe.',
    skills: ['Writing Task 1 & Task 2', 'True / False / Not Given', 'Matching Headings', 'Speaking Parts 1 – 3'],
    accent: 'text-amber-500',
    accentBg: 'bg-amber-500/10',
  },
];

// PTE is the default, so it renders pre-selected and the script only corrects
// it for a visitor who previously picked IELTS.
const DEFAULT_EXAM: ExamType = 'PTE';
---

{/*
  The "Products" entry in the nav, as a section on the page.

  Picking an exam here is remembered locally and shared with the nav, so the
  page reflects the choice — the profile-level target exam is set inside the app
  once the visitor has an account.
*/}
<section id="products" class="py-20 border-t border-border" data-exams>
  <SectionHeading
    eyebrow="Products"
    eyebrowIcon="lucide:graduation-cap"
    title="Choose your exam"
    description="One engine, two exams. Every task type, timing rule and scoring scale is configured per exam, so practice matches the test you are actually sitting."
  />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      EXAMS.map(({ exam, name, targetLabel, scaleLabel, description, skills, accent, accentBg }) => (
        <div
          data-exam-card={exam}
          class:list={[
            'rounded-2xl border bg-card p-6 space-y-5 transition-all hover:-translate-y-1 duration-200',
            exam === DEFAULT_EXAM ? 'border-primary/50 shadow-card' : 'border-border hover:border-primary/30',
          ]}
        >
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class={`w-11 h-11 rounded-xl ${accentBg} flex items-center justify-center`}>
                <Icon name="lucide:book-open" class={`w-5 h-5 ${accent}`} />
              </div>
              <div>
                <h3 class="font-display text-lg font-bold text-foreground">{name}</h3>
                <p class="text-[11px] text-muted-foreground">{scaleLabel}</p>
              </div>
            </div>

            <span class={`rounded-full ${accentBg} ${accent} px-3 py-1 text-xs font-black font-mono shrink-0`}>
              {targetLabel}
            </span>
          </div>

          <p class="text-xs text-muted-foreground leading-relaxed">{description}</p>

          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
            {skills.map(skill => (
              <li class="flex items-center gap-2 text-xs text-foreground font-medium">
                <Icon name="lucide:check-circle-2" class="w-3.5 h-3.5 text-primary shrink-0" />
                {skill}
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-2 pt-1">
            <Button
              size="sm"
              variant={exam === DEFAULT_EXAM ? 'outline' : 'default'}
              class="rounded-xl font-bold text-xs h-9 px-4"
              data-exam-select={exam}
            >
              {exam === DEFAULT_EXAM ? 'Selected' : `Prepare for ${exam}`}
            </Button>

            <Button
              href={appUrl('/diagnostic')}
              variant="ghost"
              size="sm"
              class="rounded-xl font-bold text-xs h-9 px-3 gap-1.5"
            >
              Free diagnostic
              <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
            </Button>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { getActiveExam, setActiveExam, onExamChange, type ExamType } from '@/scripts/exam-state';

  const section = document.querySelector<HTMLElement>('[data-exams]')!;
  const cards = section.querySelectorAll<HTMLElement>('[data-exam-card]');
  const buttons = section.querySelectorAll<HTMLButtonElement>('[data-exam-select]');

  // The two button variants differ only by these classes, so the selected state
  // can be swapped without re-rendering anything.
  const DEFAULT_VARIANT = ['bg-primary', 'text-primary-foreground', 'hover:bg-primary/90'];
  const OUTLINE_VARIANT = ['border', 'border-border', 'bg-background', 'hover:bg-accent', 'hover:text-accent-foreground'];

  function paintActiveExam(active: ExamType) {
    cards.forEach(card => {
      const isActive = card.dataset.examCard === active;
      card.classList.toggle('border-primary/50', isActive);
      card.classList.toggle('shadow-card', isActive);
      card.classList.toggle('border-border', !isActive);
      card.classList.toggle('hover:border-primary/30', !isActive);
    });

    buttons.forEach(button => {
      const exam = button.dataset.examSelect as ExamType;
      const isActive = exam === active;

      button.textContent = isActive ? 'Selected' : `Prepare for ${exam}`;
      button.classList.toggle('shadow-sm', true);
      DEFAULT_VARIANT.forEach(cls => button.classList.toggle(cls, !isActive));
      OUTLINE_VARIANT.forEach(cls => button.classList.toggle(cls, isActive));
    });
  }

  buttons.forEach(button => {
    button.addEventListener('click', () => setActiveExam(button.dataset.examSelect as ExamType));
  });

  onExamChange(paintActiveExam);
  paintActiveExam(getActiveExam());
</script>
