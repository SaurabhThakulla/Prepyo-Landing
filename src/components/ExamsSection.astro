---
import { Icon } from 'astro-icon/components';
import { appUrl, type ExamType } from '@/consts';

interface ExamCard {
  exam: ExamType;
  name: string;
  heading: string;
  targetLabel: string;
  scaleLabel: string;
  description: string;
  moreTasks: string;
  trackLabel: string;
  skills: string[];
  brandClass: string;
  dotColor: string;
}

const EXAMS: ExamCard[] = [
  {
    exam: 'PTE',
    name: 'PTE Academic',
    heading: "What You'll Practise & Master",
    targetLabel: '79+ goal',
    scaleLabel: 'Computer-marked · scored 10–90',
    description: 'Taken on a computer and marked by AI. Results usually arrive within 48 hours.',
    moreTasks: '+ 16 more task types',
    trackLabel: 'INSIDE THIS TRACK',
    skills: [
      'Read Aloud',
      'Repeat Sentence',
      'Summarize Written Text',
      'Write from Dictation',
    ],
    brandClass: 'text-[#1e4fe8] dark:text-[#1d4ed8]',
    dotColor: 'bg-[#1e4fe8] dark:bg-blue-400',
  },
  {
    exam: 'IELTS',
    name: 'IELTS Academic',
    heading: "What You'll Practise & Master",
    targetLabel: 'Band 8.0',
    scaleLabel: 'Examiner-marked · bands 0–9',
    description: 'The most widely accepted English test for universities and visas worldwide.',
    moreTasks: '+ 11 more task types',
    trackLabel: 'INSIDE THIS TRACK',
    skills: [
      'Writing Task 1 & 2',
      'True / False / Not Given',
      'Matching Headings',
      'Speaking Parts 1–3',
    ],
    brandClass: 'text-[#1e4fe8] dark:text-[#1d4ed8]',
    dotColor: 'bg-[#1e4fe8] dark:bg-blue-400',
  },
  {
    exam: 'JAPANESE',
    name: 'Japanese Language',
    heading: 'Planned Curriculum & Modules',
    targetLabel: 'JLPT N5–N1',
    scaleLabel: 'JLPT & NAT-TEST · N5–N1',
    description: 'Essential test preparation for study and work visas in Japan. Master Kanji, grammar, reading, and listening.',
    moreTasks: '+ 10 more task types',
    trackLabel: 'PLANNED MODULES',
    skills: [
      'Kanji & vocabulary',
      'Grammar drills',
    ],
    brandClass: 'text-[#48567e] dark:text-[#323d5b]',
    dotColor: 'bg-[#48567e] dark:bg-indigo-400',
  },
];

const DEFAULT_EXAM: ExamType = 'PTE';
---

<section id="products" class="py-14 sm:py-20 border-t border-border" data-exams>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="text-center space-y-2.5 mb-10 sm:mb-14">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight">
        Choose your exam
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground max-w-xl mx-auto leading-relaxed">
        Pick one exam to focus on. Every task, timer and score matches the real thing.
      </p>
    </div>

    {/* Outer Rounded Container Frame */}
    <div class="rounded-3xl border border-blue-200/50 dark:border-slate-800/80 p-3 sm:p-5 lg:p-7 bg-blue-50/20 dark:bg-slate-950/30 max-w-6xl xl:max-w-7xl mx-auto">
      {/* Stacked Cards */}
      <div class="flex flex-col gap-6 lg:gap-8">
        {
          EXAMS.map((item, index) => {
            const isInitialActive = item.exam === DEFAULT_EXAM;
            const isReverse = index === 1; // IELTS has brand on the right side

            return (
              <div
                data-exam-card={item.exam}
                class:list={[
                  'relative rounded-2xl lg:rounded-3xl transition-all duration-300',
                  item.exam === 'JAPANESE'
                    ? 'mt-3.5 cursor-default'
                    : isInitialActive
                      ? 'cursor-pointer ring-2 ring-[#1e4fe8] shadow-xl shadow-blue-500/15'
                      : 'cursor-pointer shadow-sm hover:shadow-md hover:ring-1 hover:ring-blue-300/40 dark:hover:ring-slate-700',
                ]}
              >
                {/* Floating Coming Soon Badge for Japanese Language Card */}
                {item.exam === 'JAPANESE' && (
                  <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap z-30 pointer-events-none">
                    <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-900 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-600/80 shadow-md">
                      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                      Coming Soon
                    </span>
                  </div>
                )}

                {/* Card Outer Shell with Rounded Corners and Subtle Border */}
                <div class="rounded-2xl lg:rounded-3xl overflow-hidden bg-white dark:bg-[#0f172a] border border-blue-100/80 dark:border-slate-800 relative w-full h-full min-h-[270px] lg:min-h-[300px]">
                  {/* Desktop Sawtooth SVG Background */}
                  {!isReverse ? (
                    // Left Brand: Cut slants from top-left to bottom-right with right-pointing teeth
                    <svg
                      class:list={[
                        'hidden md:block absolute inset-0 w-full h-full pointer-events-none z-0 fill-current',
                        item.brandClass,
                      ]}
                      viewBox="0 0 1000 320"
                      preserveAspectRatio="none"
                    >
                      <path d="M 0 0 L 320 0 L 322 18 L 365 40 L 328 62 L 372 84 L 334 106 L 379 128 L 340 150 L 386 172 L 346 194 L 393 216 L 352 238 L 400 260 L 358 282 L 365 320 L 0 320 Z" />
                    </svg>
                  ) : (
                    // Right Brand (IELTS): Cut slants from top-right to bottom-left with left-pointing teeth
                    <svg
                      class:list={[
                        'hidden md:block absolute inset-0 w-full h-full pointer-events-none z-0 fill-current',
                        item.brandClass,
                      ]}
                      viewBox="0 0 1000 320"
                      preserveAspectRatio="none"
                    >
                      <path d="M 1000 0 L 1000 320 L 635 320 L 642 282 L 600 260 L 648 238 L 607 216 L 654 194 L 614 172 L 660 150 L 621 128 L 666 106 L 628 84 L 672 62 L 635 40 L 678 18 L 680 0 Z" />
                    </svg>
                  )}

                  {/* Card Content Layout (Transparent on desktop so SVG sawtooth cut shows through!) */}
                  <div class="relative z-10 flex flex-col md:flex-row items-stretch justify-between w-full h-full min-h-[270px] lg:min-h-[300px]">
                    {/* Brand & Action Section */}
                    <div
                      class:list={[
                        'p-6 sm:p-7 lg:p-8 flex flex-col justify-between gap-5 text-white',
                        // Mobile background uses solid brand color, desktop is transparent for SVG
                        item.exam === 'JAPANESE' ? 'bg-[#48567e] dark:bg-[#323d5b]' : 'bg-[#1e4fe8] dark:bg-[#1d4ed8]',
                        'md:bg-transparent md:dark:bg-transparent',
                        isReverse
                          ? 'w-full md:w-[35%] lg:w-[34%] order-1 md:order-2 md:pl-10 lg:pl-12'
                          : 'w-full md:w-[35%] lg:w-[34%] order-1 md:order-1 md:pr-10 lg:pr-12',
                      ]}
                    >
                      <div class="space-y-3.5">
                        {/* Logo + Title Header Row */}
                        <div
                          class:list={[
                            'flex items-center gap-3.5',
                            isReverse ? 'flex-row-reverse md:flex-row-reverse text-left md:text-right justify-between md:justify-end' : 'flex-row justify-start',
                          ]}
                        >
                          {/* Logo Badge (White square with thin border matching screenshot) */}
                          <div class="w-12 h-12 bg-white rounded-xl shadow-xs border border-slate-200/50 flex flex-col items-center justify-center shrink-0 select-none p-1">
                            {item.exam === 'PTE' && (
                              <>
                                <span class="text-[7.5px] font-bold text-slate-500 tracking-wider uppercase leading-none">PEARSON</span>
                                <span class="text-sm font-black text-[#002B49] leading-none mt-0.5">PTE</span>
                              </>
                            )}
                            {item.exam === 'IELTS' && (
                              <span class="text-xs sm:text-sm font-black text-[#D32F2F] tracking-wide uppercase font-sans">IELTS</span>
                            )}
                            {item.exam === 'JAPANESE' && (
                              <span class="text-xs sm:text-sm font-black text-[#BC002D] tracking-wide uppercase font-sans">JLPT</span>
                            )}
                          </div>

                          <div class="min-w-0">
                            <h3 class="font-display text-lg sm:text-xl font-bold text-white leading-tight">
                              {item.name}
                            </h3>
                            <p class="text-xs sm:text-[13px] text-blue-100 dark:text-slate-300 font-normal leading-tight mt-0.5">
                              {item.scaleLabel}
                            </p>
                          </div>
                        </div>

                        {/* Goal / Target Pill */}
                        <div class:list={['flex', isReverse ? 'justify-start md:justify-end' : 'justify-start']}>
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium bg-white/15 text-white border border-white/20 backdrop-blur-sm">
                            {item.targetLabel}
                          </span>
                        </div>
                      </div>

                      {/* Mobile Horizontal Sawtooth Divider */}
                      <div class="md:hidden w-full -mx-6 px-6 -mb-6 mt-2">
                        <svg class="w-full h-3 text-white dark:text-[#0f172a] fill-current" viewBox="0 0 100 8" preserveAspectRatio="none">
                          <polygon points="0,8 100,8 100,2 96,7 92,2 88,7 84,2 80,7 76,2 72,7 68,2 64,7 60,2 56,7 52,2 48,7 44,2 40,7 36,2 32,7 28,2 24,7 20,2 16,7 12,2 8,7 4,2 0,7" />
                        </svg>
                      </div>

                      {/* Action Buttons Row */}
                      <div
                        class:list={[
                          'flex items-center gap-4 pt-1',
                          isReverse ? 'justify-start md:justify-end' : 'justify-start',
                        ]}
                      >
                        {item.exam === 'JAPANESE' ? (
                          <button
                            type="button"
                            disabled
                            class="bg-white/20 hover:bg-white/30 text-white border border-white/30 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-xl cursor-not-allowed select-none transition-all"
                          >
                            Notify me
                          </button>
                        ) : (
                          <>
                            <button
                              type="button"
                              data-exam-select={item.exam}
                              class="bg-white text-[#1e4fe8] hover:bg-blue-50 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-xl shadow-xs transition-all select-none"
                            >
                              {isInitialActive ? 'Selected' : `Prepare for ${item.exam}`}
                            </button>

                            <a
                              href={appUrl('/diagnostic')}
                              class="text-white hover:text-blue-100 text-xs sm:text-sm font-semibold inline-flex items-center gap-1.5 transition-colors group"
                            >
                              <span>Free diagnostic</span>
                              <span class="transition-transform group-hover:translate-x-0.5">→</span>
                            </a>
                          </>
                        )}
                      </div>
                    </div>

                    {/* Content: Description & Practise Preview (Transparent on desktop so SVG white card background shows!) */}
                    <div
                      class:list={[
                        'p-6 sm:p-7 lg:p-8 flex flex-col justify-between gap-5',
                        // Mobile background uses white / dark card background; desktop is transparent
                        'bg-white dark:bg-[#0f172a] md:bg-transparent md:dark:bg-transparent',
                        isReverse
                          ? 'w-full md:w-[65%] lg:w-[66%] order-2 md:order-1 md:pr-24 lg:pr-28 xl:pr-32'
                          : 'w-full md:w-[65%] lg:w-[66%] order-2 md:order-2 md:pl-24 lg:pl-28 xl:pl-32',
                      ]}
                    >
                      {/* Top Header with Bullet Hole / Dot + Description (matching sketch) */}
                      <div class="space-y-1.5">
                        <div class="flex items-center gap-2.5">
                          <span class:list={['w-2.5 h-2.5 rounded-full shrink-0', item.dotColor]} />
                          <h4 class="font-display font-bold text-base sm:text-lg text-foreground tracking-tight">
                            {item.heading}
                          </h4>
                        </div>
                        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl pl-5">
                          {item.description}
                        </p>
                      </div>

                      {/* Rounded Inner Container Box for Bullet Points (matching sketch) */}
                      <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-900/60 p-4 sm:p-5 space-y-3 shadow-2xs">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block">
                          {item.trackLabel}
                        </span>

                        {/* Vertically Aligned Circular Bullet Points */}
                        <div class="flex flex-col gap-2 sm:gap-2.5">
                          {item.skills.map((skill) => (
                            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-200 font-medium min-w-0">
                              <span class:list={['w-2 h-2 rounded-full shrink-0 shadow-xs', item.dotColor]} />
                              <span class="whitespace-normal">{skill}</span>
                            </div>
                          ))}

                          <div class="flex items-center gap-2.5 text-xs text-slate-400 dark:text-slate-500 font-normal min-w-0 pt-0.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700 shrink-0 ml-0.5" />
                            <span>{item.moreTasks}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { getActiveExam, setActiveExam, onExamChange, type ExamType } from '@/scripts/exam-state';

  const section = document.querySelector<HTMLElement>('[data-exams]');
  if (section) {
    const cards = section.querySelectorAll<HTMLElement>('[data-exam-card]');
    const buttons = section.querySelectorAll<HTMLButtonElement>('[data-exam-select]');

    const ACTIVE_CARD_CLASSES = ['ring-2', 'ring-[#1e4fe8]', 'shadow-xl', 'shadow-blue-500/15'];
    const INACTIVE_CARD_CLASSES = ['shadow-sm', 'hover:shadow-md'];

    function paintActiveExam(active: ExamType) {
      cards.forEach((card) => {
        if (card.dataset.examCard === 'JAPANESE') return;
        const isActive = card.dataset.examCard === active;
        ACTIVE_CARD_CLASSES.forEach((cls) => card.classList.toggle(cls, isActive));
        INACTIVE_CARD_CLASSES.forEach((cls) => card.classList.toggle(cls, !isActive));
      });

      buttons.forEach((button) => {
        const exam = button.dataset.examSelect as ExamType;
        const isActive = exam === active;
        button.textContent = isActive ? 'Selected' : `Prepare for ${exam}`;
      });
    }

    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') || card.dataset.examCard === 'JAPANESE') return;
        setActiveExam(card.dataset.examCard as ExamType);
      });
    });

    buttons.forEach((button) => {
      button.addEventListener('click', (e) => {
        e.stopPropagation();
        setActiveExam(button.dataset.examSelect as ExamType);
      });
    });

    onExamChange(paintActiveExam);
    paintActiveExam(getActiveExam());
  }
</script>
