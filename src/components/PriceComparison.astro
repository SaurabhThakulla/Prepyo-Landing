---
import { Icon } from 'astro-icon/components';
import { appUrl } from '@/consts';
import { PRICE_ROWS, PRICES_CHECKED } from '@/data/price-comparison';

/**
 * How Prepyo's 7-day plan compares on price with the platforms Nepali
 * students usually weigh it against. Price and plan length only, each with
 * its source — see src/data/price-comparison.ts for why.
 */
const prepyoPrice = PRICE_ROWS.find(row => row.isPrepyo)!.price;

const checkedLabel = new Date(PRICES_CHECKED).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section class="py-16 sm:py-24 border-t border-border" aria-labelledby="price-comparison">
  {/* Same width, heading and row scale as the pricing table directly above it. */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-2 mb-12 sm:mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">Price comparison</span>
      <h2
        id="price-comparison"
        class="font-display text-3xl sm:text-4xl font-black text-foreground tracking-tight text-balance"
      >
        A week of PTE practice in Nepal, compared
      </h2>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto leading-relaxed">
        Each platform’s 7-day plan, or its nearest one, and what it costs.
      </p>
    </div>

    <div class="rounded-2xl border border-border bg-card overflow-hidden">
      {/* Header row, hidden on phones where each row stacks into a card. */}
      <div
        class="hidden sm:grid grid-cols-[1.4fr_1fr_1fr_2.2fr] gap-6 px-6 lg:px-8 py-5 bg-muted/60 border-b border-border text-xs font-bold uppercase tracking-wider text-muted-foreground"
        aria-hidden="true"
      >
        <span>Platform</span>
        <span>Plan compared</span>
        <span>Price</span>
        <span>Notes</span>
      </div>

      <ul role="list">
        {
          PRICE_ROWS.map(row => (
            <li
              class:list={[
                'grid grid-cols-2 sm:grid-cols-[1.4fr_1fr_1fr_2.2fr] gap-x-6 gap-y-2 px-5 sm:px-6 lg:px-8 py-5 sm:py-6 border-b border-border/70 last:border-b-0 items-center',
                row.isPrepyo && 'bg-primary/5 sm:border-l-4 sm:border-l-primary',
              ]}
            >
              <span class="col-span-2 sm:col-span-1 font-display font-bold text-base sm:text-lg text-foreground flex items-center gap-2 flex-wrap">
                {row.name}
                {row.isPrepyo && (
                  <span class="px-3 py-0.5 rounded-full bg-primary text-primary-foreground text-[10px] font-bold uppercase tracking-wider">
                    Lowest price
                  </span>
                )}
              </span>
              <span class="text-sm sm:text-base font-medium text-foreground/85">
                <span class="sm:hidden text-muted-foreground">Plan: </span>
                {row.plan}
              </span>
              <span
                class:list={[
                  'text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-right sm:text-left',
                  row.isPrepyo ? 'text-primary' : 'text-foreground',
                ]}
              >
                {row.price}
              </span>
              <span class="col-span-2 sm:col-span-1 text-xs sm:text-sm text-muted-foreground leading-relaxed">
                {row.note}
                {row.source && (
                  <>
                    {' '}
                    Source:{' '}
                    <a
                      href={row.source.href}
                      target="_blank"
                      rel="noopener nofollow"
                      class="text-primary hover:underline"
                    >
                      {row.source.label}
                    </a>
                  </>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-8 text-center text-xs text-muted-foreground leading-relaxed max-w-2xl mx-auto">
      Prices as listed on each website on <time datetime={PRICES_CHECKED}>{checkedLabel}</time>. Plans
      differ in what they include, and prices change, so check each provider before you buy. APEUni,
      Gurully and AlfaPTE are trademarks of their owners; Prepyo is not affiliated with them.
    </p>

    <div class="flex justify-center mt-8">
      <a
        href={appUrl('/')}
        class="inline-flex items-center gap-2 rounded-full bg-primary text-primary-foreground font-bold text-sm px-7 h-12 hover:brightness-110 shadow-lg shadow-primary/25 transition-all"
      >
        <span>Start free, upgrade for {prepyoPrice}</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>
