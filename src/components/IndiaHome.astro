---
import { Icon } from 'astro-icon/components';

/**
 * The UPSC CDS and NCC cards under the hero of the India page (/in/).
 */
const EXAMS = [
  {
    name: 'UPSC CDS',
    icon: 'lucide:shield',
    lead: 'Combined Defence Services: practice and full timed papers, marked the UPSC way.',
    points: ['English, General Knowledge and Elementary Maths', 'IMA · INA · AFA: three papers', 'OTA: English and GK', 'Negative marking, as on the day'],
  },
  {
    name: 'NCC',
    icon: 'lucide:award',
    lead: 'B and C certificate exam practice for cadets.',
    points: ['B certificate practice', 'C certificate practice', 'Instant marking with answers explained'],
  },
];
---

<section id="cds-ncc" class="mx-auto max-w-[72rem] scroll-mt-24 px-5 pb-16 sm:px-6">
  <div class="grid gap-4 md:grid-cols-2">
    {
      EXAMS.map(({ name, icon, lead, points }) => (
        <div class="rounded-3xl border border-border bg-card p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <Icon name={icon} class="h-5 w-5" />
            </span>
            <h2 class="font-display text-2xl font-bold text-foreground">{name}</h2>
          </div>
          <p class="mt-3 text-sm text-muted-foreground">{lead}</p>
          <ul class="mt-4 space-y-2 text-sm text-foreground">
            {points.map(point => (
              <li class="flex items-start gap-2">
                <Icon name="lucide:check-circle-2" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
