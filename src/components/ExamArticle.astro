---
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SocialProof from '@/components/SocialProof.astro';
import FAQSection from '@/components/FAQSection.astro';
import ProblemSection from '@/components/ProblemSection.astro';
import { appUrl, asset, homeSection } from '@/consts';
import type { ExamPage } from '@/data/exam-pages';

/**
 * High-converting, rich product landing page for PTE Academic & IELTS Academic.
 * Modeled after the modern "Lando" executive hero layout with bold typography,
 * geometric isometric device pedestal showcase, Details Chart radar, and rich drill explorer.
 */
interface Props {
  page: ExamPage;
}

const { page } = Astro.props;
const isPte = page.exam === 'PTE';
const targetScore = isPte ? '79+' : 'Band 8.0';
const examSubtitle = isPte
  ? 'Full-length computer mock exam simulations with instant 3s automated speech & writing scoring, acoustic analysis, and official Pearson rubric alignment.'
  : 'Full-length computer mock simulations with instant AI essay grading, acoustic speaking evaluation, and Cambridge band prediction.';

function getTaskMeta(name: string, isPte: boolean) {
  const n = name.toLowerCase();
  if (n.includes('speaking') || n.includes('read aloud') || n.includes('repeat') || n.includes('describe image') || n.includes('re-tell')) {
    return {
      category: 'speaking',
      label: 'Speaking',
      icon: 'lucide:mic',
      colorText: 'text-emerald-600 dark:text-emerald-400',
      colorBg: 'bg-emerald-500/10',
      colorBorder: 'group-hover:border-emerald-500/40',
      timing: n.includes('read aloud') ? '35–40s' : (n.includes('repeat') ? '15s' : '40s'),
      badge: isPte ? 'Acoustic Scoring' : 'Parts 1–3',
    };
  }
  if (n.includes('writing') || n.includes('essay') || n.includes('summarize written')) {
    return {
      category: 'writing',
      label: 'Writing',
      icon: 'lucide:file-edit',
      colorText: 'text-amber-600 dark:text-amber-400',
      colorBg: 'bg-amber-500/10',
      colorBorder: 'group-hover:border-amber-500/40',
      timing: n.includes('task 1') ? '20 mins' : (n.includes('essay') ? '20–40 mins' : '10 mins'),
      badge: isPte ? 'Rubric Scored' : 'Task 1 & 2',
    };
  }
  if (n.includes('reading') || n.includes('true') || n.includes('heading') || n.includes('re-order')) {
    return {
      category: 'reading',
      label: 'Reading',
      icon: 'lucide:book-open',
      colorText: 'text-sky-600 dark:text-sky-400',
      colorBg: 'bg-sky-500/10',
      colorBorder: 'group-hover:border-sky-500/40',
      timing: '2–3 mins',
      badge: 'Speed & Logic',
    };
  }
  return {
    category: 'listening',
    label: 'Listening',
    icon: 'lucide:headphones',
    colorText: 'text-purple-600 dark:text-purple-400',
    colorBg: 'bg-purple-500/10',
    colorBorder: 'group-hover:border-purple-500/40',
    timing: n.includes('dictation') ? '1 min' : '10 mins',
    badge: 'Audio Drill',
  };
}
---

<article class="w-full space-y-16 sm:space-y-24">
  {/* Top Breadcrumb Nav */}
  <div>
    <Breadcrumbs
      trail={[
        { name: 'Home', href: asset('/') },
        { name: 'Exams', href: homeSection('products') },
        { name: page.name },
      ]}
    />
  </div>

  {/* ========================================================================= */}
  {/* HERO SECTION (Lando Executive Reference)                                  */}
  {/* ========================================================================= */}
  <section class="relative w-full">
    {/* Soft Ambient Background Halos outside the card */}
    <div class="absolute -top-16 -left-16 w-80 h-80 bg-indigo-300/25 dark:bg-indigo-600/15 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -bottom-16 -right-16 w-80 h-80 bg-purple-300/25 dark:bg-purple-600/15 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

    {/* The Hero Card Canvas */}
    <div class="relative z-10 w-full rounded-3xl sm:rounded-[2.5rem] bg-card/90 dark:bg-card/80 shadow-2xl p-6 sm:p-10 lg:p-16 backdrop-blur-md overflow-hidden">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        {/* Left Column: Eyebrow, Heading, Description & Action Buttons */}
        <div class="lg:col-span-6 space-y-6">
          {/* Eyebrow */}
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest text-muted-foreground uppercase">
            <span class="w-3 h-0.5 bg-primary rounded-full"></span>
            <span>Free 30-Day Diagnostic Trial</span>
          </div>

          {/* Main Headline */}
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground leading-[1.08] text-balance">
            The best way<br />
            to ace your <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-primary via-[#5865F2] to-sky-500 bg-clip-text text-transparent">
              {isPte ? 'PTE 79+' : 'IELTS 8.0'}
            </span>.
          </h1>

          {/* Description */}
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed max-w-lg text-balance">
            {examSubtitle}
          </p>

          {/* Dual Action Buttons matching Lando reference */}
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
            <Button
              href={appUrl('/diagnostic')}
              size="lg"
              class="rounded-xl font-bold text-sm px-7 h-12 bg-primary text-primary-foreground hover:brightness-110 shadow-lg shadow-primary/25 transition-all justify-center"
            >
              <span>Try for free</span>
            </Button>

            <Button
              href="#blueprint"
              variant="outline"
              size="lg"
              class="rounded-xl font-bold text-sm px-7 h-12 border-border/80 bg-background/80 hover:bg-muted text-foreground transition-all justify-center"
            >
              <span>See how it works</span>
            </Button>
          </div>
        </div>

        {/* Right Column: Isometric 3D Geometric Podium Showcase (Clean, NO cartoon figures) */}
        <div class="lg:col-span-6 flex items-center justify-center relative py-6 lg:py-0">
          <div class="relative w-full max-w-[460px] aspect-[4/3] flex items-center justify-center select-none">
            
            {/* SVG Geometric Isometric Blocks Platform */}
            <svg
              viewBox="0 0 500 400"
              class="w-full h-full drop-shadow-2xl"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              {/* Soft Ground Shadow */}
              <ellipse cx="250" cy="340" rx="190" ry="40" fill="currentColor" class="text-black/10 dark:text-black/40 blur-xl" />

              {/* Block 1 (Left Charcoal Block) */}
              <g class="transition-transform duration-300 hover:-translate-y-1">
                <polygon points="110,210 170,175 230,210 170,245" fill="#334155" />
                <polygon points="110,210 170,245 170,295 110,260" fill="#1E293B" />
                <polygon points="170,245 230,210 230,260 170,295" fill="#0F172A" />
              </g>

              {/* Block 2 (Right Blue Block) */}
              <g class="transition-transform duration-300 hover:-translate-y-1">
                <polygon points="290,230 350,195 410,230 350,265" fill="#3B82F6" />
                <polygon points="290,230 350,265 350,315 290,280" fill="#2563EB" />
                <polygon points="350,265 410,230 410,280 350,315" fill="#1D4ED8" />
              </g>

              {/* Block 3 (Center Top Gold Podium) */}
              <g class="transition-transform duration-300 hover:-translate-y-1.5">
                <polygon points="200,140 280,95 360,140 280,185" fill="#FBBF24" />
                <polygon points="200,140 280,185 280,245 200,200" fill="#F59E0B" />
                <polygon points="280,185 360,140 360,200 280,245" fill="#D97706" />
              </g>

              {/* Isometric Toggle Widget */}
              <g transform="translate(135, 175)">
                <ellipse cx="30" cy="18" rx="20" ry="12" fill="#2563EB" />
                <ellipse cx="22" cy="14" rx="10" ry="8" fill="#60A5FA" />
                <circle cx="22" cy="14" r="5" fill="#EFF6FF" />
              </g>

              {/* Isometric Speech Bubble Indicator */}
              <g transform="translate(305, 80)" class="animate-bounce" style="animation-duration: 3s">
                <rect x="0" y="0" width="36" height="26" rx="8" fill="#F59E0B" />
                <polygon points="8,26 16,26 10,32" fill="#F59E0B" />
                <circle cx="10" cy="13" r="2.5" fill="#FFFBEB" />
                <circle cx="18" cy="13" r="2.5" fill="#FFFBEB" />
                <circle cx="26" cy="13" r="2.5" fill="#FFFBEB" />
              </g>
            </svg>

            {/* Simulated Smartphone on the Podium */}
            <div
              class="absolute left-[45%] top-[24%] -translate-x-1/2 -translate-y-1/2 w-48 sm:w-56 rounded-2xl bg-slate-950 p-2.5 shadow-2xl border border-slate-700/80 text-white transform -rotate-[16deg] skew-x-6 hover:scale-105 transition-all duration-300"
              style="box-shadow: 0 25px 40px -15px rgba(0,0,0,0.6);"
            >
              <div class="w-10 h-1 bg-slate-800 rounded-full mx-auto mb-2"></div>
              
              <div class="rounded-xl bg-slate-900 border border-slate-800 p-2.5 space-y-2 text-left">
                <div class="flex items-center justify-between text-[9px] text-slate-400">
                  <span class="font-bold text-white flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Prepyo AI
                  </span>
                  <span class="font-mono text-amber-400 font-bold">{isPte ? 'PTE 79+' : 'Band 8.0'}</span>
                </div>

                <div class="p-2 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-between">
                  <div>
                    <div class="text-[8px] uppercase tracking-wider text-slate-400">Predicted Score</div>
                    <div class="text-lg font-black text-emerald-400 leading-tight">
                      {isPte ? '86 / 90' : '8.5 / 9.0'}
                    </div>
                  </div>
                  <div class="text-[8px] text-right space-y-0.5 text-slate-300">
                    <div>{isPte ? 'Fluency: 88' : 'Task: 8.5'}</div>
                    <div class="text-emerald-400 font-semibold">{isPte ? 'Pronunciation: 90' : 'Lexical: 8.5'}</div>
                  </div>
                </div>

                <div class="h-5 rounded bg-slate-950 flex items-center justify-center gap-0.5 px-2">
                  <span class="w-0.5 h-2 bg-emerald-400 rounded-full"></span>
                  <span class="w-0.5 h-3.5 bg-emerald-400 rounded-full"></span>
                  <span class="w-0.5 h-2.5 bg-primary rounded-full"></span>
                  <span class="w-0.5 h-4 bg-emerald-400 rounded-full"></span>
                  <span class="w-0.5 h-3 bg-amber-400 rounded-full"></span>
                  <span class="w-0.5 h-1.5 bg-emerald-400 rounded-full"></span>
                </div>

                <div class="text-[8px] text-center text-slate-400 font-medium">
                  Instant 3s Automated Evaluation
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      {/* Bottom Trust Strip */}
      <div class="mt-12 sm:mt-16 pt-8 sm:pt-10 border-t border-border/60 text-center">
        <p class="text-[11px] sm:text-xs font-semibold text-muted-foreground uppercase tracking-widest mb-6">
          Trusted by test-takers preparing from Kathmandu, Pokhara, Chitwan and across Nepal
        </p>

        <div class="flex items-center justify-center gap-6 sm:gap-12 flex-wrap text-xs sm:text-sm font-bold text-muted-foreground/80">
          <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
            <Icon name="lucide:check-circle" class="w-4 h-4 text-primary" />
            <span>Pearson PTE Aligned</span>
          </span>
          <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
            <Icon name="lucide:check-circle" class="w-4 h-4 text-primary" />
            <span>Cambridge IELTS Criteria</span>
          </span>
          <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
            <Icon name="lucide:zap" class="w-4 h-4 text-amber-500" />
            <span>3-Second AI Scoring</span>
          </span>
          <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
            <Icon name="lucide:wallet" class="w-4 h-4 text-emerald-500" />
            <span>eSewa &amp; Khalti Accepted</span>
          </span>
          <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
            <Icon name="lucide:award" class="w-4 h-4 text-purple-500" />
            <span>15,000+ Mocks Taken</span>
          </span>
        </div>
      </div>

    </div>
  </section>

  {/* ========================================================================= */}
  {/* AT A GLANCE BLUEPRINT                                                     */}
  {/* ========================================================================= */}
  <section id="blueprint" class="space-y-6 scroll-mt-24">
    <div class="max-w-2xl">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">
        Test Specifications
      </span>
      <h2 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-foreground mt-1">
        {page.name} at a glance
      </h2>
      <p class="text-sm text-muted-foreground mt-2">
        Official test parameters, delivery formats, and performance benchmarks for 2026.
      </p>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        page.format.map(({ label, value }, idx) => {
          const icons = [
            'lucide:monitor',
            'lucide:layers',
            'lucide:clock',
            'lucide:award',
            'lucide:zap',
            'lucide:target',
          ];
          const iconName = icons[idx % icons.length];

          return (
            <div class="group rounded-2xl border border-border bg-card p-5 sm:p-6 hover:border-primary/40 hover:shadow-md transition-all">
              <div class="flex items-center justify-between">
                <dt class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground group-hover:text-primary transition-colors">
                  {label}
                </dt>
                <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                  <Icon name={iconName} class="w-4 h-4" />
                </div>
              </div>
              <dd class="text-base font-bold text-foreground mt-3 leading-snug">
                {value}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </section>

  {/* ========================================================================= */}
  {/* DETAILS CHART (RADAR GRAPH CUSTOMIZED FOR THIS EXAM)                     */}
  {/* ========================================================================= */}
  <ProblemSection mode={isPte ? 'pte' : 'ielts'} />

  {/* ========================================================================= */}
  {/* MASTER EVERY SINGLE TASK TYPE (ELEVATED & CATEGORIZED EXPLORER)           */}
  {/* ========================================================================= */}
  <section class="space-y-8" data-task-explorer>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="max-w-2xl space-y-1">
        <span class="text-xs font-bold uppercase tracking-wider text-primary">
          Curriculum &amp; Drills
        </span>
        <h2 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-foreground">
          Master every single task type
        </h2>
        <p class="text-sm text-muted-foreground">
          Each item is an isolated drill with the exact interface, audio player, timer, and AI evaluation used in the real test.
        </p>
      </div>

      {/* Filter Tabs for Skills */}
      <div class="flex items-center gap-1.5 p-1 rounded-xl bg-muted/80 border border-border text-xs font-semibold overflow-x-auto self-start md:self-auto shrink-0">
        <button
          type="button"
          class="px-3.5 py-1.5 rounded-lg transition-all bg-background text-foreground shadow-sm"
          data-filter-tab="all"
        >
          All Tasks
        </button>
        <button
          type="button"
          class="px-3.5 py-1.5 rounded-lg transition-all text-muted-foreground hover:text-foreground"
          data-filter-tab="speaking"
        >
          Speaking
        </button>
        <button
          type="button"
          class="px-3.5 py-1.5 rounded-lg transition-all text-muted-foreground hover:text-foreground"
          data-filter-tab="writing"
        >
          Writing
        </button>
        <button
          type="button"
          class="px-3.5 py-1.5 rounded-lg transition-all text-muted-foreground hover:text-foreground"
          data-filter-tab="reading"
        >
          Reading
        </button>
        <button
          type="button"
          class="px-3.5 py-1.5 rounded-lg transition-all text-muted-foreground hover:text-foreground"
          data-filter-tab="listening"
        >
          Listening
        </button>
      </div>
    </div>

    {/* Task Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        page.taskTypes.map((task) => {
          const meta = getTaskMeta(task.name, isPte);

          return (
            <div
              class:list={[
                "rounded-2xl border border-border bg-card p-6 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group relative overflow-hidden",
                meta.colorBorder,
              ]}
              data-task-card
              data-task-cat={meta.category}
            >
              {/* Subtle top indicator border */}
              <div class="absolute top-0 inset-x-0 h-1 bg-border group-hover:bg-primary transition-colors"></div>

              <div class="space-y-4">
                {/* Header: Skill Icon badge + Timing badge */}
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class={`w-8 h-8 rounded-lg ${meta.colorBg} ${meta.colorText} flex items-center justify-center shrink-0`}>
                      <Icon name={meta.icon} class="w-4 h-4" />
                    </div>
                    <span class={`text-[11px] font-bold uppercase tracking-wider ${meta.colorText}`}>
                      {meta.label}
                    </span>
                  </div>

                  <span class="px-2.5 py-1 rounded-full bg-muted border border-border/80 text-[10px] font-mono font-semibold text-muted-foreground">
                    {meta.timing}
                  </span>
                </div>

                {/* Task Title & Description */}
                <div>
                  <h3 class="font-display font-bold text-base sm:text-lg text-foreground group-hover:text-primary transition-colors">
                    {task.name}
                  </h3>
                  <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed mt-2">
                    {task.blurb}
                  </p>
                </div>
              </div>

              {/* Footer: Diagnostic CTA */}
              <div class="pt-5 mt-4 border-t border-border/60 flex items-center justify-between">
                <span class="text-[11px] font-semibold text-muted-foreground">
                  {meta.badge}
                </span>

                <a
                  href={appUrl('/diagnostic')}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-primary group-hover:underline"
                >
                  <span>Practice drill</span>
                  <Icon name="lucide:arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  {/* ========================================================================= */}
  {/* WHAT YOU GET ON PREPYO (FEATURES GRID)                                    */}
  {/* ========================================================================= */}
  <section class="space-y-6">
    <div class="max-w-2xl">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">
        Complete Preparation Suite
      </span>
      <h2 class="font-display text-2xl sm:text-4xl font-bold tracking-tight text-foreground mt-1">
        Built for serious test-takers
      </h2>
      <p class="text-sm text-muted-foreground mt-2">
        Everything you need to eliminate weak spots and guarantee your target score.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {
        page.prepBlocks.map((block) => (
          <div class="rounded-2xl border border-border bg-card p-6 flex items-start gap-4 hover:border-primary/40 hover:shadow-md transition-all">
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
              <Icon name={block.icon} class="w-6 h-6" />
            </div>
            <div class="space-y-1.5">
              <h3 class="font-display font-bold text-base text-foreground">
                {block.title}
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                {block.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* Scoring Methodology Breakdown & Social Proof */}
  <section class="rounded-3xl border border-border bg-card p-6 sm:p-10 space-y-6">
    <div class="max-w-3xl space-y-2">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">
        Scoring Science
      </span>
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        How {page.name} is scored
      </h2>
      <div class="space-y-4 pt-2">
        {page.scoring.map((paragraph) => (
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            {paragraph}
          </p>
        ))}
      </div>
    </div>

    <div class="pt-4 border-t border-border/60">
      <SocialProof methodologyHref={asset('/how-scoring-works/')} />
    </div>
  </section>

  {/* FAQ Section */}
  <FAQSection faqs={page.faqs} title={`${page.name} Frequently Asked Questions`} />

  {/* Cross-Exam Switcher Banner */}
  <section class="rounded-2xl border border-border bg-card p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
        <Icon name="lucide:arrow-left-right" class="w-6 h-6" />
      </div>
      <div>
        <h3 class="font-display font-bold text-base text-foreground">
          {page.sibling.label}
        </h3>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-xl">
          {page.sibling.blurb}
        </p>
      </div>
    </div>

    <Button
      href={asset(page.sibling.href)}
      variant="outline"
      class="rounded-full font-bold text-xs px-6 h-10 shrink-0 self-end sm:self-center"
    >
      <span>Switch to {isPte ? 'IELTS' : 'PTE'}</span>
    </Button>
  </section>
</article>

<script>
  function setupTaskExplorer() {
    const explorer = document.querySelector('[data-task-explorer]');
    if (!explorer) return;

    const tabs = explorer.querySelectorAll('[data-filter-tab]');
    const cards = explorer.querySelectorAll('[data-task-card]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-filter-tab');

        // Tab styling
        tabs.forEach((t) => {
          t.classList.remove('bg-background', 'text-foreground', 'shadow-sm');
          t.classList.add('text-muted-foreground');
        });
        tab.classList.add('bg-background', 'text-foreground', 'shadow-sm');
        tab.classList.remove('text-muted-foreground');

        // Filter cards
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-task-cat');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupTaskExplorer();
  document.addEventListener('astro:page-load', setupTaskExplorer);
