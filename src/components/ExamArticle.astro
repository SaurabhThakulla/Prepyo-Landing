---
import { Icon } from 'astro-icon/components';
import Button from '@/components/Button.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQSection from '@/components/FAQSection.astro';
import SubscriptionSection from '@/components/SubscriptionSection.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { EXACT_PLANS } from '@/data/pricing';
import ProblemSection from '@/components/ProblemSection.astro';
import { asset } from '@/consts';
import type { ExamPage, Skill, TaskType } from '@/data/exam-pages';

/**
 * The shared layout for each exam's own page (PTE, IELTS, EPS-TOPIK, JLPT).
 *
 * The H1 comes straight from the page data and carries the exam's name, which
 * is what a search engine reads as the page's topic; the FAQ holds the plain
 * "What is …?" answer that answer engines quote.
 */
interface Props {
  page: ExamPage;
}

const { page } = Astro.props;
const isPte = page.exam === 'PTE';
const isEps = page.exam === 'EPS_TOPIK';
const isJlpt = page.exam === 'JAPANESE';
// EPS-TOPIK and JLPT: multiple choice only, no full mock, and their own cheaper Premium.
const isAsia = isEps || isJlpt;

// The exam's name is the highlighted half of the H1.
const h1Rest = page.h1.startsWith(page.name) ? page.h1.slice(page.name.length) : null;

const heroNote = isEps
  ? 'Practice questions and the Learn Korean course are free.'
  : isJlpt
    ? 'Start free with practice questions every day.'
    : 'Your first full mock test is free.';
const fromPrice = EXACT_PLANS.find(plan => plan.id === (isAsia ? 'elite_asia' : 'elite'))!.priceNPR;
// The dashboard as a learner of this exam sees it; the default capture is IELTS.
const shot = isPte ? 'hero-dashboard-pte' : isEps ? 'hero-dashboard-eps' : isJlpt ? 'hero-dashboard-jlpt' : 'hero-dashboard';
const shotAlt = `The Prepyo dashboard for ${page.name} on a laptop: questions practised in each skill and the active plan.`;

const SKILL_TABS: { id: Skill; label: string }[] = [
  { id: 'speaking', label: 'Speaking' },
  { id: 'writing', label: 'Writing' },
  { id: 'reading', label: 'Reading' },
  { id: 'listening', label: 'Listening' },
];

// Each task card's skill colour: the dot by its label and the faint glow in its corner.
const SKILL_TONE: Record<string, { dot: string; glow: string }> = {
  speaking: { dot: 'bg-emerald-500', glow: 'bg-emerald-500/15' },
  writing: { dot: 'bg-amber-500', glow: 'bg-amber-500/15' },
  reading: { dot: 'bg-sky-500', glow: 'bg-sky-500/15' },
  listening: { dot: 'bg-purple-500', glow: 'bg-purple-500/15' },
};

// An icon for each at-a-glance fact, picked by what its label is about.
function formatIcon(label: string) {
  const l = label.toLowerCase();
  const pairs: [string, string][] = [
    ['full name', 'lucide:id-card'], ['run by', 'lucide:landmark'], ['used for', 'lucide:briefcase'],
    ['delivery', 'lucide:monitor'], ['structure', 'lucide:layers'], ['levels', 'lucide:layers'],
    ['sections', 'lucide:layout-list'], ['questions', 'lucide:list-checks'], ['length', 'lucide:clock'],
    ['listening', 'lucide:headphones'], ['reading', 'lucide:book-open'], ['writing', 'lucide:pen-line'],
    ['speaking', 'lucide:mic'], ['result', 'lucide:zap'], ['target', 'lucide:target'],
    ['pass', 'lucide:circle-check'], ['selection', 'lucide:trophy'], ['score', 'lucide:award'],
  ];
  return pairs.find(([key]) => l.includes(key))?.[1] ?? 'lucide:info';
}

function getTaskMeta(task: TaskType) {
  const meta = guessTaskMeta(task.name, task.skill);
  // EPS-TOPIK and JLPT are all four-option multiple choice, and the per-task
  // timings above are PTE and IELTS figures.
  if (isAsia) return { ...meta, timing: '', badge: 'Multiple choice' };
  return task.timing === undefined ? meta : { ...meta, timing: task.timing };
}

function guessTaskMeta(name: string, skill?: Skill) {
  const n = name.toLowerCase();
  if (skill === 'speaking' || (!skill && (n.includes('speaking') || n.includes('read aloud') || n.includes('repeat') || n.includes('describe image') || n.includes('re-tell')))) {
    return {
      category: 'speaking',
      label: 'Speaking',
      icon: 'lucide:mic',
      colorText: 'text-emerald-600 dark:text-emerald-400',
      colorBg: 'bg-emerald-500/10',
      colorBorder: 'group-hover:border-emerald-500/40',
      timing: n.includes('read aloud') ? '35–40s' : (n.includes('repeat') ? '15s' : '40s'),
      badge: isPte ? 'Acoustic Scoring' : 'Parts 1–3',
    };
  }
  if (skill === 'writing' || (!skill && (n.includes('writing') || n.includes('essay') || n.includes('summarize written')))) {
    return {
      category: 'writing',
      label: 'Writing',
      icon: 'lucide:file-edit',
      colorText: 'text-amber-600 dark:text-amber-400',
      colorBg: 'bg-amber-500/10',
      colorBorder: 'group-hover:border-amber-500/40',
      timing: n.includes('task 1') ? '20 mins' : (n.includes('essay') ? '20–40 mins' : '10 mins'),
      badge: isPte ? 'Rubric Scored' : 'Task 1 & 2',
    };
  }
  if (skill === 'reading' || (!skill && (n.includes('reading') || n.includes('true') || n.includes('heading') || n.includes('re-order')))) {
    return {
      category: 'reading',
      label: 'Reading',
      icon: 'lucide:book-open',
      colorText: 'text-sky-600 dark:text-sky-400',
      colorBg: 'bg-sky-500/10',
      colorBorder: 'group-hover:border-sky-500/40',
      timing: '2–3 mins',
      badge: 'Speed & Logic',
    };
  }
  return {
    category: 'listening',
    label: 'Listening',
    icon: 'lucide:headphones',
    colorText: 'text-purple-600 dark:text-purple-400',
    colorBg: 'bg-purple-500/10',
    colorBorder: 'group-hover:border-purple-500/40',
    timing: n.includes('dictation') ? '1 min' : '10 mins',
    badge: 'Audio Drill',
  };
}
---

<Hero lead={page.standfirst} primaryCta={page.primaryCta} secondaryCta={{ href: '#blueprint', label: 'See how it works' }} note={heroNote} fromPrice={fromPrice} shot={shot} shotAlt={shotAlt}>
  {h1Rest !== null ? <><span class="text-primary">{page.name}</span>{h1Rest}</> : page.h1}
</Hero>

<div class="w-full lg:max-w-[80vw] 2xl:max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
<article class="mx-auto w-full max-w-6xl">
  {/* Breadcrumb and the four promises, as one strip under the hero. */}
  <div class="space-y-5 pt-2">
    <Breadcrumbs
      trail={[
        { name: 'Home', href: asset('/') },
        { name: page.name },
      ]}
    />
    <ul class="grid grid-cols-2 lg:grid-cols-4 rounded-2xl border border-border bg-card">
      {
        page.trust.map(({ icon, label }, i) => (
          <li class:list={[
            'flex items-center gap-3 p-4 sm:p-5 border-border',
            i % 2 === 1 && 'border-l',
            i >= 2 && 'border-t lg:border-t-0',
            i === 2 && 'lg:border-l',
          ]}>
            <span class="w-9 h-9 shrink-0 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <Icon name={icon} class="w-4 h-4" />
            </span>
            <span class="text-xs sm:text-sm font-semibold text-foreground leading-snug">{label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {/* At a glance: one spec sheet, each fact with an icon for what it is. */}
  <section id="blueprint" class="py-16 sm:py-24 scroll-mt-24">
    <SectionHeading
      eyebrow="Test format"
      eyebrowIcon="lucide:clipboard-list"
      title={`${page.name} at a glance`}
      description={`The test format as published by ${page.testOwner}.`}
    />
    <div class="rounded-3xl border border-border bg-gradient-to-b from-primary/[0.06] to-transparent p-2 sm:p-3">
      <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3">
        {
          page.format.map(({ label, value }, i) => {
            // The last fact stretches over whatever its row has left, so the sheet never ends on a hole.
            const last = i === page.format.length - 1;
            const n = page.format.length;
            return (
              <div class:list={[
                'flex items-start gap-4 rounded-2xl border border-border bg-card p-5 shadow-sm',
                last && n % 2 === 1 && 'sm:col-span-2',
                last && (n % 3 === 0 ? 'lg:col-span-1' : n % 3 === 1 ? 'lg:col-span-3' : 'lg:col-span-2'),
              ]}>
                <span class="w-10 h-10 shrink-0 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                  <Icon name={formatIcon(label)} class="w-5 h-5" />
                </span>
                <div>
                  <dt class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground">{label}</dt>
                  <dd class="mt-1 text-sm sm:text-base font-semibold text-foreground leading-snug">{value}</dd>
                </div>
              </div>
            );
          })
        }
      </dl>
    </div>
  </section>

  {page.chartMode && <ProblemSection mode={page.chartMode} />}

  {/* Every task type, filterable by skill. */}
  <section class="py-16 sm:py-24" data-task-explorer>
    <SectionHeading
      eyebrow="Task types"
      eyebrowIcon="lucide:list-checks"
      title={`Practise all ${page.taskTypes.length} task types`}
      description="Each task type is practised on its own, in the format the real test uses, with feedback the moment you answer."
    />

    {/* Only the skills this exam actually tests — EPS-TOPIK and JLPT have no speaking or writing. */}
    <div class="flex justify-center mb-10">
      <div class="inline-flex items-center gap-1 p-1 rounded-full bg-muted/80 border border-border text-xs sm:text-sm font-semibold overflow-x-auto max-w-full">
        <button type="button" class="px-4 py-1.5 rounded-full transition-all bg-background text-foreground shadow-sm" data-filter-tab="all">
          All <span class="ml-1 text-muted-foreground/70">{page.taskTypes.length}</span>
        </button>
        {
          SKILL_TABS.map(tab => ({ ...tab, count: page.taskTypes.filter(task => getTaskMeta(task).category === tab.id).length }))
            .filter(tab => tab.count > 0)
            .map(tab => (
              <button type="button" class="px-4 py-1.5 rounded-full transition-all text-muted-foreground hover:text-foreground" data-filter-tab={tab.id}>
                {tab.label} <span class="ml-1 opacity-60">{tab.count}</span>
              </button>
            ))
        }
      </div>
    </div>

    {/* A carousel that moves left to right. The cards are rendered twice so the
        track can loop seamlessly; the second copy is hidden from screen readers. */}
    <div class="task-marquee -mx-4 sm:mx-0" data-marquee tabindex="0" aria-label="Task types">
      <div class="task-track flex w-max py-3" data-track>
        {
          [0, 1].map((copy) =>
            page.taskTypes.map((task, index) => {
              const meta = getTaskMeta(task);
              const tone = SKILL_TONE[meta.category];
              const total = String(page.taskTypes.length).padStart(2, '0');
              return (
                <div
                  class="shrink-0 pr-4 sm:pr-5 w-[17rem] sm:w-[21rem]"
                  style="display:flex"
                  data-task-card
                  data-task-cat={meta.category}
                  data-copy={copy}
                  aria-hidden={copy === 1 ? 'true' : undefined}
                >
                  <article class:list={['group relative w-full overflow-hidden rounded-[1.25rem] border border-border/80 bg-card p-6 flex flex-col transition-colors duration-300', meta.colorBorder]}>
                    {/* A faint wash of the skill's colour in the corner, brighter on hover. */}
                    <span class:list={['pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full blur-2xl opacity-60 transition-opacity duration-300 group-hover:opacity-100', tone.glow]} aria-hidden="true"></span>

                    <div class="relative flex items-center justify-between text-xs">
                      <span class="font-mono tabular-nums text-muted-foreground/70">
                        <span class="text-foreground font-semibold">{String(index + 1).padStart(2, '0')}</span> / {total}
                      </span>
                      <span class="inline-flex items-center gap-1.5 font-medium text-muted-foreground">
                        <span class:list={['h-1.5 w-1.5 rounded-full', tone.dot]} aria-hidden="true"></span>
                        {meta.label}
                      </span>
                    </div>

                    <h3 class="relative mt-8 font-display text-lg sm:text-xl font-bold leading-snug tracking-tight text-foreground text-balance">{task.name}</h3>
                    <p class="relative mt-2 text-sm text-muted-foreground leading-relaxed">{task.blurb}</p>

                    {meta.timing && (
                      <div class="relative mt-auto pt-6">
                        <div class="flex items-center gap-2 border-t border-border/70 pt-4 text-xs text-muted-foreground">
                          <Icon name="lucide:timer" class="w-3.5 h-3.5" />
                          <span>{meta.timing}</span>
                        </div>
                      </div>
                    )}
                  </article>
                </div>
              );
            })
          )
        }
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <Button href={page.primaryCta.href} size="lg" class="rounded-full font-bold text-sm px-7 h-12 shadow-lg shadow-primary/25">
        <span>{page.primaryCta.label}</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </Button>
    </div>
  </section>

  {/* What Prepyo adds on top of the practice, on a tinted band. */}
  <section class="pb-16 sm:pb-24">
    <div class="relative overflow-hidden rounded-3xl border border-primary/15 bg-gradient-to-br from-sky-500/[0.06] via-card to-primary/[0.08] px-5 py-12 sm:px-10 sm:py-16">
      <div class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative">
        <SectionHeading
          eyebrow="What you get"
          eyebrowIcon="lucide:sparkles"
          title="Built to find your weak spots"
          description="Everything you need to see where the marks are going, and spend your time there."
        />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            page.prepBlocks.map((block, i) => (
              <div class="group rounded-2xl border border-border bg-card/90 p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
                <div class="flex items-center justify-between">
                  <span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-sky-500 text-white flex items-center justify-center shadow-md shadow-primary/25">
                    <Icon name={block.icon} class="w-6 h-6" />
                  </span>
                  <span class="font-display text-2xl font-black text-primary/15 group-hover:text-primary/30 transition-colors">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </div>
                <h3 class="mt-5 font-display font-bold text-base text-foreground">{block.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{block.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

</article>
</div>

<SubscriptionSection />

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
  <FAQSection faqs={page.faqs} title={`${page.name} Frequently Asked Questions`} />
</div>

<style>
  /* Task cards drift from left to right. The track holds two identical
     copies, so sliding it from -50% to 0 loops without a visible seam. */
  .task-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .task-marquee:focus-visible {
    outline: 3px solid hsl(var(--ring));
    outline-offset: 4px;
    border-radius: 1rem;
  }

  .task-track {
    animation: task-marquee var(--marquee-duration, 60s) linear infinite;
  }

  /* Hold still while someone reads or tabs through a card. */
  .task-marquee:hover .task-track,
  .task-marquee:focus-within .task-track {
    animation-play-state: paused;
  }

  @keyframes task-marquee {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Too few cards to fill the row (one skill picked): no loop, just centred. */
  .task-marquee.is-static {
    -webkit-mask-image: none;
    mask-image: none;
  }

  .task-marquee.is-static .task-track {
    animation: none;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* No motion wanted: the script marks the row static, and this stops it even before the script runs. */
  @media (prefers-reduced-motion: reduce) {
    .task-track {
      animation: none;
    }
  }
</style>

<script>
  function setupTaskExplorer() {
    const explorer = document.querySelector('[data-task-explorer]');
    if (!explorer) return;

    const tabs = explorer.querySelectorAll('[data-filter-tab]');
    const cards = explorer.querySelectorAll('[data-task-card]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-filter-tab');

        // Tab styling
        tabs.forEach((t) => {
          t.classList.remove('bg-background', 'text-foreground', 'shadow-sm');
          t.classList.add('text-muted-foreground');
        });
        tab.classList.add('bg-background', 'text-foreground', 'shadow-sm');
        tab.classList.remove('text-muted-foreground');

        // Filter cards
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-task-cat');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
        fitMarquee(explorer);
      });
    });

    fitMarquee(explorer);
    window.addEventListener('resize', () => fitMarquee(explorer));
  }

  // The loop needs one copy of the visible cards to be at least as wide as the
  // row; with fewer (one skill picked) it stops and centres them instead.
  // Speed is per card, so a long row does not race and a short one crawl.
  function fitMarquee(explorer: Element) {
    const marquee = explorer.querySelector<HTMLElement>('[data-marquee]');
    const track = explorer.querySelector<HTMLElement>('[data-track]');
    if (!marquee || !track) return;

    const firsts = [...track.querySelectorAll<HTMLElement>('[data-copy="0"]')].filter((card) => card.style.display !== 'none');
    const seconds = [...track.querySelectorAll<HTMLElement>('[data-copy="1"]')];
    const oneCopy = firsts.reduce((width, card) => width + card.offsetWidth, 0);
    // With motion reduced the cards sit still, wrapped and centred.
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const loops = !still && oneCopy > marquee.clientWidth;

    const shownCats = new Set(firsts.map((card) => card.dataset.taskCat));
    marquee.classList.toggle('is-static', !loops);
    seconds.forEach((card) => {
      card.style.display = loops && shownCats.has(card.dataset.taskCat) ? 'flex' : 'none';
    });
    track.style.setProperty('--marquee-duration', `${Math.max(20, firsts.length * 6)}s`);
  }

  setupTaskExplorer();
  document.addEventListener('astro:page-load', setupTaskExplorer);
</script>
