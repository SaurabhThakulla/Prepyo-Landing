---
import { Icon } from 'astro-icon/components';

/**
 * The visible half of the BreadcrumbList markup on every sub-page.
 *
 * Google will show breadcrumbs in the result snippet, but only when the trail
 * is on the page as well as in the structured data — so the two are built from
 * the same array by the page that renders them.
 */
interface Props {
  trail: { name: string; href?: string }[];
}

const { trail } = Astro.props;
---

<nav aria-label="Breadcrumb" class="pt-2">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
    {
      trail.map((crumb, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && (
            <Icon name="lucide:chevron-right" class="w-3 h-3 shrink-0 opacity-60" aria-hidden="true" />
          )}
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-foreground transition-colors">
              {crumb.name}
            </a>
          ) : (
            <span class="text-foreground font-medium" aria-current="page">
              {crumb.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
