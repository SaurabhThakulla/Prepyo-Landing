<script>
  // Infinite Loop Carousel Interactive Script with Centered Multi-Card Peek Slider
  const section = document.querySelector<HTMLElement>('[data-features-showcase]');
  if (section) {
    const viewport = section.querySelector<HTMLElement>('[data-carousel-viewport]')!;
    const track = section.querySelector<HTMLElement>('[data-carousel-track]')!;
    const tabsScroller = section.querySelector<HTMLElement>('[data-feature-tabs-scroller]');
    const slides = Array.from(section.querySelectorAll<HTMLElement>('[data-track-index]'));
    const tabButtons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-tab-index]'));
    const dotButtons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-dot-index]'));

    const PRE_CLONES = 2;
    const REAL_SLIDE_COUNT = 6;
    let activeLogicalIndex = 0; // 0 to 5
    let currentTrackIndex = activeLogicalIndex + PRE_CLONES; // 2 to 7
    let isPlaying = true;
    let isTransitioning = false;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    let wrapTimer: ReturnType<typeof setTimeout> | null = null;
    const AUTOPLAY_INTERVAL = 6000;

    const TAB_ACTIVE_CLASSES = ['bg-foreground', 'text-background', 'border-foreground', 'shadow-md'];
    const TAB_INACTIVE_CLASSES = ['bg-card/90', 'text-muted-foreground', 'border-border/80', 'hover:text-foreground', 'hover:bg-card', 'hover:border-border'];

    function updateCarouselPosition(animate = true) {
      if (!viewport || !track || slides.length === 0) return;
      const activeSlide = slides[currentTrackIndex];
      if (!activeSlide) return;

      const viewportWidth = viewport.clientWidth;
      const slideWidth = activeSlide.offsetWidth;
      const slideOffsetLeft = activeSlide.offsetLeft;

      // Exact mathematical center: center activeSlide inside viewport
      const targetOffset = ((viewportWidth - slideWidth) / 2) - slideOffsetLeft;
      
      if (!animate) {
        track.style.transition = 'none';
      } else {
        track.style.transition = 'transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1)';
      }
      
      track.style.transform = `translateX(${targetOffset}px)`;

      // Update inner card visual active states (separated from layout)
      slides.forEach((slide, i) => {
        const isActive = i === currentTrackIndex;
        const innerCard = slide.querySelector<HTMLElement>('[data-card-inner]');
        if (innerCard) {
          innerCard.classList.toggle('opacity-100', isActive);
          innerCard.classList.toggle('scale-100', isActive);
          innerCard.classList.toggle('shadow-2xl', isActive);
          innerCard.classList.toggle('opacity-25', !isActive);
          innerCard.classList.toggle('scale-[0.96]', !isActive);
          innerCard.classList.toggle('hover:opacity-60', !isActive);
          innerCard.classList.toggle('cursor-pointer', !isActive);
        }
      });

      // Update Tabs styling
      tabButtons.forEach((btn, i) => {
        const isActive = i === activeLogicalIndex;
        TAB_ACTIVE_CLASSES.forEach(cls => btn.classList.toggle(cls, isActive));
        TAB_INACTIVE_CLASSES.forEach(cls => btn.classList.toggle(cls, !isActive));

        if (isActive) centerActiveTab(btn);
      });

      // Update Dots styling
      dotButtons.forEach((dot, i) => {
        const isActive = i === activeLogicalIndex;
        dot.classList.toggle('w-8', isActive);
        dot.classList.toggle('bg-primary', isActive);
        dot.classList.toggle('w-2', !isActive);
        dot.classList.toggle('bg-muted-foreground/30', !isActive);
      });
    }

    // Scroll the pill strip only. `scrollIntoView` would also scroll every scrollable
    // ancestor — including this overflow-hidden section — shunting the whole section sideways.
    function centerActiveTab(btn: HTMLButtonElement) {
      if (!tabsScroller) return;
      if (tabsScroller.scrollWidth <= tabsScroller.clientWidth) return;

      const btnRect = btn.getBoundingClientRect();
      const stripRect = tabsScroller.getBoundingClientRect();
      const delta = (btnRect.left + btnRect.width / 2) - (stripRect.left + stripRect.width / 2);
      if (Math.abs(delta) < 1) return;

      tabsScroller.scrollTo({ left: tabsScroller.scrollLeft + delta, behavior: 'smooth' });
    }

    // Snap a clone slide back onto its real counterpart so the loop never runs out of track
    function normalizeLoopPosition() {
      if (currentTrackIndex >= REAL_SLIDE_COUNT + PRE_CLONES) {
        // Wrapped past the end -> snap back to real start
        currentTrackIndex = currentTrackIndex - REAL_SLIDE_COUNT;
        updateCarouselPosition(false);
        // Force layout reflow
        void track.offsetHeight;
      } else if (currentTrackIndex < PRE_CLONES) {
        // Wrapped before the start -> snap to real end
        currentTrackIndex = currentTrackIndex + REAL_SLIDE_COUNT;
        updateCarouselPosition(false);
        // Force layout reflow
        void track.offsetHeight;
      }
      isTransitioning = false;
    }

    // Resolve an in-flight slide immediately instead of dropping the new interaction
    function settleTransition() {
      if (wrapTimer) {
        clearTimeout(wrapTimer);
        wrapTimer = null;
      }
      normalizeLoopPosition();
    }

    function goToTrackSlide(targetTrackIndex: number) {
      settleTransition();

      isTransitioning = true;
      currentTrackIndex = targetTrackIndex;

      // Calculate the active logical index (0 to 5)
      const rawLogical = currentTrackIndex - PRE_CLONES;
      activeLogicalIndex = (rawLogical % REAL_SLIDE_COUNT + REAL_SLIDE_COUNT) % REAL_SLIDE_COUNT;

      updateCarouselPosition(true);

      // Handle seamless wrap-around loop after transition
      wrapTimer = setTimeout(() => {
        wrapTimer = null;
        normalizeLoopPosition();
      }, 520);
    }

    function goToLogicalSlide(logicalIndex: number) {
      activeLogicalIndex = (logicalIndex % REAL_SLIDE_COUNT + REAL_SLIDE_COUNT) % REAL_SLIDE_COUNT;
      goToTrackSlide(activeLogicalIndex + PRE_CLONES);
    }

    // Settle first so `currentTrackIndex` is already normalized when the step is applied
    function goToRelativeSlide(step: number) {
      settleTransition();
      goToTrackSlide(currentTrackIndex + step);
    }

    function startAutoplay() {
      stopAutoplay();
      if (isPlaying) {
        autoplayTimer = setInterval(() => {
          goToRelativeSlide(1);
        }, AUTOPLAY_INTERVAL);
      }
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Clicking peek slides navigates directly to them
    slides.forEach((slide, trackIdx) => {
      slide.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (trackIdx === currentTrackIndex && target.closest('a, button')) return;
        
        if (trackIdx !== currentTrackIndex) {
          goToTrackSlide(trackIdx);
          startAutoplay();
        }
      });

      // Card internal next arrow
      const cardNextBtn = slide.querySelector<HTMLButtonElement>('[data-card-next]');
      cardNextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        goToRelativeSlide(1);
        startAutoplay();
      });
    });

    // Event Listeners for Tabs
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.tabIndex);
        goToLogicalSlide(idx);
        startAutoplay();
      });
    });

    // Event Listeners for Dots
    dotButtons.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.dataset.dotIndex);
        goToLogicalSlide(idx);
        startAutoplay();
      });
    });

    // Pause on Hover over carousel viewport
    viewport?.addEventListener('mouseenter', () => {
      if (isPlaying) stopAutoplay();
    });
    viewport?.addEventListener('mouseleave', () => {
      if (isPlaying) startAutoplay();
    });

    // Touch Swipe Gestures for Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    viewport?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    viewport?.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeDistance = touchStartX - touchEndX;
      const SWIPE_THRESHOLD = 45;
      if (swipeDistance > SWIPE_THRESHOLD) {
        goToRelativeSlide(1);
        startAutoplay();
      } else if (swipeDistance < -SWIPE_THRESHOLD) {
        goToRelativeSlide(-1);
        startAutoplay();
      }
    }

    // Keyboard navigation when section is in view
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      const rect = section.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (!inView) return;

      if (e.key === 'ArrowLeft') {
        goToRelativeSlide(-1);
        startAutoplay();
      } else if (e.key === 'ArrowRight') {
        goToRelativeSlide(1);
        startAutoplay();
      }
    });

    // Window resize handler to keep slide centered
    window.addEventListener('resize', () => {
      updateCarouselPosition(false);
    });

    // Initial setup with immediate and RAF calculations
    updateCarouselPosition(false);
    requestAnimationFrame(() => updateCarouselPosition(false));
    window.addEventListener('load', () => updateCarouselPosition(false));
    setTimeout(() => updateCarouselPosition(false), 80);
    startAutoplay();
  }
</script>
