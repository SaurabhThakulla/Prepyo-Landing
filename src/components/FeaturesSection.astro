      {
        FEATURES.map((_, idx) => (
          <button
            type="button"
            data-dot-index={idx}
            aria-label={`Go to slide ${idx + 1}`}
            class:list={[
              'h-2 rounded-full transition-all duration-300 cursor-pointer',
              idx === 0 ? 'w-8 bg-primary' : 'w-2 bg-muted-foreground/30 hover:bg-muted-foreground/60',
            ]}
          ></button>
        ))
      }
    </div>
  </div>
