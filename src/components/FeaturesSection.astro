---
import { Icon } from 'astro-icon/components';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import { appUrl } from '@/consts';

interface FeatureSlide {
  id: string;
  tabLabel: string;
  tabIcon: string;
  tag: string;
  title: string;
  description: string;
  bullets: string[];
  ctaText: string;
  ctaHref: string;
  themeColor: string;
  themeBg: string;
  themeBorder: string;
  mockupType: 'mock-sim' | 'ai-rubrics' | 'ai-coach' | 'mistake-bank' | 'speaking-analyzer' | 'leaderboards';
  floatingBadges: {
    title: string;
    subtitle: string;
    icon: string;
    iconColor: string;
    iconBg: string;
    position: string;
    animClass: string;
  }[];
}

const FEATURES: FeatureSlide[] = [
  {
    id: 'mock-simulations',
    tabLabel: 'Mock Tests',
    tabIcon: 'lucide:monitor-play',
    tag: 'MOCK TESTS',
    title: 'Full-length PTE & IELTS mocks',
    description:
      'Same timing, same question order, same scoring as the real test. Your score comes back the moment you finish.',
    bullets: ['Real exam timing and question order', 'A score for all four skills', 'See your likely band before test day'],
    ctaText: 'Try a free mock',
    ctaHref: appUrl('/'),
    themeColor: 'text-emerald-500',
    themeBg: 'bg-emerald-500/10',
    themeBorder: 'border-emerald-500/30',
    mockupType: 'mock-sim',
    floatingBadges: [
      {
        title: 'Your score: PTE 82 / Band 8.5',
        subtitle: 'Ready the moment you finish',
        icon: 'lucide:award',
        iconColor: 'text-emerald-500',
        iconBg: 'bg-emerald-500/15',
        position: '-top-3 sm:-top-5 right-2 sm:right-6',
        animClass: 'animate-float',
      },
      {
        title: 'Marked in 3 seconds',
        subtitle: 'All four skills',
        icon: 'lucide:sparkles',
        iconColor: 'text-primary',
        iconBg: 'bg-primary/15',
        position: '-bottom-3 sm:-bottom-5 left-2 sm:left-6',
        animClass: 'animate-float-delay',
      },
    ],
  },
  {
    id: 'ai-rubrics',
    tabLabel: 'Writing Feedback',
    tabIcon: 'lucide:file-edit',
    tag: 'WRITING FEEDBACK',
    title: 'See exactly why you lost marks',
    description:
      'Prepyo reads your writing one sentence at a time, shows what went wrong, and rewrites it the way an examiner wants to read it.',
    bullets: [
      'Grammar and word choice fixed in place',
      'Stronger words suggested as you write',
      'Marked on the official band descriptors',
    ],
    ctaText: 'Check my writing',
    ctaHref: appUrl('/'),
    themeColor: 'text-amber-500',
    themeBg: 'bg-amber-500/10',
    themeBorder: 'border-amber-500/30',
    mockupType: 'ai-rubrics',
    floatingBadges: [
      {
        title: 'Rewritten to Band 8.5',
        subtitle: 'With the words examiners look for',
        icon: 'lucide:sparkles',
        iconColor: 'text-amber-500',
        iconBg: 'bg-amber-500/15',
        position: '-top-3 sm:-top-5 right-2 sm:right-6',
        animClass: 'animate-float',
      },
      {
        title: 'Grammar: 94 / 100',
        subtitle: 'No run-on sentences left',
        icon: 'lucide:check-circle-2',
        iconColor: 'text-emerald-500',
        iconBg: 'bg-emerald-500/15',
        position: '-bottom-3 sm:-bottom-5 left-2 sm:left-6',
        animClass: 'animate-float-delay',
      },
    ],
  },
  {
    id: 'ai-coach',
    tabLabel: 'AI Coach',
    tabIcon: 'lucide:sparkles',
    tag: 'AI TUTOR',
    title: 'A tutor you can ask at 2am',
    description:
      'Stuck on Describe Image or True / False / Not Given? Ask for a template, a tip, or a quick explanation any time.',
    bullets: [
      'Templates and timing for every task type',
      'Practice picked for your weak areas',
      'Fixes for sounds Nepali speakers often miss',
    ],
    ctaText: 'Ask the AI coach',
    ctaHref: appUrl('/'),
    themeColor: 'text-purple-400',
    themeBg: 'bg-purple-500/10',
    themeBorder: 'border-purple-500/30',
    mockupType: 'ai-coach',
    floatingBadges: [
      {
        title: 'Answers in a second',
        subtitle: 'Any hour, any question',
        icon: 'lucide:bot',
        iconColor: 'text-purple-400',
        iconBg: 'bg-purple-500/15',
        position: '-top-3 sm:-top-5 right-2 sm:right-6',
        animClass: 'animate-float',
      },
      {
        title: 'Tips for Nepali speakers',
        subtitle: 'The sounds we usually miss',
        icon: 'lucide:lightbulb',
        iconColor: 'text-amber-500',
        iconBg: 'bg-amber-500/15',
        position: '-bottom-3 sm:-bottom-5 left-2 sm:left-6',
        animClass: 'animate-float-delay',
      },
    ],
  },
  {
    id: 'mistake-bank',
    tabLabel: 'Mistake Bank',
    tabIcon: 'lucide:flame',
    tag: 'MISTAKE BANK',
    title: 'Your mistakes, saved and brought back',
    description:
      'Every wrong answer is saved and sorted, then handed back to you later — until you get it right.',
    bullets: [
      'Sorted by grammar, spelling and vocabulary',
      'Comes back just before you forget it',
      'Daily streaks to keep the habit going',
    ],
    ctaText: 'See the mistake bank',
    ctaHref: appUrl('/'),
    themeColor: 'text-rose-500',
    themeBg: 'bg-rose-500/10',
    themeBorder: 'border-rose-500/30',
    mockupType: 'mistake-bank',
    floatingBadges: [
      {
        title: '14-day streak',
        subtitle: 'Your longest yet',
        icon: 'lucide:flame',
        iconColor: 'text-rose-500',
        iconBg: 'bg-rose-500/15',
        position: '-top-3 sm:-top-5 right-2 sm:right-6',
        animClass: 'animate-float',
      },
      {
        title: '4 weak spots cleared today',
        subtitle: 'Off your review list',
        icon: 'lucide:check',
        iconColor: 'text-emerald-500',
        iconBg: 'bg-emerald-500/15',
        position: '-bottom-3 sm:-bottom-5 left-2 sm:left-6',
        animClass: 'animate-float-delay',
      },
    ],
  },
  {
    id: 'speaking-analyzer',
    tabLabel: 'Speaking',
    tabIcon: 'lucide:mic',
    tag: 'SPEAKING',
    title: 'Hear what the examiner hears',
    description: 'Record yourself and see which words let you down, how fast you spoke, and where you paused.',
    bullets: [
      'A pronunciation score for every word',
      'Speaking speed and pauses measured',
      'Compare yourself to a native recording',
    ],
    ctaText: 'Test my speaking',
    ctaHref: appUrl('/'),
    themeColor: 'text-cyan-500',
    themeBg: 'bg-cyan-500/10',
    themeBorder: 'border-cyan-500/30',
    mockupType: 'speaking-analyzer',
    floatingBadges: [
      {
        title: 'Fluency: 89 / 90',
        subtitle: 'Good pace, no filler words',
        icon: 'lucide:activity',
        iconColor: 'text-cyan-500',
        iconBg: 'bg-cyan-500/15',
        position: '-top-3 sm:-top-5 right-2 sm:right-6',
        animClass: 'animate-float',
      },
      {
        title: 'Pronunciation: 98%',
        subtitle: 'Close to a native speaker',
        icon: 'lucide:volume-2',
        iconColor: 'text-emerald-500',
        iconBg: 'bg-emerald-500/15',
        position: '-bottom-3 sm:-bottom-5 left-2 sm:left-6',
        animClass: 'animate-float-delay',
      },
    ],
  },
  {
    id: 'leaderboards',
    tabLabel: 'Leaderboard',
    tabIcon: 'lucide:trophy',
    tag: 'LEADERBOARD',
    title: 'Practise alongside students across Nepal',
    description: 'Earn XP for real practice, climb your city ranking, and keep the momentum going.',
    bullets: [
      'City rankings for Kathmandu, Pokhara and more',
      'Daily and weekly challenges',
      'Badges for hitting PTE 79+ or Band 8.0',
    ],
    ctaText: 'See the leaderboard',
    ctaHref: appUrl('/'),
    themeColor: 'text-yellow-500',
    themeBg: 'bg-yellow-500/10',
    themeBorder: 'border-yellow-500/30',
    mockupType: 'leaderboards',
    floatingBadges: [
      {
        title: 'Rank #4 in Kathmandu',
        subtitle: '+450 XP today',
        icon: 'lucide:trophy',
        iconColor: 'text-yellow-500',
        iconBg: 'bg-yellow-500/15',
        position: '-top-3 sm:-top-5 right-2 sm:right-6',
        animClass: 'animate-float',
      },
      {
        title: 'PTE 79+ badge unlocked',
        subtitle: 'Target reached',
        icon: 'lucide:shield-check',
        iconColor: 'text-emerald-500',
        iconBg: 'bg-emerald-500/15',
        position: '-bottom-3 sm:-bottom-5 left-2 sm:left-6',
        animClass: 'animate-float-delay',
      },
    ],
  },
];

// Pre-clone last 2 slides and post-clone first 2 slides for infinite loop carousel
const TRACK_SLIDES = [
  ...FEATURES.slice(-2).map((f, i) => ({ ...f, isClone: true, originalIndex: FEATURES.length - 2 + i })),
  ...FEATURES.map((f, i) => ({ ...f, isClone: false, originalIndex: i })),
  ...FEATURES.slice(0, 2).map((f, i) => ({ ...f, isClone: true, originalIndex: i })),
];
const PRE_CLONES = 2;
---

<section id="features" class="py-14 sm:py-20 lg:py-28 border-t border-border relative overflow-hidden" data-features-showcase>
  {/*
    Ambient background glows. Kept in their own clipping layer: as direct children of the
    section they widen its scrollable overflow, which lets a stray scrollIntoView()/focus()
    drag the whole section sideways even though it is overflow-hidden.
  */}
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-primary/5 blur-[140px] rounded-full"></div>
    <div class="absolute bottom-10 right-10 w-[500px] h-[300px] bg-purple-500/5 blur-[120px] rounded-full"></div>
  </div>

  {/* Header */}
  <div class="max-w-4xl mx-auto px-4">
    <SectionHeading
      eyebrow="AI Capabilities"
      eyebrowIcon="lucide:sparkles"
      title="Everything you need to hit your score"
      description="Built for Nepali students applying to Australia, the UK, Canada and the USA."
    />
  </div>

  {/* Category Pills Navigation Bar (Centered Single Line, Smooth Scrolling on Mobile) */}
  <div class="w-full max-w-7xl mx-auto px-4 mb-8 sm:mb-12">
    {/*
      The scroller and the pill row are separate elements on purpose: `w-max mx-auto` centers
      the row when it fits and falls back to left-aligned when it overflows. `justify-center`
      would make the overflowing left edge unreachable and visually clipped.
    */}
    <div class="overflow-x-auto no-scrollbar" data-feature-tabs-scroller>
      <div class="flex items-center gap-1.5 sm:gap-2.5 w-max mx-auto whitespace-nowrap py-1.5 px-1" data-feature-tabs>
      {
        FEATURES.map((feature, idx) => (
          <button
            type="button"
            data-tab-index={idx}
            class:list={[
              'group inline-flex items-center gap-2 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 shrink-0 cursor-pointer select-none border whitespace-nowrap',
              idx === 0
                ? 'bg-foreground text-background border-foreground shadow-md'
                : 'bg-card/90 text-muted-foreground border-border/80 hover:text-foreground hover:bg-card hover:border-border',
            ]}
          >
            <Icon name={feature.tabIcon} class="w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0 transition-transform group-hover:scale-110" />
            <span>{feature.tabLabel}</span>
          </button>
        ))
      }
      </div>
    </div>
  </div>

  {/*
    Infinite Loop Showcase Carousel Container.
    Stays at the section's own width: this section renders inside <main class="lg:max-w-[80vw]">,
    so a 100vw child with `margin-left: calc(50% - 50vw)` overhangs the section's left edge,
    which both clips the peek cards asymmetrically and makes the overflow-hidden section
    horizontally scrollable (dragging the whole section sideways).
  */}
  <div class="relative overflow-hidden py-4 w-full" data-carousel-viewport>
    <div class="relative flex items-stretch w-max gap-6 sm:gap-8 transition-transform duration-500 ease-out will-change-transform" data-carousel-track>
      {
        TRACK_SLIDES.map((feature, trackIdx) => {
          const [badge1, badge2] = feature.floatingBadges;
          const isInitialActive = trackIdx === PRE_CLONES;
          return (
            <div
              class="w-[86vw] sm:w-[78vw] lg:w-[72vw] xl:w-[68vw] 2xl:w-[64vw] max-w-5xl shrink-0 select-none"
              data-track-index={trackIdx}
              data-original-index={feature.originalIndex}
            >
              <div
                class:list={[
                  'h-full rounded-2xl sm:rounded-3xl border border-border/80 bg-gradient-to-br from-card via-card/95 to-card/60 p-4 sm:p-8 lg:p-10 shadow-2xl relative overflow-hidden backdrop-blur-sm flex flex-col justify-between transition-all duration-500 ease-out',
                  isInitialActive ? 'opacity-100 scale-100' : 'opacity-25 scale-[0.96] hover:opacity-60 cursor-pointer',
                ]}
                data-card-inner
              >
                {/* Ambient Card Corner Glow */}
                <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 blur-3xl rounded-full pointer-events-none"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-center my-auto">
                  {/* Left Column: Feature Info & Details (5 cols) */}
                  <div class="lg:col-span-5 space-y-4 sm:space-y-5 text-left">
                    {/* Tag / Category Badge */}
                    <div class="inline-flex items-center gap-2 rounded-full border border-border bg-card/80 px-3 sm:px-3.5 py-1 text-[10px] sm:text-[11px] font-bold tracking-wider uppercase text-foreground shadow-sm">
                      <span class="w-2 h-2 rounded-full bg-primary animate-pulse shrink-0"></span>
                      <span>{feature.tag}</span>
                    </div>

                    {/* Headline */}
                    <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-extrabold text-foreground leading-tight text-balance">
                      {feature.title}
                    </h3>

                    {/* Description */}
                    <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                      {feature.description}
                    </p>

                    {/* Bullet Highlights */}
                    <ul class="space-y-2.5 pt-2">
                      {feature.bullets.map(bullet => (
                        <li class="flex items-start gap-2.5 text-xs sm:text-sm text-foreground font-medium">
                          <div class="w-4 h-4 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0 mt-0.5">
                            <Icon name="lucide:check" class="w-2.5 h-2.5 stroke-[3]" />
                          </div>
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>

                    {/* CTA Button */}
                    <div class="pt-3 flex items-center gap-3">
                      <Button
                        href={feature.ctaHref}
                        size="default"
                        class="rounded-xl font-bold text-xs sm:text-sm px-6 h-11 shadow-md shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5 transition-all gap-2"
                      >
                        <span>{feature.ctaText}</span>
                        <Icon name="lucide:arrow-right" class="w-4 h-4" />
                      </Button>
                    </div>
                  </div>

                  {/* Right Column: High-Fidelity UI Mockup Canvas (7 cols) */}
                  <div class="lg:col-span-7 relative flex justify-center items-center py-4 lg:py-6">
                    <div
                      class={`absolute ${badge1.position} ${badge1.animClass} z-20 hidden sm:flex items-center gap-2.5 rounded-2xl border border-border/80 bg-card/95 backdrop-blur-md px-3 sm:px-4 py-2 sm:py-2.5 text-xs font-bold text-foreground shadow-xl select-none pointer-events-none max-w-[15rem] lg:max-w-none`}
                    >
                      <div class={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 ${badge1.iconBg}`}>
                        <Icon name={badge1.icon} class={`w-4 h-4 ${badge1.iconColor}`} />
                      </div>
                      <div>
                        <div class="text-foreground text-xs font-bold leading-tight">{badge1.title}</div>
                        <div class="text-muted-foreground font-normal leading-tight text-[11px]">{badge1.subtitle}</div>
                      </div>
                    </div>

                    <div
                      class={`absolute ${badge2.position} ${badge2.animClass} z-20 hidden sm:flex items-center gap-2.5 rounded-2xl border border-border/80 bg-card/95 backdrop-blur-md px-3 sm:px-4 py-2 sm:py-2.5 text-xs font-bold text-foreground shadow-xl select-none pointer-events-none max-w-[15rem] lg:max-w-none`}
                    >
                      <div class={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 ${badge2.iconBg}`}>
                        <Icon name={badge2.icon} class={`w-4 h-4 ${badge2.iconColor}`} />
                      </div>
                      <div>
                        <div class="text-foreground text-xs font-bold leading-tight">{badge2.title}</div>
                        <div class="text-muted-foreground font-normal leading-tight text-[11px]">{badge2.subtitle}</div>
                      </div>
                    </div>

                    <div class="w-full rounded-2xl border border-border/80 bg-background/95 shadow-xl overflow-hidden">
                      {/* Browser / App Header */}
                      <div class="flex items-center justify-between gap-2 px-3 sm:px-4 py-2 sm:py-2.5 border-b border-border/60 bg-muted/40 text-xs">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
                        </div>
                        <div class="hidden sm:flex items-center gap-1.5 font-mono text-[11px] text-muted-foreground bg-card/80 px-3 py-0.5 rounded-md border border-border/50 truncate">
                          <Icon name="lucide:lock" class="w-3 h-3 text-emerald-500" />
                          <span>prepyo.online/mock/{feature.id}</span>
                        </div>
                        <div class="flex items-center gap-2 text-muted-foreground text-[11px]">
                          <span class="inline-block w-2 h-2 rounded-full bg-primary animate-ping"></span>
                          <span class="font-semibold text-primary">LIVE AI</span>
                        </div>
                      </div>

                      {/* Mockup Interactive Canvas Content */}
                      <div class="p-3 sm:p-6 space-y-4">
                        {feature.mockupType === 'mock-sim' && (
                          <div class="space-y-4">
                            {/* Exam Header */}
                            <div class="flex items-center justify-between pb-3 border-b border-border/60">
                              <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 rounded-lg bg-primary/10 text-primary text-xs font-bold font-mono">PTE ACADEMIC</span>
                                <span class="text-xs text-muted-foreground">Speaking · Question 4 of 7</span>
                              </div>
                              <div class="flex items-center gap-2 font-mono text-xs font-bold text-rose-500 bg-rose-500/10 px-3 py-1 rounded-lg border border-rose-500/20">
                                <Icon name="lucide:timer" class="w-3.5 h-3.5 animate-pulse" />
                                <span>00:35 / 00:40</span>
                              </div>
                            </div>

                            {/* Question Card */}
                            <div class="p-4 rounded-xl bg-card border border-border/60 space-y-2">
                              <div class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Read aloud</div>
                              <p class="text-xs sm:text-sm text-foreground font-medium leading-relaxed">
                                "The rapid acceleration of renewable solar and hydroelectric power generation in Nepal has attracted substantial foreign direct investment, bolstering the regional power grid and reducing dependence on fossil fuel imports."
                              </p>
                            </div>

                            {/* Audio Visualizer Waveform Bar */}
                            <div class="p-3 rounded-xl bg-muted/40 border border-border/60 space-y-2">
                              <div class="flex items-center justify-between text-[11px] text-muted-foreground">
                                <span class="flex items-center gap-1.5 text-primary font-bold">
                                  <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> Recording...
                                </span>
                                <span class="font-mono">Mic: 98%</span>
                              </div>
                              <div class="flex items-center justify-between gap-1 h-8 px-2 py-1 bg-card rounded-lg border border-border/40 overflow-hidden">
                                {[40, 65, 85, 30, 95, 75, 45, 60, 90, 100, 70, 85, 40, 60, 80, 95, 60, 75, 90, 50, 65, 80, 45, 30, 70, 90, 100, 85, 60, 40, 75, 90, 65, 80, 50, 40].map((h, i) => (
                                  <div
                                    class="w-1 rounded-full bg-primary/80 transition-all duration-300"
                                    style={`height: ${h}%; opacity: ${0.4 + (i % 3) * 0.3}`}
                                  ></div>
                                ))}
                              </div>
                            </div>

                            {/* Sub-Score Pills */}
                            <div class="grid grid-cols-3 gap-2 pt-1">
                              <div class="p-2 rounded-lg bg-card border border-border/60 text-center">
                                <div class="text-[10px] text-muted-foreground font-medium">Content</div>
                                <div class="text-xs sm:text-sm font-bold text-foreground font-mono">90 / 90</div>
                              </div>
                              <div class="p-2 rounded-lg bg-card border border-border/60 text-center">
                                <div class="text-[10px] text-muted-foreground font-medium">Fluency</div>
                                <div class="text-xs sm:text-sm font-bold text-primary font-mono">88 / 90</div>
                              </div>
                              <div class="p-2 rounded-lg bg-card border border-border/60 text-center">
                                <div class="text-[10px] text-muted-foreground font-medium">Pronunciation</div>
                                <div class="text-xs sm:text-sm font-bold text-foreground font-mono">86 / 90</div>
                              </div>
                            </div>
                          </div>
                        )}

                        {feature.mockupType === 'ai-rubrics' && (
                          <div class="space-y-3.5">
                            {/* Rubric Header */}
                            <div class="flex items-center justify-between pb-2.5 border-b border-border/60">
                              <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-500 text-xs font-bold font-mono">IELTS WRITING TASK 2</span>
                              <span class="text-xs font-mono text-emerald-500 font-bold bg-emerald-500/10 px-2.5 py-0.5 rounded-md">Predicted: Band 8.5</span>
                            </div>

                            {/* Sentence Dissection Box */}
                            <div class="p-3.5 rounded-xl bg-card border border-border/60 space-y-2.5 text-xs leading-relaxed">
                              <div class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider">Your sentence</div>
                              <div class="p-2.5 rounded-lg bg-rose-500/5 border border-rose-500/20 text-foreground">
                                <span class="text-rose-500 line-through mr-1 font-semibold">There is many reasons why</span>
                                <span>urbanization creates problems in modern cities today.</span>
                              </div>
                              <div class="p-2.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-foreground space-y-1">
                                <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-bold text-[11px]">
                                  <Icon name="lucide:sparkles" class="w-3.5 h-3.5" />
                                  Suggested rewrite (Band 8.5):
                                </div>
                                <div class="font-medium text-foreground">
                                  "There <span class="text-primary font-bold underline">are numerous compelling reasons</span> why rapid urbanization poses substantial infrastructural dilemmas."
                                </div>
                              </div>
                            </div>

                            {/* Rubric Metric Breakdown Bars */}
                            <div class="space-y-2 pt-1">
