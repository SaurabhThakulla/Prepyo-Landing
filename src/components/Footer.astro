---
import { Icon } from "astro-icon/components";
import { appUrl, asset, BASE_PATH } from "@/consts";

const isHome = Astro.url.pathname === BASE_PATH || Astro.url.pathname === '/';
const sectionHref = (id: string) => (isHome ? `#${id}` : `${BASE_PATH}#${id}`);

const EXPLORE_LINKS = [
  { href: sectionHref('products'), label: 'Exams' },
  { href: sectionHref('features'), label: 'Features' },
  { href: sectionHref('pricing'), label: 'Pricing' },
  { href: sectionHref('how-it-works'), label: 'How it works' },
  { href: asset('/careers/'), label: 'Careers' },
];

const PLATFORM_LINKS = [{ href: sectionHref('faq'), label: 'FAQ' }];

const year = new Date().getFullYear();
---

<footer
  class="w-full border-t border-border bg-card/80 backdrop-blur-md py-10 mt-12 sm:mt-16 transition-colors"
  data-footer
>
  <div
    class="w-full lg:max-w-[80vw] 2xl:max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8"
  >
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {/* Brand info */}
      <div class="col-span-2 md:col-span-1 space-y-3">
        <a href={BASE_PATH} class="flex items-center gap-2">
          <img
            src={asset("/prepyo-logo.webp")}
            alt="Prepyo"
            width="515"
            height="146"
            class="h-9 w-auto object-contain dark:hidden"
          />
          <img
            src={asset("/prepyo-logo-dark.webp")}
            alt=""
            aria-hidden="true"
            width="515"
            height="146"
            class="h-9 w-auto object-contain hidden dark:block"
          />
        </a>
        <p class="text-xs text-muted-foreground leading-relaxed">
          AI-powered PTE, IELTS and Japanese language practice, built for Nepali
          students.
        </p>
        <div
          class="flex items-center gap-1.5 text-[11px] text-muted-foreground pt-1"
        >
          <span>Made with pride for Nepal</span>
          <Icon
            name="lucide:heart"
            class="w-3 h-3 text-nepal-crimson fill-nepal-crimson"
          />
        </div>
      </div>

      {/* Quick landing sections */}
      <div class="space-y-2.5">
        <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">
          Explore
        </h4>
        <ul class="space-y-1.5 text-xs text-muted-foreground">
          {
            EXPLORE_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} class="hover:text-primary transition-colors">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Platform and community */}
      <div class="space-y-2.5">
        <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">
          Platform
        </h4>
        <ul class="space-y-1.5 text-xs text-muted-foreground">
          {
            PLATFORM_LINKS.map(({ href, label }) => (
              <li>
                <a href={href} class="hover:text-primary transition-colors">
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={appUrl("/admin")}
              class="hover:text-primary transition-colors">Admin Console</a
            >
          </li>
        </ul>
      </div>

      {/* Get started and login */}
      <div class="space-y-2.5">
        <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">
          Account
        </h4>
        <ul class="space-y-1.5 text-xs text-muted-foreground">
          <li>
            <a
              href={appUrl("/")}
              class="hover:text-primary transition-colors font-medium">Login</a
            >
          </li>
          <li>
            <a
              href={appUrl("/")}
              class="hover:text-primary transition-colors font-medium text-primary"
            >
              Create free account
            </a>
          </li>
          <li>
            <a
              href={appUrl("/diagnostic")}
              class="hover:text-primary transition-colors">Free test</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="pt-6 border-t border-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-muted-foreground"
    >
      <div>© {year} Prepyo Nepal. All rights reserved.</div>
      <div class="flex items-center gap-3">
        <span>eSewa · Khalti · Fonepay</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { bindSectionLinks } from "@/scripts/scroll-to";

  bindSectionLinks(document.querySelector("[data-footer]")!);
</script>
