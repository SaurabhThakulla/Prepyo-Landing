---
import { Icon } from "astro-icon/components";
import {
  appUrl,
  asset,
  BASE_PATH,
  BILLING_EMAIL,
  CONTACT_EMAIL,
  homeSection,
  KOREAN_LIVE,
  SOCIAL_LINKS,
} from "@/consts";

// Section link helper: smooth jump on homepage, full path everywhere else
const isHome = Astro.url.pathname === BASE_PATH;
const sectionHref = (id: string) => (isHome ? `#${id}` : homeSection(id));

// Products Column
const PRODUCT_LINKS = [
  { href: asset("/pte-academic-preparation/"), label: "PTE Academic Prep" },
  { href: asset("/ielts-academic-preparation/"), label: "IELTS Academic Prep" },
  { href: asset("/ielts-academic-preparation/"), label: "IELTS General Training" },
  ...(KOREAN_LIVE
    ? [
        { href: asset("/eps-topik-preparation/"), label: "EPS-TOPIK Korean" },
        { href: asset("/learn-korean/"), label: "Learn Korean Course" },
      ]
    : []),
  { href: sectionHref("features"), label: "AI Speaking Evaluator" },
  { href: sectionHref("products"), label: "Full-Length Mock Exams" },
  { href: appUrl("/diagnostic"), label: "Free Diagnostic Test" },
];

// Platform Column
const PLATFORM_LINKS = [
  { href: asset("/how-scoring-works/"), label: "How Scoring Works" },
  { href: sectionHref("features"), label: "AI Band Predictor" },
  { href: sectionHref("how-it-works"), label: "Personalized Roadmaps" },
  { href: sectionHref("pricing"), label: "Pricing & Plans" },
  { href: appUrl("/"), label: "Student Dashboard" },
];

// Community & Resources Column
const COMMUNITY_LINKS = [
  { href: asset("/blog/"), label: "Blog & Study Guides" },
  { href: asset("/careers/"), label: "Careers (We're Hiring)" },
  { href: sectionHref("faq"), label: "Frequently Asked Questions" },
];

// Legal Column
const LEGAL_LINKS = [
  { href: appUrl("/terms"), label: "Terms & Conditions" },
  { href: appUrl("/terms-campus"), label: "Terms & Conditions – Campus" },
  { href: appUrl("/privacy"), label: "Privacy Policy" },
  { href: asset("/refund-policy/"), label: "Refund Policy" },
  { href: "#academic-disclaimer", label: "Academic Disclaimer" },
];

const year = new Date().getFullYear();
---

<footer
  class="w-full bg-[#050814] text-slate-300 pt-16 pb-12 mt-16 sm:mt-24 border-t border-slate-800/80 transition-colors selection:bg-primary selection:text-white"
  data-footer
>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* ======================================================== */}
    {/* TOP SECTION: Brand Header & Columns (Reference Image 2) */}
    {/* ======================================================== */}
    <div class="mb-14">
      <!-- Brand Logo + Tagline + Social Icons -->
      <div class="space-y-4 mb-12">
        <a href={BASE_PATH} class="inline-flex items-center gap-1 group">
          <img
            src={asset("/prepyo-logo-dark.webp")}
            alt="Prepyo"
            width="515"
            height="146"
            class="h-8 sm:h-9 w-auto object-contain transition-opacity group-hover:opacity-90"
          />
          <span class="text-xs font-semibold text-slate-400 select-none align-super">®</span>
        </a>

        <p class="text-xs sm:text-[13px] text-slate-400 max-w-xl leading-relaxed">
          Master your PTE, IELTS, and EPS-TOPIK exams with clear paths to high scores, AI-powered diagnostic feedback, realistic mock exams, and proven strategies.
        </p>

        <!-- Social Icons Row (Minimalist monochrome glyphs matching reference) -->
        <div class="flex items-center gap-5 pt-1 text-slate-400">
          <a
            href="https://www.facebook.com/profile.php?id=61594471394788"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Prepyo on Facebook"
            class="hover:text-white transition-colors duration-150"
          >
            <Icon name="lucide:facebook" class="w-[18px] h-[18px]" />
          </a>
          <a
            href="https://www.instagram.com/tryprepyo.online/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Prepyo on Instagram"
            class="hover:text-white transition-colors duration-150"
          >
            <Icon name="lucide:instagram" class="w-[18px] h-[18px]" />
          </a>
        </div>
      </div>

      <!-- 4-Column Navigation Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
        {/* Column 1: Products */}
        <div>
          <h4 class="text-sm font-semibold text-white tracking-tight mb-4">
            Products
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-400">
            {
              PRODUCT_LINKS.map(({ href, label }) => (
                <li>
                  <a href={href} class="hover:text-white transition-colors">
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* Column 2: Platform */}
        <div>
          <h4 class="text-sm font-semibold text-white tracking-tight mb-4">
            Platform
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-400">
            {
              PLATFORM_LINKS.map(({ href, label }) => (
                <li>
                  <a href={href} class="hover:text-white transition-colors">
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* Column 3: Community */}
        <div>
          <h4 class="text-sm font-semibold text-white tracking-tight mb-4">
            Community
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-400">
            {
              COMMUNITY_LINKS.map(({ href, label, external }) => (
                <li>
                  <a
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    class="hover:text-white transition-colors"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* Column 4: Legal */}
        <div>
          <h4 class="text-sm font-semibold text-white tracking-tight mb-4">
            Legal
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-400">
            {
              LEGAL_LINKS.map(({ href, label }) => (
                <li>
                  <a href={href} class="hover:text-white transition-colors">
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    {/* ========================================================================= */}
    {/* MIDDLE SECTION: Important Information & Disclaimer (Reference Image 1)  */}
    {/* ========================================================================= */}
    <div id="academic-disclaimer" class="pt-8 pb-10 border-t border-slate-800/80 space-y-6 text-xs text-slate-400 leading-relaxed font-normal">
      <h3 class="text-sm font-bold text-slate-200 tracking-tight">
        Important Information & Disclaimer
      </h3>

      <!-- 1. Simulated Exam & Assessment Environment -->
      <div class="space-y-1.5">
        <h4 class="font-semibold text-slate-300">
          Simulated Exam & Diagnostic Environment
        </h4>
        <p>
          All mock tests, scoring metrics, and diagnostic evaluations provided by Prepyo operate exclusively in an AI-assisted simulated practice environment. No actual test certificates, formal institutional test reports, or official credentials are issued by Prepyo. The services and analytical reports we offer are designed solely for educational, diagnostic preparation, and self-evaluation purposes.
        </p>
      </div>

      <!-- 2. Independent Educational Platform & Non-Affiliation -->
      <div class="space-y-1.5">
        <h4 class="font-semibold text-slate-300">
          Independent Educational Platform & Non-Affiliation
        </h4>
        <p>
          The test preparation services and AI mock scoring tools are independently provided and distributed by Prepyo EduTech. All content published and distributed on this platform is for general informational and educational practice purposes only.
        </p>
        <ul class="list-disc list-inside space-y-1 pl-1 text-slate-400/90">
          <li>Prepyo is not affiliated with, endorsed by, or accredited by Pearson PLC (owner of PTE Academic™), ETS, University of Cambridge, IDP Education, the British Council (owners and administrators of IELTS™), or HRD Korea (administrator of EPS-TOPIK).</li>
          <li>Prepyo does not administer official examinations, register official test candidates, or act as an authorized testing center.</li>
          <li>All test names, acronyms, and registered trademarks belong strictly to their respective owners and are referenced on this platform solely for identification and educational context.</li>
        </ul>
        <p class="pt-1">
          Participation in any of our preparation programs is entirely voluntary, and all fees paid to Prepyo are strictly service fees for platform access, server compute, and AI diagnostic feedback. Program fees are not examination deposits, do not represent official test fees, and cannot be redeemed for official exam vouchers under any circumstances. These fees are non-refundable once access is provided, except where explicitly required by applicable consumer law or our formal Refund Policy.
        </p>
        <p>
          Instead, all subscription fees are applied toward operational and technical expenses, including staffing, server infrastructure, cloud hosting, AI model maintenance, proprietary question bank development, and ongoing customer support. Payment of fees does not create any fiduciary duty, custodial relationship, guarantee of admission, or employment arrangement between learners and Prepyo.
        </p>
      </div>

      <!-- 3. Academic Scoring & Performance Notice -->
      <div class="space-y-1.5">
        <h4 class="font-semibold text-slate-300">
          Academic Scoring & Performance Notice
        </h4>
        <p>
          Standardized high-stakes language proficiency tests involve individual exam-day variables, human test conditions, time pressure, and official exam board adjudication. Even in a simulated AI environment, strategies tested under practice conditions may produce results that vary under real-world examination settings. Learners should carefully evaluate their study timeline, target institution score requirements, and personal test-taking readiness before scheduling official tests.
        </p>
      </div>

      <!-- 4. Corporate & Operating Information -->
      <div class="space-y-1.5">
        <h4 class="font-semibold text-slate-300">
          Corporate & Operating Information
        </h4>
        <p>
          Prepyo is a product of Tech Sagarmatha. Inquiries and official correspondence may be directed to <a href={`mailto:${CONTACT_EMAIL}`} class="text-slate-300 underline underline-offset-2 hover:text-white">{CONTACT_EMAIL}</a> or our billing team at <a href={`mailto:${BILLING_EMAIL}`} class="text-slate-300 underline underline-offset-2 hover:text-white">{BILLING_EMAIL}</a>.
        </p>
        <p class="text-slate-400">
          Registered Address: Ward No. 1, Tikapur Municipality, Kailali, Sudurpashchim Province, 10901, Nepal.
        </p>
        <p class="text-[11px] text-slate-500">
          Technical infrastructure and cloud edge delivery provided across secure, distributed international regions.
        </p>
      </div>
    </div>

    {/* ============================================================== */}
    {/* PAYMENT GATEWAYS ROW (Reference Image 1: Centered Logo Badges) */}
    {/* ============================================================== */}
    <div class="pt-8 pb-8 border-t border-slate-800/80">
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-9 text-slate-400 opacity-70 hover:opacity-100 transition-opacity duration-300">
        <!-- eSewa Badge -->
        <div class="flex items-center gap-1.5 font-bold tracking-tight text-xs text-slate-300 select-none">
          <span class="w-4 h-4 rounded-full bg-[#60BB46] text-white flex items-center justify-center text-[10px] font-black leading-none">e</span>
          <span class="font-semibold tracking-tighter">eSewa</span>
        </div>

        <!-- Khalti Badge -->
        <div class="flex items-center gap-1.5 font-bold tracking-tight text-xs text-slate-300 select-none">
          <span class="w-4 h-4 rounded bg-[#5C2D91] text-white flex items-center justify-center text-[9px] font-black leading-none">K</span>
          <span class="font-semibold tracking-tight">Khalti</span>
        </div>

        <!-- Fonepay Badge -->
        <div class="flex items-center gap-1 font-bold tracking-tight text-xs text-slate-300 select-none">
          <span class="w-4 h-4 rounded bg-[#ED1C24] text-white flex items-center justify-center text-[10px] font-black italic leading-none">f</span>
          <span class="font-semibold tracking-tight">fonepay</span>
        </div>

        <!-- All Banks / ConnectIPS -->
        <div class="flex items-center gap-1.5 font-semibold text-xs text-slate-300 select-none">
          <Icon name="lucide:landmark" class="w-4 h-4 text-slate-300" />
          <span>All Banks</span>
        </div>
      </div>
    </div>

    {/* ============================================================== */}
    {/* BOTTOM BAR: Copyright & Language Selector (Reference Image 1)  */}
    {/* ============================================================== */}
    <div class="pt-6 border-t border-slate-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <!-- Left: Copyright -->
      <div class="space-y-1 text-center md:text-left">
        <div>© {year} Prepyo. All rights reserved.</div>
      </div>

      <!-- Right: Language Selector + Legal Links -->
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-6 gap-y-3 text-slate-400">
        <!-- Language Selector Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors cursor-pointer py-1 select-none"
            aria-label="Select Language"
          >
            <Icon name="lucide:globe" class="w-3.5 h-3.5 text-slate-400" />
            <span class="text-xs">English (English)</span>
            <Icon name="lucide:chevron-down" class="w-3 h-3 text-slate-400 group-hover:rotate-180 transition-transform duration-200" />
          </button>
          <div class="absolute right-0 bottom-full mb-2 hidden group-hover:block hover:block bg-slate-900 border border-slate-800 rounded-lg shadow-xl p-1.5 w-44 z-50 text-xs">
            <div class="px-2.5 py-1 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Language</div>
            <button class="w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-800 text-white font-medium flex items-center justify-between">
              <span>English (English)</span>
              <span class="text-emerald-400 text-xs font-bold">✓</span>
            </button>
            <button class="w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-800 text-slate-400 hover:text-white transition-colors">
              <span>Nepali (नेपाली)</span>
            </button>
          </div>
        </div>

        <a href={appUrl("/terms")} class="hover:text-white transition-colors">
          Terms & Conditions
        </a>
        <a href={appUrl("/terms-campus")} class="hover:text-white transition-colors">
          Terms & Conditions – Campus
        </a>
        <a href={appUrl("/privacy")} class="hover:text-white transition-colors">
          Privacy Policy
        </a>
        <a href={asset("/refund-policy/")} class="hover:text-white transition-colors">
          Refund Policy
        </a>
        <button
          type="button"
          class="hover:text-white transition-colors cursor-pointer"
          data-cookie-trigger
        >
          Cookie preferences
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  import { bindSectionLinks } from "@/scripts/scroll-to";

  const footerEl = document.querySelector("[data-footer]");
  if (footerEl) {
    bindSectionLinks(footerEl);
  }

  // Quick feedback on Cookie preferences click
  const cookieTrigger = document.querySelector("[data-cookie-trigger]");
  cookieTrigger?.addEventListener("click", () => {
    alert("Cookie Preferences:\nAll strictly necessary cookies are enabled to safeguard user authentication and session security.");
  });
</script>
