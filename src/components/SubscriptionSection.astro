---
import { Icon } from "astro-icon/components";
import { appUrl, asset } from "@/consts";
import { EXACT_PLANS, FEATURES } from "@/data/pricing";

---

<section
  id="pricing"
  class="py-16 sm:py-24 border-t border-border bg-background text-foreground relative overflow-hidden transition-colors"
>
  <div id="subscription" class="sr-only" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center space-y-2 mb-12 sm:mb-16">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-foreground tracking-tight">
        Pricing Plans 
      </h2>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        Transparent pricing with all features compared. Select the plan that
        fits your target exam date.
      </p>
      <div class="flex flex-col items-center gap-2 pt-4">
        <span class="text-xs text-muted-foreground font-medium">Payments powered by</span>
        <div class="flex items-center justify-center gap-8 sm:gap-10 flex-wrap">
          <img src={asset("/images/esewa-logo.png")} alt="Pay with eSewa" width="180" height="59" loading="lazy" class="h-7 sm:h-8 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" />
          <img src={asset("/images/khalti-logo.svg")} alt="Pay with Khalti" width="412" height="206" loading="lazy" class="h-7 sm:h-8 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" />
          <img src={asset("/images/bank-logo.svg")} alt="Pay by transfer from any major Nepali bank" width="300" height="100" loading="lazy" class="h-9 sm:h-10 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity dark:brightness-125" />
        </div>
      </div>
    </div>

    <div class="overflow-x-auto pb-6 -mx-4 px-4 sm:mx-0 sm:px-0">
      <div class="min-w-[760px] grid grid-cols-5 items-stretch">
        {/* Column 1: Feature Labels */}
        <div class="flex flex-col pr-4">
          <div
            class="h-40 flex items-end pb-5 font-bold uppercase text-xs text-muted-foreground"
          >
            Plan Comparison
          </div>
          {
            FEATURES.map((f) => (
              <div class="h-14 flex items-center border-b border-border/70 text-xs sm:text-sm font-medium text-foreground/90">
                <span class="inline-flex items-center gap-1.5 flex-wrap">
                  <span>{f.label}</span>
                  {f.badge && (
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400 border border-emerald-500/20">
                      {f.badge}
                    </span>
                  )}
                </span>
              </div>
            ))
          }
        </div>

        {/* Columns 2-5: Dynamic Plan Columns */}
        {
          EXACT_PLANS.map((plan, planIdx) => {
            const isPop = plan.popular;
            const href = appUrl(plan.id === "free" ? "/" : "/subscription");

            return (
              <div
                class:list={[
                  "flex flex-col text-center transition-all px-2 sm:px-3 text-foreground",
                  isPop && "relative bg-primary/[0.03] dark:bg-white/[0.03] rounded-2xl border border-primary/20 dark:border-primary/30",
                ]}
              >
                {/* Header */}
                <div class="h-40 flex flex-col items-center justify-end pb-5 space-y-1">
                  {isPop && (
                    <span class="rounded-full bg-primary px-3 py-0.5 text-[10px] font-bold text-white shadow-sm mb-1 uppercase tracking-wider">
                      Most popular
                    </span>
                  )}
                  <span class:list={[
                    "text-sm sm:text-base font-bold",
                    isPop ? "text-foreground" : "text-primary"
                  ]}>
                    {plan.name}
                  </span>
                  <span class:list={[
                    "text-[10px] uppercase tracking-wider font-semibold",
                    isPop ? "text-primary font-bold" : "text-muted-foreground"
                  ]}>
                    {plan.gloss}
                  </span>
                  <div class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-foreground">
                    NPR {plan.priceNPR.toLocaleString()}
                  </div>
                  <span class="text-xs text-muted-foreground">
                    {plan.subtitle}
                  </span>
                </div>

                {/* Rows */}
                {FEATURES.map((f) => {
                  const val = f.values[planIdx];
                  return (
                    <div class="h-14 flex items-center justify-center text-xs sm:text-sm font-medium border-b border-border/70 text-foreground/85">
                      {typeof val === "boolean" ? (
                        val ? (
                          <Icon
                            name="lucide:check"
                            class="w-4 h-4 text-emerald-500"
                          />
                        ) : (
                          <span class="text-muted-foreground/40 font-semibold">
                            —
                          </span>
                        )
                      ) : (
                        <span>{val}</span>
                      )}
                    </div>
                  );
                })}

                {/* Footer CTA */}
                <div class="h-24 flex items-center justify-center pt-2">
                  <a
                    href={href}
                    class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:text-primary/80 transition-colors group"
                  >
                    <span>{plan.cta}</span>
                    <Icon
                      name="lucide:arrow-right"
                      class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                    />
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <p class="mt-8 text-center text-xs text-muted-foreground max-w-2xl mx-auto">
      One sub-test is one practice task set — a True/False set, a Fill in the
      Blanks task, an essay, or a speaking response — however many questions it
      contains. Mock exams have their own allowance and never use your daily
      sub-tests.
    </p>
  </div>
</section>
