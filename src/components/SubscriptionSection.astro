---
import { Icon } from "astro-icon/components";
import { appUrl, asset } from "@/consts";
import { EXACT_PLANS, FEATURES } from "@/data/pricing";

---

<section
  id="pricing"
  class="py-16 sm:py-24 border-t border-border relative overflow-hidden"
>
  <div id="subscription" class="sr-only" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center space-y-2 mb-12 sm:mb-16">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-foreground tracking-tight">
        Pricing Plans 
      </h2>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        Transparent pricing with all features compared. Select the plan that
        fits your target exam date.
      </p>
      <div class="flex flex-col items-center gap-2 pt-4">
        <span class="text-xs text-muted-foreground font-medium">Payments powered by</span>
        <div class="flex items-center gap-6 flex-wrap justify-center">
          <img src={asset("/images/esewa-logo.png")} alt="Pay with eSewa" width="180" height="59" loading="lazy" class="h-8 object-contain opacity-85 hover:opacity-100 transition-opacity" />
          <img src={asset("/images/khalti-logo.svg")} alt="Pay with Khalti" width="412" height="206" loading="lazy" class="h-8 object-contain opacity-85 hover:opacity-100 transition-opacity" />
          <img src={asset("/images/bank-logo.svg")} alt="Pay by transfer from any major Nepali bank" width="300" height="100" loading="lazy" class="h-10 object-contain opacity-85 hover:opacity-100 transition-opacity" />
        </div>
      </div>
    </div>

    <div class="overflow-x-auto pb-6 -mx-4 px-4 sm:mx-0 sm:px-0">
      <div class="min-w-[760px] grid grid-cols-5 items-stretch">
        {/* Column 1: Feature Labels */}
        <div class="flex flex-col pr-4">
          <div
            class="h-40 flex items-end pb-5 font-bold uppercase text-xs text-muted-foreground"
          >
            Plan Comparison
          </div>
          {
            FEATURES.map((f) => (
              <div class="h-14 flex items-center border-b border-border/70 text-xs sm:text-sm font-medium text-foreground/90">
                {f.label}
              </div>
            ))
          }
        </div>

        {/* Columns 2-5: Dynamic Plan Columns */}
        {
          EXACT_PLANS.map((plan, planIdx) => {
            const isPop = plan.popular;
            const href = appUrl(plan.id === "free" ? "/" : "/subscription");

            return (
              <div
                class:list={[
                  "flex flex-col text-center transition-all",
                  isPop
                    ? "relative z-20 bg-[#0B132B] dark:bg-[#070D1E] text-white rounded-2xl lg:rounded-3xl p-4 sm:p-5 shadow-2xl border border-slate-700/60 -my-4 sm:-my-6"
                    : "px-2 sm:px-3 text-foreground",
                ]}
              >
                {/* Header */}
                <div class="h-40 flex flex-col items-center justify-end pb-5 space-y-1">
                  {isPop && (
                    <span class="rounded-full bg-primary px-3.5 py-0.5 text-[11px] font-bold text-primary-foreground shadow-sm mb-1">
                      Most popular
                    </span>
                  )}
                  <span
                    class:list={[
                      "text-sm sm:text-base font-bold",
                      isPop ? "text-white" : "text-primary",
                    ]}
                  >
                    {plan.name}
                  </span>
                  <span
                    class:list={[
                      "text-[10px] uppercase tracking-wider font-semibold",
                      isPop ? "text-slate-400" : "text-muted-foreground",
                    ]}
                  >
                    {plan.gloss}
                  </span>
                  {plan.originalPriceNPR && (
                    <span
                      class:list={[
                        "text-lg sm:text-xl font-semibold line-through decoration-red-500 decoration-[1.5px]",
                        isPop ? "text-black-400" : "text-muted-foreground/70",
                      ]}
                    >
                      NPR {plan.originalPriceNPR.toLocaleString()}
                    </span>
                  )}
                  <div
                    class:list={[
                      "text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight",
                      isPop ? "text-white" : "text-foreground",
                    ]}
                  >
                    NPR {plan.priceNPR.toLocaleString()}
                  </div>
                  <span
                    class:list={[
                      "text-xs",
                      isPop ? "text-slate-400" : "text-muted-foreground",
                    ]}
                  >
                    {plan.subtitle}
                  </span>
                </div>

                {/* Rows */}
                {FEATURES.map((f) => {
                  const val = f.values[planIdx];
                  return (
                    <div
                      class:list={[
                        "h-14 flex items-center justify-center text-xs sm:text-sm font-medium border-b",
                        isPop
                          ? "border-slate-800 text-slate-100"
                          : "border-border/70 text-foreground/80",
                      ]}
                    >
                      {typeof val === "boolean" ? (
                        val ? (
                          <Icon
                            name="lucide:check"
                            class:list={[
                              "w-4 h-4",
                              isPop ? "text-white" : "text-foreground/80",
                            ]}
                          />
                        ) : (
                          <span
                            class={
                              isPop
                                ? "text-slate-600"
                                : "text-muted-foreground/60"
                            }
                          >
                            —
                          </span>
                        )
                      ) : (
                        <span>{val}</span>
                      )}
                    </div>
                  );
                })}

                {/* Footer CTA */}
                <div class="h-24 flex items-center justify-center pt-2">
                  {isPop ? (
                    <a
                      href={href}
                      class="w-full py-3 px-4 rounded-xl bg-nepal-gold hover:brightness-110 active:scale-[0.98] text-slate-950 font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 shadow-lg shadow-amber-500/25 transition-all"
                    >
                      <span>{plan.cta}</span>
                      <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                    </a>
                  ) : (
                    <a
                      href={href}
                      class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:brightness-110 transition-colors group"
                    >
                      <span>{plan.cta}</span>
                      <Icon
                        name="lucide:arrow-right"
                        class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                      />
                    </a>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-muted-foreground max-w-2xl mx-auto">
      One sub-test is one practice task set — a True/False set, a Fill in the
      Blanks task, an essay, or a speaking response — however many questions it
      contains. Mock exams have their own allowance and never use your daily
      sub-tests.
    </p>
  </div>
</section>
