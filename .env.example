# =============================================================================
# Prepyo landing site configuration
# =============================================================================
# This site is static marketing pages only — it stores nothing and authenticates
# nobody. Both values below are baked into the built HTML/JS, so neither one
# should ever be a secret.

# Where the Next.js app lives. Every "Sign up", "Login", "Dashboard" and
# "Free diagnostic" link on this site points into it.
# Defaults to http://localhost:3000 when unset.
PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Go API, used for the one public request this site makes:
# GET /subscriptions/plans, which fills in the pricing section.
#
# It is a cross-origin request, so this site's origin must be listed in the
# backend's ALLOWED_ORIGINS (add http://localhost:4321 for local dev).
# Defaults to http://localhost:8080/api/v1 when unset.
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
