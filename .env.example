# =============================================================================
# Prepyo landing site configuration
# =============================================================================
# This site is static marketing pages only — it stores nothing and authenticates
# nobody. Every value below is baked into the built HTML/JS, so none of them
# should ever be a secret.
#
# The defaults in src/consts.ts already point at production, so a deploy needs
# no configuration. Copy this file to .env only when you want to develop
# against a local app and API instead.

# Where the Next.js app lives. Every "Sign up", "Login", "Dashboard" and
# "Free diagnostic" link on this site points into it, and its "/" is the
# sign-in screen.
# Defaults to https://dashboard.prepyo.online when unset.
PUBLIC_APP_URL=http://localhost:3000

# Base URL of the API, used for the one public request this site makes:
# GET /subscriptions/plans, which fills in the pricing section.
#
# It is a cross-origin request, so this site's origin must be listed in the Go
# backend's ALLOWED_ORIGINS (add http://localhost:4321 for local dev).
# Defaults to https://dashboard.prepyo.online/api/v1 when unset.
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Sub-path the site is served from. Only GitHub Pages needs this changed; the
# deploy workflow sets it to /Prepyo-Online.
# Defaults to / when unset.
# PUBLIC_BASE_PATH=/

# Origin used for canonical and Open Graph URLs. Vercel supplies its own at
# build time, so this is only needed for a custom domain.
# PUBLIC_SITE_URL=https://prepyo.online
